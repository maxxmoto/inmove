      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap');\n    \n    body {\n        font-family: 'Inter', sans-serif;\n        background-color: #FFFFFF;\n        color: #0F172A;\n        overflow-x: clip;\n    }\n\n    h1, h2, h3, h4, .font-heading {\n        font-family: 'Outfit', sans-serif;\n    }\n\n    .glass {\n        background: rgba(255, 255, 255, 0.55);\n        backdrop-filter: blur(12px);\n        -webkit-backdrop-filter: blur(12px);\n        border: 1px solid rgba(0, 0, 0, 0.08);\n    }\n\n    .diagonal-split-bg {\n        clip-path: polygon(100% 0, 100% 100%, 0 100%);\n    }\n\n    @keyframes float-slow {\n        0%, 100% { transform: translate(0, 0) rotate(0deg); }\n        33% { transform: translate(15px, -15px) rotate(2deg); }\n        66% { transform: translate(-10px, 10px) rotate(-1deg); }\n    }\n\n    .animate-float-slow {\n        animation: float-slow 12s ease-in-out infinite;\n    }\n\n    /* Technical grid background */\n    .tech-grid {\n        background-size: 40px 40px;\n        background-image: radial-gradient(circle, #0066FF10 1px, transparent 1px);\n    }\n\n    /* Lenis required styles */\n    html.lenis {\n        height: auto;\n    }\n    .lenis.lenis-smooth {\n        scroll-behavior: auto !important;\n    }\n    .lenis.lenis-smooth [data-lenis-prevent] {\n        overscroll-behavior: contain;\n    }\n    .lenis.lenis-stopped {\n        overflow: hidden;\n    }\n    .lenis.lenis-scrolling iframe {\n        pointer-events: none;\n    }\n\n    /* Custom scrollbar for better feel */\n    ::-webkit-scrollbar {\n        width: 8px;\n    }\n    ::-webkit-scrollbar-track {\n        background: #F4F7FA;\n    }\n    ::-webkit-scrollbar-thumb {\n        background: #0066FF30;\n        border-radius: 10px;\n    }\n    ::-webkit-scrollbar-thumb:hover {\n        background: #0066FF50;\n    }\n</style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"2\">\n\n<header class=\"fixed top-0 left-0 w-full z-50 glass border-b border-black/[0.05]\" data-kid=\"3\">\n    <div class=\"container mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"4\">\n        <div class=\"flex items-center gap-2\" data-kid=\"5\">\n            <div class=\"w-10 h-10 bg-[#0066FF] rounded-lg flex items-center justify-center text-white shadow-lg shadow-[#0066FF]/20\" data-kid=\"6\">\n                <i class=\"ti ti-chart-dots text-2xl\" data-kid=\"7\"></i>\n            </div>\n            <span class=\"text-xl font-bold tracking-tight font-heading\" data-kid=\"8\">DIET <span class=\"text-[#0066FF] font-light uppercase tracking-[0.2em] text-xs ml-1\" data-kid=\"9\">Protocol</span></span>\n        </div>\n        <nav class=\"hidden lg:flex items-center gap-10\" data-kid=\"10\">\n            <a href=\"#\" class=\"text-sm font-semibold uppercase tracking-widest hover:text-[#0066FF] transition-colors\" data-kid=\"11\">Эндоскопия</a>\n            <a href=\"#\" class=\"text-sm font-semibold uppercase tracking-widest hover:text-[#0066FF] transition-colors\" data-kid=\"12\">Онлайн-прием</a>\n            <a href=\"#\" class=\"text-sm font-semibold uppercase tracking-widest text-[#0066FF]\" data-kid=\"13\">Питание</a>\n            <a href=\"#\" class=\"text-sm font-semibold uppercase tracking-widest hover:text-[#0066FF] transition-colors\" data-kid=\"14\">О докторе</a>\n        </nav>\n        <div class=\"flex items-center gap-4\" data-kid=\"15\">\n            <button class=\"px-6 py-2.5 bg-black text-white text-xs font-bold uppercase tracking-widest rounded hover:bg-zinc-800 transition-all\" data-kid=\"16\">\n                Личный кабинет\n            </button>\n        </div>\n    </div>\n</header>\n\n<main class=\"tech-grid\" data-kid=\"17\">\n    \n    <section class=\"relative min-h-[90vh] flex items-center pt-24 pb-12 overflow-hidden bg-white\" data-kid=\"18\">\n        <div class=\"absolute right-0 top-0 w-1/2 h-full bg-[#F4F7FA] [clip-path:polygon(20%_0,100%_0,100%_100%,0%_100%)] z-0\" data-kid=\"19\"></div>\n        \n        <div class=\"container mx-auto px-6 relative z-10\" data-kid=\"20\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\" data-kid=\"21\">\n                <div class=\"lg:col-span-7\" data-kid=\"22\">\n                    <div class=\"hero-reveal space-y-6\" data-kid=\"23\">\n                        <div class=\"inline-flex items-center gap-4 text-[#0066FF]\" data-kid=\"24\">\n                            <span class=\"h-px w-12 bg-[#0066FF]\" data-kid=\"25\"></span>\n                            <span class=\"text-xs font-black uppercase tracking-[0.3em]\" data-kid=\"26\">Advanced Medical Nutrition</span>\n                        </div>\n                        <h1 class=\"text-7xl lg:text-8xl font-black leading-[0.95] tracking-tight text-[#0F172A]\" data-kid=\"27\">\n                            NUTRITION<br data-kid=\"28\">\n                            <span class=\"text-[#0066FF]\" data-kid=\"29\">&</span> DIETETICS\n                        </h1>\n                        <p class=\"text-lg text-[#0F172A]/70 max-w-lg leading-relaxed font-medium\" data-kid=\"30\">\n                            Научный подход к управлению здоровьем через персонализированные протоколы питания. Эффективность, подтвержденная лабораторными данными.\n                        </p>\n                        <div class=\"flex flex-wrap items-center gap-4 pt-6\" data-kid=\"31\">\n                            <button class=\"group px-8 py-4 bg-[#0066FF] text-white font-bold uppercase tracking-widest text-xs flex items-center gap-3 hover:bg-[#0052cc] transition-all\" data-kid=\"32\">\n                                Начать протокол\n                                <i class=\"ti ti-arrow-right group-hover:translate-x-1 transition-transform\" data-kid=\"33\"></i>\n                            </button>\n                            <button class=\"px-8 py-4 border border-[#0F172A]/10 font-bold uppercase tracking-widest text-xs hover:bg-black hover:text-white transition-all\" data-kid=\"34\">\n                                Узнать больше\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                \n                <div class=\"lg:col-span-5 relative\" data-kid=\"35\">\n                    <div class=\"hero-image-wrap relative\" data-kid=\"36\">\n                        <div class=\"absolute -inset-4 border border-[#0066FF]/20 z-0\" data-kid=\"37\"></div>\n                        <div class=\"absolute -inset-8 border border-[#0066FF]/10 z-0\" data-kid=\"38\"></div>\n                        <img src=\"https://images.unsplash.com/photo-1539735776517-befcae86494d?auto=format&w=1200&q=80&fit=crop\" alt=\"Nutrition Analysis\" class=\"w-full aspect-[4/5] object-cover relative z-10 shadow-2xl grayscale hover:grayscale-0 transition-all duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"39\">\n                        \n                        <div class=\"absolute top-1/2 -right-12 translate-y-[-50%] z-20 hidden xl:block\" data-kid=\"40\">\n                            <div class=\"p-8 glass shadow-2xl space-y-4 max-w-[240px]\" data-kid=\"41\">\n                                <div class=\"text-[10px] font-black uppercase tracking-widest text-[#0066FF]\" data-kid=\"42\">System Status</div>\n                                <div class=\"space-y-2\" data-kid=\"43\">\n                                    <div class=\"h-1 bg-[#0066FF] w-full\" data-kid=\"44\"></div>\n                                    <div class=\"h-1 bg-[#0F172A]/10 w-2/3\" data-kid=\"45\"></div>\n                                    <div class=\"h-1 bg-[#0F172A]/10 w-1/2\" data-kid=\"46\"></div>\n                                </div>\n                                <div class=\"text-xs font-medium text-[#0F172A]/60\" data-kid=\"47\">Биометрические данные синхронизированы</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-32 bg-[#F4F7FA]\" data-kid=\"48\">\n        <div class=\"container mx-auto px-6\" data-kid=\"49\">\n            <div class=\"mb-16\" data-kid=\"50\">\n                <h2 class=\"text-4xl lg:text-5xl font-black text-[#0F172A] mb-4\" data-kid=\"51\">ПЛАНЫ ПИТАНИЯ</h2>\n                <div class=\"h-1 w-24 bg-[#0066FF]\" data-kid=\"52\"></div>\n            </div>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch\" data-kid=\"53\">\n                \n                <div class=\"md:col-span-8 bg-white p-12 relative overflow-hidden group border border-black/[0.05] plan-card hover:shadow-xl hover:transition-shadow\" data-kid=\"54\">\n                    <div class=\"absolute top-0 right-0 w-64 h-64 bg-[#0066FF]/5 rounded-bl-full transition-transform group-hover:scale-110 duration-700\" data-kid=\"55\"></div>\n                    <div class=\"relative z-10 h-full flex flex-col\" data-kid=\"56\">\n                        <div class=\"flex justify-between items-start mb-12\" data-kid=\"57\">\n                            <div data-kid=\"58\">\n                                <span class=\"text-[10px] font-black uppercase tracking-[0.2em] text-[#0066FF] block mb-4\" data-kid=\"59\">Professional Tier</span>\n                                <h3 class=\"text-4xl font-bold mb-4\" data-kid=\"60\">КУРС 30 ДНЕЙ</h3>\n                                <div class=\"text-5xl font-black text-[#0F172A]\" data-kid=\"61\">4 000 ₽</div>\n                            </div>\n                            <div class=\"text-right\" data-kid=\"62\">\n                                <i class=\"ti ti-activity-heartbeat text-5xl text-[#0F172A]/10\" data-kid=\"63\"></i>\n                            </div>\n                        </div>\n                        \n                        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-8 mb-12\" data-kid=\"64\">\n                            <ul class=\"space-y-4\" data-kid=\"65\">\n                                <li class=\"flex items-start gap-3\" data-kid=\"66\">\n                                    <i class=\"ti ti-check text-[#0066FF] mt-1\" data-kid=\"67\"></i>\n                                    <span class=\"text-sm font-medium\" data-kid=\"68\">Глубокий анализ дефицитов</span>\n                                </li>\n                                <li class=\"flex items-start gap-3\" data-kid=\"69\">\n                                    <i class=\"ti ti-check text-[#0066FF] mt-1\" data-kid=\"70\"></i>\n                                    <span class=\"text-sm font-medium\" data-kid=\"71\">Еженедельная коррекция рациона</span>\n                                </li>\n                            </ul>\n                            <ul class=\"space-y-4\" data-kid=\"72\">\n                                <li class=\"flex items-start gap-3\" data-kid=\"73\">\n                                    <i class=\"ti ti-check text-[#0066FF] mt-1\" data-kid=\"74\"></i>\n                                    <span class=\"text-sm font-medium\" data-kid=\"75\">Прямой чат с врачом</span>\n                                </li>\n                                <li class=\"flex items-start gap-3\" data-kid=\"76\">\n                                    <i class=\"ti ti-check text-[#0066FF] mt-1\" data-kid=\"77\"></i>\n                                    <span class=\"text-sm font-medium\" data-kid=\"78\">Интегративная поддержка</span>\n                                </li>\n                            </ul>\n                        </div>\n                        \n                        <div class=\"mt-auto\" data-kid=\"79\">\n                            <button class=\"px-8 py-4 bg-black text-white text-xs font-bold uppercase tracking-widest hover:bg-[#0066FF] transition-all\" data-kid=\"80\">\n                                Оформить сопровождение\n                            </button>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"md:col-span-4 bg-[#0F172A] p-10 text-white relative flex flex-col plan-card hover:bg-black hover:transition-colors\" data-kid=\"81\">\n                    <div class=\"mb-12\" data-kid=\"82\">\n                        <span class=\"text-[10px] font-black uppercase tracking-[0.2em] text-white/40 block mb-4\" data-kid=\"83\">Introductory</span>\n                        <h3 class=\"text-3xl font-bold mb-4 uppercase\" data-kid=\"84\">СТАРТ 14 ДНЕЙ</h3>\n                        <div class=\"text-4xl font-black text-[#0066FF]\" data-kid=\"85\">2 500 ₽</div>\n                    </div>\n                    <p class=\"text-white/60 text-sm leading-relaxed mb-12 flex-grow\" data-kid=\"86\">\n                        Базовый протокол для очищения и перезагрузки системы. Список продуктов, рецепты и гайд по заменам.\n                    </p>\n                    <button class=\"w-full py-4 border border-white/20 text-xs font-bold uppercase tracking-widest hover:bg-white hover:text-black transition-all\" data-kid=\"87\">\n                        Купить план\n                    </button>\n                </div>\n\n                \n                <div class=\"md:col-span-4 bg-white p-8 border border-black/[0.05] flex flex-col justify-center items-center text-center plan-card hover:border-[#0066FF]/20 hover:transition-colors\" data-kid=\"88\">\n                    <i class=\"ti ti-database text-3xl text-[#0066FF] mb-4\" data-kid=\"89\"></i>\n                    <div class=\"text-lg font-bold mb-2 tracking-tight\" data-kid=\"90\">DATA DRIVEN</div>\n                    <p class=\"text-xs text-[#0F172A]/50 uppercase tracking-widest\" data-kid=\"91\">Анализ более 40 показателей</p>\n                </div>\n                <div class=\"md:col-span-4 bg-[#0066FF] p-8 text-white flex flex-col justify-center items-center text-center plan-card hover:bg-[#0052cc] hover:transition-colors\" data-kid=\"92\">\n                    <i class=\"ti ti-refresh text-3xl mb-4\" data-kid=\"93\"></i>\n                    <div class=\"text-lg font-bold mb-2 tracking-tight\" data-kid=\"94\">ADAPTIVE</div>\n                    <p class=\"text-xs text-white/70 uppercase tracking-widest\" data-kid=\"95\">Динамическая коррекция меню</p>\n                </div>\n                <div class=\"md:col-span-4 bg-white p-8 border border-black/[0.05] flex flex-col justify-center items-center text-center plan-card hover:border-[#0066FF]/20 hover:transition-colors\" data-kid=\"96\">\n                    <i class=\"ti ti-shield-lock text-3xl text-[#0066FF] mb-4\" data-kid=\"97\"></i>\n                    <div class=\"text-lg font-bold mb-2 tracking-tight\" data-kid=\"98\">SECURE</div>\n                    <p class=\"text-xs text-[#0F172A]/50 uppercase tracking-widest\" data-kid=\"99\">Конфиденциальность данных</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-32 bg-white relative overflow-hidden\" data-kid=\"100\">\n        <div class=\"absolute right-0 top-0 opacity-10 pointer-events-none transform translate-x-1/2 -translate-y-1/2\" data-kid=\"101\">\n            <img src=\"https://images.unsplash.com/photo-1716246089854-624131b30f9e?auto=format&w=800&q=80\" class=\"w-[800px] animate-float-slow\" alt data-kid=\"102\">\n        </div>\n        \n        <div class=\"container mx-auto px-6 relative z-10\" data-kid=\"103\">\n            <div class=\"flex flex-col md:flex-row justify-between items-end mb-20 gap-8\" data-kid=\"104\">\n                <div data-kid=\"105\">\n                    <h2 class=\"text-4xl lg:text-5xl font-black text-[#0F172A] mb-4\" data-kid=\"106\">МЕДИЦИНСКИЕ ПРОТОКОЛЫ</h2>\n                    <div class=\"h-1 w-24 bg-[#0066FF]\" data-kid=\"107\"></div>\n                </div>\n                <a href=\"#\" class=\"text-xs font-black uppercase tracking-[0.2em] text-[#0066FF] flex items-center gap-2 group\" data-kid=\"108\">\n                    Все решения <i class=\"ti ti-chevron-right group-hover:translate-x-1 transition-transform\" data-kid=\"109\"></i>\n                </a>\n            </div>\n            \n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-10\" data-kid=\"110\">\n                \n                <div class=\"protocol-item group bg-[#F4F7FA] p-12 border border-black/[0.03] relative overflow-hidden hover:border-[#0066FF]/30 hover:transition-colors\" data-kid=\"111\">\n                    <div class=\"absolute -right-8 -top-8 text-[12rem] font-black text-black/[0.03] select-none pointer-events-none\" data-kid=\"112\">01</div>\n                    <div class=\"relative z-10\" data-kid=\"113\">\n                        <div class=\"flex justify-between items-start mb-12\" data-kid=\"114\">\n                            <div class=\"w-16 h-16 bg-white flex items-center justify-center text-[#0066FF] shadow-sm\" data-kid=\"115\">\n                                <i class=\"ti ti-stomach text-3xl\" data-kid=\"116\"></i>\n                            </div>\n                            <div class=\"text-2xl font-black text-[#0F172A] tabular-nums\" data-kid=\"117\">2 000 ₽</div>\n                        </div>\n                        <h3 class=\"text-3xl font-bold mb-6 tracking-tight\" data-kid=\"118\">ГАСТРО-ПРОТОКОЛ</h3>\n                        <p class=\"text-[#0F172A]/60 mb-10 max-w-md text-sm leading-relaxed\" data-kid=\"119\">\n                            Специализированная программа питания при ГЭРБ, СРК, НАЖБП и хроническом гастрите. Снятие воспаления и восстановление слизистой.\n                        </p>\n                        \n                        <div class=\"flex flex-wrap gap-2 mb-12\" data-kid=\"120\">\n                            <span class=\"px-4 py-2 border border-[#0F172A]/10 text-[10px] font-bold uppercase tracking-widest text-[#0F172A]/50\" data-kid=\"121\">Acid Control</span>\n                            <span class=\"px-4 py-2 border border-[#0F172A]/10 text-[10px] font-bold uppercase tracking-widest text-[#0F172A]/50\" data-kid=\"122\">Anti-Inflammatory</span>\n                            <span class=\"px-4 py-2 border border-[#0F172A]/10 text-[10px] font-bold uppercase tracking-widest text-[#0F172A]/50\" data-kid=\"123\">Microbiome</span>\n                        </div>\n                        \n                        <button class=\"px-8 py-4 bg-black text-white text-xs font-bold uppercase tracking-widest hover:bg-[#0066FF] transition-all w-full md:w-auto\" data-kid=\"124\">\n                            Добавить в корзину\n                        </button>\n                    </div>\n                </div>\n\n                \n                <div class=\"protocol-item group bg-white p-12 border border-black/[0.1] relative overflow-hidden hover:border-[#0066FF]/30 hover:transition-colors\" data-kid=\"125\">\n                    <div class=\"absolute -right-8 -top-8 text-[12rem] font-black text-black/[0.03] select-none pointer-events-none\" data-kid=\"126\">02</div>\n                    <div class=\"relative z-10\" data-kid=\"127\">\n                        <div class=\"flex justify-between items-start mb-12\" data-kid=\"128\">\n                            <div class=\"w-16 h-16 bg-[#0066FF] flex items-center justify-center text-white shadow-lg shadow-[#0066FF]/20\" data-kid=\"129\">\n                                <i class=\"ti ti-flask text-3xl\" data-kid=\"130\"></i>\n                            </div>\n                            <div class=\"text-2xl font-black text-[#0F172A] tabular-nums\" data-kid=\"131\">3 000 ₽</div>\n                        </div>\n                        <h3 class=\"text-3xl font-bold mb-6 tracking-tight uppercase\" data-kid=\"132\">ДЕФИЦИТЫ: ВОСПОЛНЕНИЕ</h3>\n                        <p class=\"text-[#0F172A]/60 mb-10 max-w-md text-sm leading-relaxed\" data-kid=\"133\">\n                            Интеллектуальная схема коррекции критических дефицитов: Ферритин, B12, Витамин D, Кальций. С подбором форм нутрицевтиков.\n                        </p>\n                        \n                        <div class=\"grid grid-cols-2 gap-y-4 mb-12\" data-kid=\"134\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"135\">\n                                <span class=\"w-1 h-1 bg-[#0066FF]\" data-kid=\"136\"></span>\n                                <span class=\"text-[10px] font-black uppercase tracking-widest text-[#0F172A]/60\" data-kid=\"137\">Iron Deficiency</span>\n                            </div>\n                            <div class=\"flex items-center gap-3\" data-kid=\"138\">\n                                <span class=\"w-1 h-1 bg-[#0066FF]\" data-kid=\"139\"></span>\n                                <span class=\"text-[10px] font-black uppercase tracking-widest text-[#0F172A]/60\" data-kid=\"140\">Vitamin D3 / K2</span>\n                            </div>\n                            <div class=\"flex items-center gap-3\" data-kid=\"141\">\n                                <span class=\"w-1 h-1 bg-[#0066FF]\" data-kid=\"142\"></span>\n                                <span class=\"text-[10px] font-black uppercase tracking-widest text-[#0F172A]/60\" data-kid=\"143\">B12 Support</span>\n                            </div>\n                            <div class=\"flex items-center gap-3\" data-kid=\"144\">\n                                <span class=\"w-1 h-1 bg-[#0066FF]\" data-kid=\"145\"></span>\n                                <span class=\"text-[10px] font-black uppercase tracking-widest text-[#0F172A]/60\" data-kid=\"146\">Bone Health</span>\n                            </div>\n                        </div>\n                        \n                        <button class=\"px-8 py-4 bg-black text-white text-xs font-bold uppercase tracking-widest hover:bg-[#0066FF] transition-all w-full md:w-auto\" data-kid=\"147\">\n                            Начать восполнение\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-24 bg-white\" data-kid=\"148\">\n        <div class=\"container mx-auto px-6\" data-kid=\"149\">\n            <div class=\"bg-black text-white p-12 lg:p-20 relative overflow-hidden flex flex-col lg:flex-row items-center justify-between gap-12\" data-kid=\"150\">\n                <div class=\"absolute left-0 bottom-0 w-1/3 h-full opacity-10 pointer-events-none\" data-kid=\"151\">\n                    <img src=\"https://images.unsplash.com/photo-1716246089854-624131b30f9e?auto=format&w=800&q=80\" class=\"w-full h-full object-cover grayscale invert\" alt data-kid=\"152\">\n                </div>\n                \n                <div class=\"relative z-10 max-w-2xl text-center lg:text-left\" data-kid=\"153\">\n                    <div class=\"text-[10px] font-black uppercase tracking-[0.4em] text-[#0066FF] mb-6\" data-kid=\"154\">Next Step Analysis</div>\n                    <h2 class=\"text-4xl lg:text-6xl font-black mb-8 leading-none\" data-kid=\"155\">ГОТОВЫ К ОПТИМИЗАЦИИ?</h2>\n                    <p class=\"text-lg text-white/50 leading-relaxed font-medium\" data-kid=\"156\">\n                        Запишитесь на первичную сессию для разработки индивидуального вектора здоровья.\n                    </p>\n                </div>\n                \n                <div class=\"relative z-10 flex flex-col gap-4 w-full lg:w-auto\" data-kid=\"157\">\n                    <button class=\"px-12 py-5 bg-[#0066FF] text-white font-black uppercase tracking-widest text-xs hover:bg-[#0052cc] transition-all\" data-kid=\"158\">\n                        Записаться на прием\n                    </button>\n                    <button class=\"px-12 py-5 border border-white/20 text-white font-black uppercase tracking-widest text-xs hover:bg-white hover:text-black transition-all\" data-kid=\"159\">\n                        Задать вопрос\n                    </button>\n                </div>\n            </div>\n        </div>\n    </section>\n</main>\n\n<footer class=\"bg-white border-t border-black/5 pt-24 pb-12 overflow-hidden\" data-kid=\"160\">\n    <div class=\"container mx-auto px-6\" data-kid=\"161\">\n        <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 mb-24\" data-kid=\"162\">\n            <div data-kid=\"163\">\n                <div class=\"flex items-center gap-2 mb-10\" data-kid=\"164\">\n                    <div class=\"w-10 h-10 bg-[#0066FF] rounded flex items-center justify-center text-white\" data-kid=\"165\">\n                        <i class=\"ti ti-chart-dots text-2xl\" data-kid=\"166\"></i>\n                    </div>\n                    <span class=\"text-xl font-bold font-heading uppercase tracking-tight\" data-kid=\"167\">DIET Protocol</span>\n                </div>\n                <div class=\"space-y-6\" data-kid=\"168\">\n                    <div class=\"text-[10px] font-black uppercase tracking-widest text-black/30\" data-kid=\"169\">Connect</div>\n                    <div class=\"flex items-center gap-6\" data-kid=\"170\">\n                        <a href=\"#\" class=\"text-black/60 hover:text-[#0066FF] transition-colors\" data-kid=\"171\"><i class=\"ti ti-brand-telegram text-2xl\" data-kid=\"172\"></i></a>\n                        <a href=\"#\" class=\"text-black/60 hover:text-[#0066FF] transition-colors\" data-kid=\"173\"><i class=\"ti ti-brand-whatsapp text-2xl\" data-kid=\"174\"></i></a>\n                        <a href=\"#\" class=\"text-black/60 hover:text-[#0066FF] transition-colors\" data-kid=\"175\"><i class=\"ti ti-brand-instagram text-2xl\" data-kid=\"176\"></i></a>\n                    </div>\n                </div>\n            </div>\n            \n            <div data-kid=\"177\">\n                <h4 class=\"text-[10px] font-black uppercase tracking-widest text-black/30 mb-10\" data-kid=\"178\">Направления</h4>\n                <ul class=\"space-y-4 text-sm font-bold uppercase tracking-widest text-[#0F172A]/60\" data-kid=\"179\">\n                    <li data-kid=\"180\"><a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"181\">Эндоскопия</a></li>\n                    <li data-kid=\"182\"><a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"183\">Онлайн-прием</a></li>\n                    <li data-kid=\"184\"><a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"185\">Диетология</a></li>\n                </ul>\n            </div>\n            \n            <div data-kid=\"186\">\n                <h4 class=\"text-[10px] font-black uppercase tracking-widest text-black/30 mb-10\" data-kid=\"187\">Инфо</h4>\n                <ul class=\"space-y-4 text-sm font-bold uppercase tracking-widest text-[#0F172A]/60\" data-kid=\"188\">\n                    <li data-kid=\"189\"><a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"190\">Подготовка</a></li>\n                    <li data-kid=\"191\"><a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"192\">Цены</a></li>\n                    <li data-kid=\"193\"><a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"194\">Отзывы</a></li>\n                </ul>\n            </div>\n            \n            <div class=\"space-y-12\" data-kid=\"195\">\n                <div data-kid=\"196\">\n                    <h4 class=\"text-[10px] font-black uppercase tracking-widest text-black/30 mb-4\" data-kid=\"197\">Location</h4>\n                    <p class=\"text-sm font-bold uppercase tracking-widest\" data-kid=\"198\">Москва, Пречистенка 10</p>\n                </div>\n                <div data-kid=\"199\">\n                    <h4 class=\"text-[10px] font-black uppercase tracking-widest text-black/30 mb-4\" data-kid=\"200\">Support</h4>\n                    <a href=\"tel:+79991234567\" class=\"text-sm font-bold uppercase tracking-widest hover:text-[#0066FF]\" data-kid=\"201\">+7 (999) 123-45-67</a>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"flex flex-col md:flex-row items-center justify-between gap-8 pt-12 border-t border-black/5\" data-kid=\"202\">\n            <div class=\"text-[10px] font-black uppercase tracking-widest text-black/20\" data-kid=\"203\">© 2026 DR. GASTRO PREMIUM. ALL RIGHTS RESERVED.</div>\n            <div class=\"flex items-center gap-12 text-[10px] font-black uppercase tracking-widest text-black/20\" data-kid=\"204\">\n                <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"205\">Privacy Policy</a>\n                <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"206\">Terms of Service</a>\n            </div>\n        </div>\n    </div>\n</footer>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"207\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"208\"></script>\n<script type=\"module\" data-kid=\"209\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    // Initialize Lenis\n    const lenis = new Lenis()\n    function raf(time) {\n        lenis.raf(time)\n        requestAnimationFrame(raf)\n    }\n    requestAnimationFrame(raf)\n\n    // GSAP Animations\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Hero Animations\n    const heroTl = gsap.timeline({ defaults: { ease: \"expo.out\" } });\n    heroTl.from(\".hero-reveal\", {\n        y: 80,\n        opacity: 0,\n        duration: 1.5,\n        stagger: 0.1,\n    });\n    heroTl.from(\".hero-image-wrap\", {\n        scale: 0.95,\n        opacity: 0,\n        duration: 2,\n    }, \"-=1.2\");\n\n    // Section Scroll Animations\n    gsap.utils.toArray('.plan-card, .protocol-item').forEach((el, index) => {\n        gsap.from(el, {\n            scrollTrigger: {\n                trigger: el,\n                start: \"top 90%\",\n            },\n            y: 50,\n            opacity: 0,\n            duration: 1.2,\n            delay: (index % 3) * 0.1,\n            ease: \"expo.out\"\n        });\n    });\n\n    gsap.from(\"h2, .tech-grid section h2 + div\", {\n        scrollTrigger: {\n            trigger: \"h2\",\n            start: \"top 90%\",\n        },\n        x: -30,\n        opacity: 0,\n        duration: 1,\n        stagger: 0.2\n    });\n\n</script>\n",
