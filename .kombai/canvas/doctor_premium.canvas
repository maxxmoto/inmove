      },
      "html": "<div class=\"min-h-screen bg-[#F8FAFC] text-[#0F172A] selection:bg-[#0066FF]/20 overflow-x-clip\" data-kid=\"0\">\n    \n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        body {\n            font-family: 'Outfit', sans-serif;\n            background-color: #F8FAFC;\n        }\n\n        h1, h2, h3, .font-tech { font-family: 'Space Grotesk', sans-serif; }\n\n        /* Masonry Support */\n        .testimonial-wall {\n            column-count: 1;\n            column-gap: 1.5rem;\n        }\n        @media (min-width: 640px) { .testimonial-wall { column-count: 2; } }\n        @media (min-width: 1024px) { .testimonial-wall { column-count: 3; } }\n        @media (min-width: 1280px) { .testimonial-wall { column-count: 4; } }\n\n        .review-card {\n            break-inside: avoid;\n            margin-bottom: 1.5rem;\n            border: 1px solid rgba(15, 23, 42, 0.05);\n        }\n\n        .glow-hover:hover {\n            box-shadow: 0 0 30px rgba(0, 102, 255, 0.15);\n            border-color: rgba(0, 102, 255, 0.3);\n        }\n\n        /* Custom Scrollbar */\n        ::-webkit-scrollbar { width: 6px; }\n        ::-webkit-scrollbar-track { background: transparent; }\n        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }\n    </style>\n\n    \n    <header class=\"sticky top-0 z-50 bg-white/70 backdrop-blur-2xl border-b border-slate-200/40\" data-kid=\"2\">\n        <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"3\">\n            <div class=\"flex items-center gap-3 group\" data-kid=\"4\">\n                <div class=\"w-10 h-10 bg-[#0066FF] rounded-xl flex items-center justify-center text-white shadow-lg shadow-[#0066FF]/30 group-hover:rotate-12 transition-transform duration-500\" data-kid=\"5\">\n                    <i class=\"ti ti-activity text-xl\" data-kid=\"6\"></i>\n                </div>\n                <div data-kid=\"7\">\n                    <span class=\"block font-bold text-lg leading-none tracking-tight\" data-kid=\"8\">ГастроЭксперт</span>\n                    <span class=\"text-[10px] text-[#0066FF] font-bold uppercase tracking-widest\" data-kid=\"9\">Premium Care</span>\n                </div>\n            </div>\n            <nav class=\"hidden md:flex items-center gap-10\" data-kid=\"10\">\n                <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-slate-400 hover:text-[#0066FF] transition-colors\" data-kid=\"11\">Клиника</a>\n                <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-slate-400 hover:text-[#0066FF] transition-colors\" data-kid=\"12\">Методики</a>\n                <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-[#0066FF] transition-colors\" data-kid=\"13\">Отзывы</a>\n                <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-slate-400 hover:text-[#0066FF] transition-colors\" data-kid=\"14\">Контакты</a>\n            </nav>\n            <button class=\"bg-slate-900 text-white px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-widest hover:bg-[#0066FF] hover:shadow-xl hover:shadow-[#0066FF]/20 transition-all duration-300\" data-kid=\"15\">\n                Запись\n            </button>\n        </div>\n    </header>\n\n    <main class=\"max-w-7xl mx-auto px-6 py-16\" data-kid=\"16\">\n        \n        <section class=\"mb-20\" data-kid=\"17\">\n            <div class=\"grid lg:grid-cols-2 gap-12 items-end\" data-kid=\"18\">\n                <div data-kid=\"19\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-[#0066FF]/5 text-[#0066FF] text-[10px] font-bold uppercase tracking-[0.2em] mb-6 border border-[#0066FF]/10\" data-kid=\"20\">\n                        <i class=\"ti ti-stars\" data-kid=\"21\"></i>\n                        Проверенная репутация\n                    </div>\n                    <h1 class=\"text-5xl lg:text-7xl font-bold text-slate tracking-tighter mb-8 leading-[0.9]\" data-kid=\"22\">\n                        Истории <span class=\"text-[#0066FF]\" data-kid=\"23\">выздоровления</span>\n                    </h1>\n                    <p class=\"text-slate-500 text-xl leading-relaxed max-w-lg\" data-kid=\"24\">\n                        Мы верим в прозрачность. Здесь собраны реальные отзывы пациентов со всех ведущих медицинских порталов.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap gap-2 justify-start lg:justify-end\" data-kid=\"25\">\n                    <button class=\"px-5 py-3 rounded-xl bg-[#0066FF] text-white text-xs font-bold uppercase tracking-widest shadow-xl shadow-[#0066FF]/20 hover:scale-105 transition-transform\" data-kid=\"26\">Все порталы</button>\n                    <button class=\"px-5 py-3 rounded-xl bg-white border border-slate-200 text-xs font-bold uppercase tracking-widest text-slate-500 hover:border-[#0066FF] hover:text-[#0066FF] transition-all\" data-kid=\"27\">ProDoctorov</button>\n                    <button class=\"px-5 py-3 rounded-xl bg-white border border-slate-200 text-xs font-bold uppercase tracking-widest text-slate-500 hover:border-[#0066FF] hover:text-[#0066FF] transition-all\" data-kid=\"28\">Яндекс</button>\n                    <button class=\"px-5 py-3 rounded-xl bg-white border border-slate-200 text-xs font-bold uppercase tracking-widest text-slate-500 hover:border-[#0066FF] hover:text-[#0066FF] transition-all\" data-kid=\"29\">Google</button>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"testimonial-wall\" data-kid=\"30\">\n            \n            <div class=\"review-card p-8 bg-white rounded-3xl shadow-sm glow-hover hover:transition-colors hover:duration-300 group relative overflow-hidden\" data-kid=\"31\">\n                <div class=\"flex justify-between items-start mb-8\" data-kid=\"32\">\n                    <div class=\"flex gap-1 text-[#0066FF]\" data-kid=\"33\">\n                        <i class=\"ti ti-star-filled text-xs\" data-kid=\"34\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"35\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"36\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"37\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"38\"></i>\n                    </div>\n                    <div class=\"text-[9px] font-bold text-slate-400 uppercase tracking-widest bg-slate-50 px-2.5 py-1.5 rounded-lg border border-slate-100\" data-kid=\"39\">ProDoctorov</div>\n                </div>\n                <p class=\"text-slate-700 leading-relaxed mb-10 italic text-lg font-medium\" data-kid=\"40\">\n                    \"Проходила ФГДС под седацией. Очень боялась, но команда профессионалов успокоила. Все прошло идеально, проснулась с улыбкой. Спасибо доктору за чуткость!\"\n                </p>\n                <div class=\"flex items-center gap-4\" data-kid=\"41\">\n                    <div class=\"w-12 h-12 rounded-2xl bg-[#0066FF]/10 flex items-center justify-center text-[#0066FF] font-bold text-sm\" data-kid=\"42\">МВ</div>\n                    <div data-kid=\"43\">\n                        <h4 class=\"font-bold text-slate text-sm\" data-kid=\"44\">Марина В.</h4>\n                        <p class=\"text-[10px] text-slate-400 uppercase font-bold tracking-widest\" data-kid=\"45\">Краснодар</p>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"review-card p-8 bg-white rounded-3xl shadow-sm glow-hover hover:transition-colors hover:duration-300 group\" data-kid=\"46\">\n                <div class=\"flex justify-between items-start mb-8\" data-kid=\"47\">\n                    <div class=\"flex gap-1 text-[#0066FF]\" data-kid=\"48\">\n                        <i class=\"ti ti-star-filled text-xs\" data-kid=\"49\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"50\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"51\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"52\"></i><i class=\"ti ti-star-half-filled text-xs\" data-kid=\"53\"></i>\n                    </div>\n                    <div class=\"text-[9px] font-bold text-[#0066FF] uppercase tracking-widest bg-[#0066FF]/5 px-2.5 py-1.5 rounded-lg border border-[#0066FF]/10\" data-kid=\"54\">Yandex</div>\n                </div>\n                <p class=\"text-slate-700 leading-relaxed mb-10 italic text-base\" data-kid=\"55\">\n                    \"Редкий случай, когда врач не назначает гору таблеток, а ищет причину. После курса диеты и процедур боли ушли. Рекомендую всем, кто ищет доказательную медицину.\"\n                </p>\n                <div class=\"flex items-center gap-4\" data-kid=\"56\">\n                    <img src=\"https://i.pravatar.cc/150?u=ivan\" alt=\"Avatar\" class=\"w-12 h-12 rounded-2xl object-cover shadow-md\" decoding=\"async\" loading=\"lazy\" data-kid=\"57\">\n                    <div data-kid=\"58\">\n                        <h4 class=\"font-bold text-slate text-sm\" data-kid=\"59\">Иван Самойлов</h4>\n                        <p class=\"text-[10px] text-slate-400 uppercase font-bold tracking-widest\" data-kid=\"60\">Ростов-на-Дону</p>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"review-card p-10 bg-[#0066FF] text-white rounded-3xl shadow-2xl shadow-[#0066FF]/20 relative overflow-hidden\" data-kid=\"61\">\n                <div class=\"absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -mr-16 -mt-16 blur-3xl\" data-kid=\"62\"></div>\n                <div class=\"flex justify-between items-start mb-8 relative z-10\" data-kid=\"63\">\n                    <div class=\"flex gap-1\" data-kid=\"64\">\n                        <i class=\"ti ti-star-filled text-xs\" data-kid=\"65\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"66\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"67\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"68\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"69\"></i>\n                    </div>\n                    <i class=\"ti ti-shield-check text-2xl text-white/40\" data-kid=\"70\"></i>\n                </div>\n                <p class=\"leading-relaxed mb-10 italic text-xl font-medium relative z-10\" data-kid=\"71\">\n                    \"Профессионал с большой буквы. Такого внимания к деталям я еще не встречал в частных клиниках. Поставили на ноги за две недели.\"\n                </p>\n                <div class=\"flex items-center gap-4 relative z-10\" data-kid=\"72\">\n                    <div class=\"w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center text-white font-bold text-sm\" data-kid=\"73\">ОК</div>\n                    <div data-kid=\"74\">\n                        <h4 class=\"font-bold text-white text-sm\" data-kid=\"75\">Ольга К.</h4>\n                        <p class=\"text-[10px] text-white/60 uppercase font-bold tracking-widest\" data-kid=\"76\">Москва</p>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"review-card p-8 bg-white rounded-3xl shadow-sm glow-hover transition-colors duration-300 group\" data-kid=\"77\">\n                <div class=\"flex justify-between items-start mb-8\" data-kid=\"78\">\n                    <div class=\"flex gap-1 text-[#0066FF]\" data-kid=\"79\">\n                        <i class=\"ti ti-star-filled text-xs\" data-kid=\"80\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"81\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"82\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"83\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"84\"></i>\n                    </div>\n                    <div class=\"text-[9px] font-bold text-slate-400 uppercase tracking-widest bg-slate-50 px-2.5 py-1.5 rounded-lg border border-slate-100\" data-kid=\"85\">Google</div>\n                </div>\n                <p class=\"text-slate-700 leading-relaxed mb-10 italic text-base\" data-kid=\"86\">\n                    \"Приводила маму на консультацию. Очень бережное отношение к пожилым пациентам. Все разъяснил доступным языком. Огромная благодарность клинике.\"\n                </p>\n                <div class=\"flex items-center gap-4\" data-kid=\"87\">\n                    <div class=\"w-12 h-12 rounded-2xl bg-[#0066FF]/5 flex items-center justify-center text-[#0066FF] font-bold text-sm\" data-kid=\"88\">ЕП</div>\n                    <div data-kid=\"89\">\n                        <h4 class=\"font-bold text-slate text-sm\" data-kid=\"90\">Екатерина Павлова</h4>\n                        <p class=\"text-[10px] text-slate-400 uppercase font-bold tracking-widest\" data-kid=\"91\">Сочи</p>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"review-card p-6 bg-white rounded-3xl shadow-sm glow-hover hover:transition-colors hover:duration-300\" data-kid=\"92\">\n                <div class=\"flex justify-between items-start mb-6\" data-kid=\"93\">\n                    <div class=\"flex gap-1 text-[#0066FF]\" data-kid=\"94\">\n                        <i class=\"ti ti-star-filled text-[10px]\" data-kid=\"95\"></i><i class=\"ti ti-star-filled text-[10px]\" data-kid=\"96\"></i><i class=\"ti ti-star-filled text-[10px]\" data-kid=\"97\"></i><i class=\"ti ti-star-filled text-[10px]\" data-kid=\"98\"></i><i class=\"ti ti-star-filled text-[10px]\" data-kid=\"99\"></i>\n                    </div>\n                    <div class=\"text-[8px] font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"100\">ProDoctorov</div>\n                </div>\n                <p class=\"text-slate-700 leading-relaxed mb-6 italic text-sm font-medium\" data-kid=\"101\">\n                    \"Крутой док! Без воды и лишних трат. Сразу видно уровень.\"\n                </p>\n                <div class=\"flex items-center gap-3\" data-kid=\"102\">\n                    <div class=\"w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-500 font-bold text-xs\" data-kid=\"103\">ДР</div>\n                    <div data-kid=\"104\">\n                        <h4 class=\"font-bold text-slate text-xs\" data-kid=\"105\">Дмитрий Р.</h4>\n                        <p class=\"text-[8px] text-slate-400 uppercase font-bold tracking-widest\" data-kid=\"106\">Казань</p>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"review-card p-8 bg-white rounded-3xl shadow-sm glow-hover hover:transition-colors hover:duration-300 group\" data-kid=\"107\">\n                <div class=\"flex justify-between items-start mb-8\" data-kid=\"108\">\n                    <div class=\"flex gap-1 text-[#0066FF]\" data-kid=\"109\">\n                        <i class=\"ti ti-star-filled text-xs\" data-kid=\"110\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"111\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"112\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"113\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"114\"></i>\n                    </div>\n                    <div class=\"text-[9px] font-bold text-[#0066FF] uppercase tracking-widest bg-[#0066FF]/5 px-2.5 py-1.5 rounded-lg border border-[#0066FF]/10\" data-kid=\"115\">Yandex</div>\n                </div>\n                <p class=\"text-slate-700 leading-relaxed mb-10 italic text-base\" data-kid=\"116\">\n                    \"Наблюдаюсь здесь уже год. Забыла про обострения. Клиника очень современная, результаты приходят в мессенджер. Сервис на высоте!\"\n                </p>\n                <div class=\"flex items-center gap-4\" data-kid=\"117\">\n                    <img src=\"https://i.pravatar.cc/150?u=anna\" alt=\"Avatar\" class=\"w-12 h-12 rounded-2xl object-cover shadow-md\" decoding=\"async\" loading=\"lazy\" data-kid=\"118\">\n                    <div data-kid=\"119\">\n                        <h4 class=\"font-bold text-slate text-sm\" data-kid=\"120\">Анна Т.</h4>\n                        <p class=\"text-[10px] text-slate-400 uppercase font-bold tracking-widest\" data-kid=\"121\">Санкт-Петербург</p>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"review-card p-8 bg-slate-950 text-white rounded-3xl shadow-2xl relative overflow-hidden group border-none\" data-kid=\"122\">\n                <div class=\"absolute inset-0 bg-gradient-to-br from-[#0066FF]/20 to-transparent opacity-50\" data-kid=\"123\"></div>\n                <div class=\"flex justify-between items-start mb-8 relative z-10\" data-kid=\"124\">\n                    <div class=\"flex gap-1 text-[#0066FF]\" data-kid=\"125\">\n                        <i class=\"ti ti-star-filled text-xs\" data-kid=\"126\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"127\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"128\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"129\"></i><i class=\"ti ti-star text-xs\" data-kid=\"130\"></i>\n                    </div>\n                    <span class=\"text-[9px] font-bold text-[#60A5FA] bg-[#60A5FA]/10 px-2.5 py-1.5 rounded-lg border border-[#60A5FA]/20 uppercase tracking-widest\" data-kid=\"131\">Verified User</span>\n                </div>\n                <p class=\"leading-relaxed mb-10 italic text-base font-medium relative z-10 text-slate-200\" data-kid=\"132\">\n                    \"Записался онлайн через Telegram, приняли вовремя. Доктор провел осмотр очень внимательно. Никакого навязывания услуг. Только по делу.\"\n                </p>\n                <div class=\"flex items-center gap-4 relative z-10\" data-kid=\"133\">\n                    <div class=\"w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-white font-bold text-sm\" data-kid=\"134\">АС</div>\n                    <div data-kid=\"135\">\n                        <h4 class=\"font-bold text-white text-sm\" data-kid=\"136\">Артем С.</h4>\n                        <p class=\"text-[10px] text-slate-500 uppercase font-bold tracking-widest\" data-kid=\"137\">Екатеринбург</p>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"review-card p-8 bg-white rounded-3xl shadow-sm glow-hover hover:transition-colors hover:duration-300 group\" data-kid=\"138\">\n                <div class=\"flex justify-between items-start mb-8\" data-kid=\"139\">\n                    <div class=\"flex gap-1 text-[#0066FF]\" data-kid=\"140\">\n                        <i class=\"ti ti-star-filled text-xs\" data-kid=\"141\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"142\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"143\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"144\"></i><i class=\"ti ti-star-filled text-xs\" data-kid=\"145\"></i>\n                    </div>\n                    <div class=\"text-[9px] font-bold text-slate-400 uppercase tracking-widest bg-slate-50 px-2.5 py-1.5 rounded-lg border border-slate-100\" data-kid=\"146\">Google</div>\n                </div>\n                <p class=\"text-slate-700 leading-relaxed mb-10 italic text-base\" data-kid=\"147\">\n                    \"Отличный гастроэнтеролог. Вылечил хеликобактер быстро и без побочек, так как грамотно подобрал поддержку. Спасибо!\"\n                </p>\n                <div class=\"flex items-center gap-4\" data-kid=\"148\">\n                    <div class=\"w-12 h-12 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-400 font-bold text-sm\" data-kid=\"149\">НГ</div>\n                    <div data-kid=\"150\">\n                        <h4 class=\"font-bold text-slate text-sm\" data-kid=\"151\">Николай Г.</h4>\n                        <p class=\"text-[10px] text-slate-400 uppercase font-bold tracking-widest\" data-kid=\"152\">Нижний Новгород</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"mt-32 mb-12\" data-kid=\"153\">\n            <div class=\"relative bg-slate-950 rounded-[3rem] overflow-hidden flex flex-col lg:flex-row items-center\" data-kid=\"154\">\n                \n                <div class=\"lg:w-1/2 w-full h-[300px] lg:h-[500px] relative overflow-hidden\" data-kid=\"155\">\n                    <img src=\"https://images.unsplash.com/photo-1716246089854-624131b30f9e?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover opacity-60 scale-110 group-hover:scale-100 transition-transform duration-700\" alt=\"Tech Background\" decoding=\"async\" loading=\"lazy\" data-kid=\"156\">\n                    <div class=\"absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/20 to-transparent\" data-kid=\"157\"></div>\n                    <div class=\"absolute inset-0 flex items-center justify-center lg:justify-start px-12\" data-kid=\"158\">\n                         <div class=\"w-16 h-16 bg-[#0066FF] rounded-full flex items-center justify-center text-white animate-pulse\" data-kid=\"159\">\n                            <i class=\"ti ti-message-2-star text-3xl\" data-kid=\"160\"></i>\n                         </div>\n                    </div>\n                </div>\n\n                <div class=\"lg:w-1/2 w-full p-12 lg:p-20 text-left relative z-10\" data-kid=\"161\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0066FF]/10 text-[#0066FF] text-[10px] font-bold uppercase tracking-widest mb-8 border border-[#0066FF]/20\" data-kid=\"162\">\n                        Community Support\n                    </div>\n                    <h2 class=\"text-4xl lg:text-6xl font-bold text-white mb-8 tracking-tighter leading-none\" data-kid=\"163\">\n                        Ваш голос имеет <span class=\"text-[#0066FF]\" data-kid=\"164\">значение</span>.\n                    </h2>\n                    <p class=\"text-slate-400 text-lg mb-12 max-w-md\" data-kid=\"165\">\n                        Расскажите свою историю. Мы ценим каждый отзыв, так как он помогает другим пациентам обрести надежду и найти правильный путь к здоровью.\n                    </p>\n                    <div class=\"flex flex-wrap gap-4\" data-kid=\"166\">\n                        <button class=\"bg-[#0066FF] text-white px-10 py-5 rounded-2xl font-bold text-sm uppercase tracking-widest shadow-2xl shadow-[#0066FF]/40 hover:bg-[#0052cc] hover:-translate-y-1 active:scale-95 transition-all\" data-kid=\"167\">\n                            Написать отзыв\n                        </button>\n                        <button class=\"bg-white/5 text-white border border-white/10 px-10 py-5 rounded-2xl font-bold text-sm uppercase tracking-widest hover:bg-white/10 transition-all\" data-kid=\"168\">\n                            Все порталы\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    \n    <footer class=\"border-t border-slate-200/40 bg-white py-12\" data-kid=\"169\">\n        <div class=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-10\" data-kid=\"170\">\n            <div class=\"flex items-center gap-3\" data-kid=\"171\">\n                <div class=\"w-8 h-8 bg-[#0066FF] rounded-lg flex items-center justify-center text-white shadow-md shadow-[#0066FF]/20\" data-kid=\"172\">\n                    <i class=\"ti ti-activity text-sm\" data-kid=\"173\"></i>\n                </div>\n                <span class=\"font-bold text-slate tracking-tight\" data-kid=\"174\">ГастроЭксперт.</span>\n            </div>\n            <div class=\"flex flex-wrap gap-10 text-[10px] font-bold uppercase tracking-widest text-slate-400\" data-kid=\"175\">\n                <a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"176\">Правовая информация</a>\n                <a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"177\">Лицензии</a>\n                <a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"178\">Запись на прием</a>\n            </div>\n            <div class=\"text-[10px] text-slate-300 font-bold uppercase tracking-[0.2em]\" data-kid=\"179\">\n                &copy; 2026 Premium Medicine\n            </div>\n        </div>\n    </footer>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"180\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"181\"></script>\n    <script data-kid=\"182\">\n        gsap.registerPlugin(ScrollTrigger);\n\n        // Animate cards on scroll\n        gsap.from(\".review-card\", {\n            scrollTrigger: {\n                trigger: \".testimonial-wall\",\n                start: \"top 85%\",\n            },\n            y: 60,\n            opacity: 0,\n            duration: 1,\n            stagger: 0.15,\n            ease: \"expo.out\",\n            clearProps: \"all\"\n        });\n\n        // Title text animation\n        gsap.from(\"h1\", {\n            opacity: 0,\n            y: 30,\n            duration: 1.2,\n            ease: \"power4.out\",\n            delay: 0.2\n        });\n    </script>\n</div>\n",
