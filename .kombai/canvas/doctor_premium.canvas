      "html": "<div id=\"page-wrapper\" class=\"selection:bg-[#0066FF] selection:text-white font-['Inter',sans-serif] bg-white text-[#0F172A] relative overflow-x-clip\" data-kid=\"0\">\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"2\">\n    <style data-kid=\"3\">\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');\n\n        :root {\n            --azure: #0066FF;\n            --slate: #0F172A;\n            --bg: #FFFFFF;\n            --secondary-bg: #F4F7FA;\n            --glass-border: rgba(15, 23, 42, 0.08);\n        }\n\n        .font-serif { font-family: 'Playfair Display', serif; }\n\n        .tech-grid {\n            background-image: radial-gradient(var(--azure) 0.5px, transparent 0.5px);\n            background-size: 40px 40px;\n            opacity: 0.03;\n        }\n\n        .timeline-line {\n            background: linear-gradient(to bottom, transparent, var(--azure), transparent);\n        }\n\n        /* Hover transitions that don't conflict with GSAP initial state */\n        .hover-lift {\n            transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.4s cubic-bezier(0.2, 0, 0, 1);\n        }\n        .hover-lift:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);\n        }\n    </style>\n\n    \n    <header class=\"fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-black/5\" data-kid=\"4\">\n        <nav class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"5\">\n            <div class=\"flex items-center gap-2\" data-kid=\"6\">\n                <div class=\"w-8 h-8 bg-[var(--azure)] rounded-lg flex items-center justify-center text-white\" data-kid=\"7\">\n                    <i class=\"ti ti-activity text-lg\" data-kid=\"8\"></i>\n                </div>\n                <span class=\"font-bold text-lg tracking-tight\" data-kid=\"9\">А. Иванов</span>\n            </div>\n            <div class=\"hidden md:flex items-center gap-10\" data-kid=\"10\">\n                <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-[var(--slate)] hover:text-[var(--azure)] transition-colors\" data-kid=\"11\">Обо мне</a>\n                <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-[var(--slate)]/40 hover:text-[var(--azure)] transition-colors\" data-kid=\"12\">Образование</a>\n                <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-[var(--slate)]/40 hover:text-[var(--azure)] transition-colors\" data-kid=\"13\">Дипломы</a>\n                <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-[var(--slate)]/40 hover:text-[var(--azure)] transition-colors\" data-kid=\"14\">Контакты</a>\n            </div>\n            <button class=\"px-7 py-2.5 bg-[var(--azure)] text-white rounded-full text-xs font-black uppercase tracking-widest hover:brightness-110 active:scale-95 transition-all\" data-kid=\"15\">\n                Записаться\n            </button>\n        </nav>\n    </header>\n\n    <main data-kid=\"16\">\n        \n        <section id=\"hero\" class=\"relative pt-20 min-h-screen flex items-center overflow-hidden bg-white\" data-kid=\"17\">\n            <div class=\"absolute inset-0 tech-grid\" data-kid=\"18\"></div>\n            \n            <div class=\"max-w-[1440px] mx-auto w-full flex flex-col lg:flex-row items-center\" data-kid=\"19\">\n                \n                <div class=\"w-full lg:w-1/2 hero-img-container\" data-kid=\"20\">\n                    <div class=\"relative w-full aspect-[4/5] lg:aspect-[3/4] overflow-hidden lg:rounded-r-[3rem]\" data-kid=\"21\">\n                        <img src=\"https://images.unsplash.com/photo-1645066928295-2506defde470?auto=format&w=1200&q=90&fit=crop\" alt=\"Доктор\" class=\"w-full h-full object-cover hero-img-src\" decoding=\"async\" loading=\"lazy\" data-kid=\"22\">\n                        \n                        <div class=\"absolute bottom-10 left-10 p-8 glass-card rounded-2xl bg-white/90 border-white/50 shadow-2xl max-w-xs hidden lg:block hero-badge\" data-kid=\"23\">\n                            <div class=\"flex items-center gap-3 mb-3\" data-kid=\"24\">\n                                <span class=\"relative flex h-2 w-2\" data-kid=\"25\">\n                                    <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--azure)] opacity-75\" data-kid=\"26\"></span>\n                                    <span class=\"relative inline-flex rounded-full h-2 w-2 bg-[var(--azure)]\" data-kid=\"27\"></span>\n                                </span>\n                                <span class=\"text-[var(--azure)] font-black text-[10px] uppercase tracking-[0.2em]\" data-kid=\"28\">Прием в Москве</span>\n                            </div>\n                            <p class=\"text-sm font-medium text-[var(--slate)] leading-relaxed\" data-kid=\"29\">\n                                Член Европейской ассоциации UEG. 15 лет клинического стажа.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"w-full lg:w-1/2 px-8 lg:px-20 hero-text\" data-kid=\"30\">\n                    <div class=\"space-y-12\" data-kid=\"31\">\n                        <div class=\"space-y-4\" data-kid=\"32\">\n                            <h1 class=\"text-7xl lg:text-[120px] font-serif italic text-[var(--slate)] leading-[0.85] tracking-tighter\" data-kid=\"33\">\n                                Александр <br data-kid=\"34\"> <span class=\"not-italic font-bold\" data-kid=\"35\">Иванов</span>\n                            </h1>\n                            <p class=\"text-sm font-black uppercase tracking-[0.4em] text-[var(--azure)]\" data-kid=\"36\">Гастроэнтеролог • Эндоскопист</p>\n                        </div>\n                        \n                        <p class=\"text-xl lg:text-2xl text-[var(--slate)]/70 leading-relaxed max-w-xl font-light\" data-kid=\"37\">\n                            Экспертный подход к <span class=\"text-[var(--slate)] font-semibold underline decoration-[var(--azure)]/30 underline-offset-8\" data-kid=\"38\">здоровью вашего ЖКТ</span>. Внедряю протоколы доказательной медицины и мировые стандарты диагностики.\n                        </p>\n\n                        <div class=\"flex flex-col sm:flex-row gap-6 pt-4\" data-kid=\"39\">\n                            <button class=\"h-16 px-10 bg-[var(--azure)] text-white rounded-xl font-black text-sm uppercase tracking-widest hover:translate-y-[-2px] transition-transform active:scale-95\" data-kid=\"40\">\n                                Онлайн запись\n                            </button>\n                            <button class=\"h-16 px-10 bg-transparent border-2 border-[var(--slate)] text-[var(--slate)] rounded-xl font-black text-sm uppercase tracking-widest hover:bg-[var(--slate)] hover:text-white transition-all\" data-kid=\"41\">\n                                Консультация\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-32 bg-[#F4F7FA] px-6 lg:px-24\" data-kid=\"42\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"43\">\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-20\" data-kid=\"44\">\n                    <div class=\"stat-item\" data-kid=\"45\">\n                        <span class=\"text-sm font-black uppercase tracking-[0.3em] text-[var(--azure)] block mb-4\" data-kid=\"46\">Опыт</span>\n                        <h3 class=\"text-7xl font-serif italic text-[var(--slate)]\" data-kid=\"47\">15+ <span class=\"text-2xl not-italic font-light opacity-40\" data-kid=\"48\">лет</span></h3>\n                        <p class=\"text-sm text-[var(--slate)]/50 mt-4 leading-relaxed font-medium\" data-kid=\"49\">Безупречной клинической практики в ведущих центрах.</p>\n                    </div>\n                    <div class=\"stat-item\" data-kid=\"50\">\n                        <span class=\"text-sm font-black uppercase tracking-[0.3em] text-[var(--azure)] block mb-4\" data-kid=\"51\">Пациенты</span>\n                        <h3 class=\"text-7xl font-serif italic text-[var(--slate)]\" data-kid=\"52\">5000+</h3>\n                        <p class=\"text-sm text-[var(--slate)]/50 mt-4 leading-relaxed font-medium\" data-kid=\"53\">Успешных случаев восстановления здоровья ЖКТ.</p>\n                    </div>\n                    <div class=\"stat-item\" data-kid=\"54\">\n                        <span class=\"text-sm font-black uppercase tracking-[0.3em] text-[var(--azure)] block mb-4\" data-kid=\"55\">Наука</span>\n                        <h3 class=\"text-7xl font-serif italic text-[var(--slate)]\" data-kid=\"56\">120+</h3>\n                        <p class=\"text-sm text-[var(--slate)]/50 mt-4 leading-relaxed font-medium\" data-kid=\"57\">Выступлений на международных конференциях.</p>\n                    </div>\n                    <div class=\"stat-item\" data-kid=\"58\">\n                        <span class=\"text-sm font-black uppercase tracking-[0.3em] text-[var(--azure)] block mb-4\" data-kid=\"59\">Труды</span>\n                        <h3 class=\"text-7xl font-serif italic text-[var(--slate)]\" data-kid=\"60\">30+ <span class=\"text-2xl not-italic font-light opacity-40\" data-kid=\"61\">статей</span></h3>\n                        <p class=\"text-sm text-[var(--slate)]/50 mt-4 leading-relaxed font-medium\" data-kid=\"62\">Публикаций в рецензируемых медицинских журналах.</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-40 px-6 lg:px-24 bg-white\" data-kid=\"63\">\n            <div class=\"max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-20\" data-kid=\"64\">\n                <div class=\"lg:col-span-5 section-header\" data-kid=\"65\">\n                    <h2 class=\"text-6xl font-serif italic text-[var(--slate)] leading-tight\" data-kid=\"66\">Образование <br data-kid=\"67\"> & опыт</h2>\n                    <p class=\"text-lg text-[var(--slate)]/50 mt-8 font-light leading-relaxed\" data-kid=\"68\">\n                        Мой путь — это симбиоз фундаментальной российской школы и западных медицинских технологий.\n                    </p>\n                </div>\n                \n                <div class=\"lg:col-span-7 space-y-24 timeline-container\" data-kid=\"69\">\n                    \n                    <div class=\"timeline-row flex gap-12\" data-kid=\"70\">\n                        <div class=\"w-12 h-px bg-[var(--azure)] mt-4 shrink-0\" data-kid=\"71\"></div>\n                        <div data-kid=\"72\">\n                            <span class=\"text-xs font-black uppercase tracking-[0.3em] text-[var(--azure)] block mb-4\" data-kid=\"73\">2005 — 2011</span>\n                            <h3 class=\"text-3xl font-bold text-[var(--slate)] mb-4\" data-kid=\"74\">МГУ им. Ломоносова</h3>\n                            <p class=\"text-[var(--slate)]/50 text-lg leading-relaxed font-light\" data-kid=\"75\">Красный диплом медицинского факультета. Специализация: внутренние болезни и гастроэнтерология.</p>\n                        </div>\n                    </div>\n                    \n                    <div class=\"timeline-row flex gap-12\" data-kid=\"76\">\n                        <div class=\"w-12 h-px bg-[var(--azure)] mt-4 shrink-0\" data-kid=\"77\"></div>\n                        <div data-kid=\"78\">\n                            <span class=\"text-xs font-black uppercase tracking-[0.3em] text-[var(--azure)] block mb-4\" data-kid=\"79\">2012 — 2014</span>\n                            <h3 class=\"text-3xl font-bold text-[var(--slate)] mb-4\" data-kid=\"80\">Mayo Clinic (США)</h3>\n                            <p class=\"text-[var(--slate)]/50 text-lg leading-relaxed font-light\" data-kid=\"81\">Fellowship в отделении инвазивной эндоскопии. Изучение передовых методов диагностики Barrett's esophagus.</p>\n                        </div>\n                    </div>\n                    \n                    <div class=\"timeline-row flex gap-12\" data-kid=\"82\">\n                        <div class=\"w-12 h-px bg-[var(--azure)] mt-4 shrink-0\" data-kid=\"83\"></div>\n                        <div data-kid=\"84\">\n                            <span class=\"text-xs font-black uppercase tracking-[0.3em] text-[var(--azure)] block mb-4\" data-kid=\"85\">2018 — Наст. время</span>\n                            <h3 class=\"text-3xl font-bold text-[var(--slate)] mb-4\" data-kid=\"86\">Кандидат наук</h3>\n                            <p class=\"text-[var(--slate)]/50 text-lg leading-relaxed font-light\" data-kid=\"87\">Ведущий консультант-гастроэнтеролог. Разработка авторских программ по восстановлению микробиома.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-40 bg-[var(--slate)] text-white overflow-hidden relative\" data-kid=\"88\">\n            <div class=\"max-w-5xl mx-auto px-6 text-center pull-quote-container\" data-kid=\"89\">\n                <p class=\"text-sm font-black uppercase tracking-[0.5em] text-[var(--azure)] mb-16\" data-kid=\"90\">Моя философия</p>\n                <blockquote class=\"text-4xl lg:text-7xl font-serif italic leading-[1.15] mb-20 tracking-tight\" data-kid=\"91\">\n                    \"Медицина для меня — это не просто <br class=\"hidden lg:block\" data-kid=\"92\"> купирование боли, а <span class=\"not-italic font-bold text-white underline decoration-[var(--azure)]/60 underline-offset-12\" data-kid=\"93\">интеллектуальный поиск</span> глубинных причин нарушения баланса организма.\"\n                </blockquote>\n                <div class=\"flex flex-col items-center\" data-kid=\"94\">\n                    <p class=\"text-lg font-black tracking-widest uppercase\" data-kid=\"95\">Доктор Иванов</p>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-40 bg-white px-6 lg:px-24\" data-kid=\"96\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"97\">\n                <div class=\"mb-24 flex flex-col md:flex-row md:items-end justify-between gap-10 diplomas-header\" data-kid=\"98\">\n                    <div data-kid=\"99\">\n                        <h2 class=\"text-6xl font-serif italic text-[var(--slate)]\" data-kid=\"100\">Дипломы и <br data-kid=\"101\"> признание</h2>\n                    </div>\n                    <div class=\"max-w-md\" data-kid=\"102\">\n                        <p class=\"text-lg text-[var(--slate)]/50 font-light leading-relaxed\" data-kid=\"103\">\n                            Официальные документы, подтверждающие международную квалификацию и право на ведение экспертной практики.\n                        </p>\n                    </div>\n                </div>\n                \n                <div class=\"columns-1 md:columns-2 lg:columns-3 gap-10 space-y-10 masonry-gallery\" data-kid=\"104\">\n                    \n                    <div class=\"gallery-item break-inside-avoid relative group overflow-hidden bg-gray-50 rounded-2xl\" data-kid=\"105\">\n                        <img src=\"https://images.unsplash.com/photo-1580281657702-257584239a55?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-auto grayscale group-hover:grayscale-0 transition-shadow duration-700\" alt=\"Диплом\" decoding=\"async\" loading=\"lazy\" data-kid=\"106\">\n                        <div class=\"p-8\" data-kid=\"107\">\n                            <h4 class=\"text-xl font-bold text-[var(--slate)]\" data-kid=\"108\">МГУ им. Ломоносова</h4>\n                            <p class=\"text-xs font-black uppercase tracking-widest text-[var(--slate)]/30 mt-2\" data-kid=\"109\">Красный диплом врача</p>\n                        </div>\n                    </div>\n                    \n                    <div class=\"gallery-item break-inside-avoid bg-[var(--azure)] p-12 rounded-2xl text-white\" data-kid=\"110\">\n                        <i class=\"ti ti-rosette-filled text-5xl mb-8 opacity-40\" data-kid=\"111\"></i>\n                        <h4 class=\"text-3xl font-bold mb-6\" data-kid=\"112\">UEG Board</h4>\n                        <p class=\"text-lg opacity-80 font-light\" data-kid=\"113\">Сертифицированный член Европейской ассоциации гастроэнтерологии и эндоскопии.</p>\n                    </div>\n                    \n                    <div class=\"gallery-item break-inside-avoid relative group overflow-hidden bg-gray-50 rounded-2xl\" data-kid=\"114\">\n                        <img src=\"https://images.unsplash.com/photo-1766299892549-b56b257d1ddd?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-auto grayscale group-hover:grayscale-0 transition-shadow duration-700\" alt=\"Диплом\" decoding=\"async\" loading=\"lazy\" data-kid=\"115\">\n                        <div class=\"p-8\" data-kid=\"116\">\n                            <h4 class=\"text-xl font-bold text-[var(--slate)]\" data-kid=\"117\">Mayo Clinic Advanced</h4>\n                            <p class=\"text-xs font-black uppercase tracking-widest text-[var(--slate)]/30 mt-2\" data-kid=\"118\">Specialization Certificate</p>\n                        </div>\n                    </div>\n                    \n                    <div class=\"gallery-item break-inside-avoid relative group overflow-hidden bg-gray-50 rounded-2xl\" data-kid=\"119\">\n                        <img src=\"https://images.unsplash.com/photo-1512677859289-868722942457?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-auto grayscale group-hover:grayscale-0 transition-shadow duration-700\" alt=\"Диплом\" decoding=\"async\" loading=\"lazy\" data-kid=\"120\">\n                        <div class=\"p-8\" data-kid=\"121\">\n                            <h4 class=\"text-xl font-bold text-[var(--slate)]\" data-kid=\"122\">РНИМУ им. Пирогова</h4>\n                            <p class=\"text-xs font-black uppercase tracking-widest text-[var(--slate)]/30 mt-2\" data-kid=\"123\">Professional Training</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-40 bg-white border-t border-black/5\" data-kid=\"124\">\n            <div class=\"max-w-4xl mx-auto text-center px-6 socials-container\" data-kid=\"125\">\n                <h2 class=\"text-4xl font-serif italic mb-12 text-[var(--slate)]\" data-kid=\"126\">Экспертный блог</h2>\n                <div class=\"flex flex-wrap justify-center gap-6\" data-kid=\"127\">\n                    <a href=\"#\" class=\"h-16 px-12 inline-flex items-center gap-4 bg-white border-2 border-[var(--slate)] rounded-xl hover:bg-[var(--slate)] hover:text-white transition-all group\" data-kid=\"128\">\n                        <i class=\"ti ti-brand-telegram text-2xl\" data-kid=\"129\"></i>\n                        <span class=\"font-black text-sm uppercase tracking-widest\" data-kid=\"130\">Telegram</span>\n                    </a>\n                    <a href=\"#\" class=\"h-16 px-12 inline-flex items-center gap-4 bg-white border-2 border-[var(--slate)] rounded-xl hover:bg-[var(--slate)] hover:text-white transition-all group\" data-kid=\"131\">\n                        <i class=\"ti ti-brand-open-source text-2xl\" data-kid=\"132\"></i>\n                        <span class=\"font-black text-sm uppercase tracking-widest\" data-kid=\"133\">Яндекс Дзен</span>\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <footer class=\"py-16 px-6 lg:px-24 bg-white border-t border-gray-100\" data-kid=\"134\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-12 text-center md:text-left\" data-kid=\"135\">\n            <div class=\"flex items-center gap-3\" data-kid=\"136\">\n                <div class=\"w-8 h-8 bg-[var(--azure)] rounded-lg flex items-center justify-center text-white\" data-kid=\"137\">\n                    <i class=\"ti ti-activity text-sm\" data-kid=\"138\"></i>\n                </div>\n                <span class=\"font-bold text-xl tracking-tighter text-[var(--slate)]\" data-kid=\"139\">Ivanov.GI</span>\n            </div>\n            <p class=\"text-[10px] font-black uppercase tracking-[0.3em] text-[var(--slate)]/30\" data-kid=\"140\">© 2026 Александр Иванов. Все права защищены.</p>\n            <div class=\"flex items-center gap-8\" data-kid=\"141\">\n                <a href=\"#\" class=\"text-[10px] font-black uppercase tracking-widest text-[var(--slate)]/50 hover:text-[var(--azure)] transition-colors\" data-kid=\"142\">Privacy</a>\n                <a href=\"#\" class=\"text-[10px] font-black uppercase tracking-widest text-[var(--slate)]/50 hover:text-[var(--azure)] transition-colors\" data-kid=\"143\">Legal</a>\n            </div>\n        </div>\n    </footer>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"144\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"145\"></script>\n    <script type=\"module\" data-kid=\"146\">\n        import Lenis from \"https://esm.sh/lenis@1\";\n        \n        gsap.registerPlugin(ScrollTrigger);\n\n        const lenis = new Lenis({\n            duration: 1.4,\n            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n            orientation: 'vertical',\n            gestureOrientation: 'vertical',\n            smoothWheel: true,\n            wheelMultiplier: 1,\n            touchMultiplier: 2,\n            infinite: false,\n        });\n\n        function raf(time) {\n            lenis.raf(time);\n            requestAnimationFrame(raf);\n        }\n\n        requestAnimationFrame(raf);\n\n        window.addEventListener('load', () => {\n            // Hero\n            const heroTl = gsap.timeline({ defaults: { ease: \"power4.out\", duration: 1.6 } });\n            heroTl\n                .from(\".hero-img-container\", { x: -80, opacity: 0 })\n                .from(\".hero-text\", { x: 80, opacity: 0 }, \"-=1.4\")\n                .from(\".hero-badge\", { y: 20, opacity: 0 }, \"-=1\")\n                .from(\".hero-img-src\", { scale: 1.2, duration: 2.5 }, \"-=2\");\n\n            // Stats\n            gsap.from(\".stat-item\", {\n                opacity: 0,\n                y: 30,\n                duration: 1,\n                stagger: 0.1,\n                scrollTrigger: {\n                    trigger: \".stat-item\",\n                    start: \"top 90%\",\n                }\n            });\n\n            // Timeline\n            gsap.from(\".timeline-row\", {\n                opacity: 0,\n                x: -30,\n                duration: 1,\n                stagger: 0.2,\n                scrollTrigger: {\n                    trigger: \".timeline-container\",\n                    start: \"top 80%\",\n                }\n            });\n\n            // Pull Quote\n            gsap.from(\".pull-quote-container\", {\n                opacity: 0,\n                scale: 0.98,\n                duration: 1.8,\n                scrollTrigger: {\n                    trigger: \".pull-quote-container\",\n                    start: \"top 75%\",\n                }\n            });\n\n            // Diplomas\n            gsap.from(\".gallery-item\", {\n                opacity: 0,\n                y: 40,\n                duration: 1.2,\n                stagger: 0.15,\n                scrollTrigger: {\n                    trigger: \".masonry-gallery\",\n                    start: \"top 80%\",\n                }\n            });\n\n            // Socials\n            gsap.from(\".socials-container\", {\n                opacity: 0,\n                y: 20,\n                duration: 1,\n                scrollTrigger: {\n                    trigger: \".socials-container\",\n                    start: \"top 95%\",\n                }\n            });\n        });\n    </script>\n</div>\n",
