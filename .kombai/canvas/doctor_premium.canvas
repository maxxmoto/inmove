      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Manrope:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css');\n\n  :root {\n    --bg-midnight: #2A3439;\n    --card-teal: #1B4D3E;\n    --neon-fern: #4CBB17;\n    --text-white: #FFFFFF;\n  }\n\n  body {\n    background-color: #121212; /* Darker outer background */\n    color: var(--text-white);\n    font-family: 'Manrope', sans-serif;\n    margin: 0;\n    display: flex;\n    justify-content: center;\n  }\n\n  .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }\n\n  /* Pattern: #neon-glow */\n  .neon-glow-card {\n    border: 1.5px solid var(--neon-fern);\n    box-shadow: 0 0 15px rgba(76, 187, 23, 0.3), 0 0 45px rgba(76, 187, 23, 0.05);\n  }\n\n  .neon-glow-text {\n    text-shadow: 0 0 8px rgba(76, 187, 23, 0.6);\n  }\n\n  /* Pattern: #polaroid-scatter */\n  .polaroid {\n    background: #fdfdfd;\n    padding: 6px 6px 36px 6px;\n    box-shadow: 0 12px 30px rgba(0,0,0,0.5);\n    border-radius: 2px;\n    width: 110px;\n    position: absolute;\n    transform-origin: center;\n    border: 1px solid rgba(0,0,0,0.05);\n  }\n  \n  .polaroid img {\n    width: 100%;\n    height: 90px;\n    object-fit: cover;\n    border-radius: 1px;\n  }\n\n  /* Pattern: #bottom-tab-bar + #floating-island */\n  .nav-island {\n    position: absolute;\n    bottom: 20px;\n    left: 16px;\n    right: 16px;\n    height: 64px;\n    background: rgba(18, 51, 41, 0.98);\n    backdrop-filter: blur(30px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    border-radius: 32px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 20px;\n    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);\n    z-index: 200;\n  }\n\n  .nav-item {\n    color: rgba(255, 255, 255, 0.3);\n    font-size: 18px;\n    width: 40px;\n    height: 40px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    position: relative;\n  }\n\n  .nav-item.active {\n    color: var(--neon-fern);\n  }\n\n  .nav-item.active::after {\n    content: '';\n    position: absolute;\n    bottom: 0;\n    width: 4px;\n    height: 4px;\n    background: var(--neon-fern);\n    border-radius: 50%;\n    box-shadow: 0 0 8px var(--neon-fern);\n  }\n\n  /* Pattern: #fab-speed-dial - Centered over Nav Island */\n  .fab-group {\n    position: absolute;\n    bottom: 50px;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 300;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .fab-main {\n    width: 60px;\n    height: 60px;\n    background: var(--neon-fern);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-shadow: 0 10px 30px rgba(76, 187, 23, 0.6);\n    color: #000;\n    font-size: 24px;\n    cursor: pointer;\n    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\n    border: 4px solid var(--bg-midnight);\n  }\n\n  .fab-main.active {\n    transform: rotate(45deg);\n  }\n\n  .speed-dial-option {\n    width: 52px;\n    height: 52px;\n    background: var(--card-teal);\n    border-radius: 18px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 12px;\n    color: white;\n    box-shadow: 0 6px 15px rgba(0,0,0,0.4);\n    cursor: pointer;\n    visibility: hidden;\n    opacity: 0;\n    transform: translateY(20px);\n  }\n\n  .speed-dial-label {\n    position: absolute;\n    left: 50%;\n    transform: translateX(-50%);\n    bottom: -24px;\n    background: rgba(0,0,0,0.85);\n    padding: 3px 10px;\n    border-radius: 6px;\n    font-size: 10px;\n    font-weight: 700;\n    white-space: nowrap;\n    color: white;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n\n  /* Custom glassmorphism for wallet action buttons */\n  .glass-btn {\n    background: rgba(255, 255, 255, 0.08);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    backdrop-filter: blur(10px);\n  }\n</style>\n\n<div class=\"max-w-[390px] w-full mx-auto relative bg-[var(--bg-midnight)] min-h-screen shadow-2xl overflow-hidden flex flex-col\" data-kid=\"1\">\n  \n  \n  <main class=\"px-6 pt-12 flex flex-col gap-9 pb-48 overflow-y-auto no-scrollbar\" data-kid=\"2\">\n    \n    \n    <header id=\"hero-header\" class=\"section-reveal mt-2\" data-kid=\"3\">\n      <h1 class=\"font-jakarta text-[46px] leading-[1.05] font-extrabold tracking-tighter\" data-kid=\"4\">\n        Ready for the <br data-kid=\"5\">\n        <span class=\"text-white/30\" data-kid=\"6\">next game,</span> <br data-kid=\"7\">\n        Stepan?\n      </h1>\n    </header>\n\n    \n    <section id=\"wallet-section\" class=\"section-reveal\" data-kid=\"8\">\n      <div class=\"bg-[var(--card-teal)] rounded-[32px] p-7 shadow-2xl relative group\" data-kid=\"9\">\n        \n        <div class=\"absolute -top-6 -right-6 w-32 h-32 bg-[var(--neon-fern)]/15 blur-[40px] rounded-full group-hover:bg-[var(--neon-fern)]/25 transition-all duration-700 pointer-events-none\" data-kid=\"10\"></div>\n        \n        <div class=\"flex justify-between items-start mb-2\" data-kid=\"11\">\n          <p class=\"text-white/50 text-xs font-bold uppercase tracking-widest\" data-kid=\"12\">Available Balance</p>\n          <i class=\"bi bi-shield-check text-[var(--neon-fern)] text-lg\" data-kid=\"13\"></i>\n        </div>\n        \n        <div class=\"flex items-baseline gap-2 mb-8\" data-kid=\"14\">\n          <span class=\"text-5xl font-jakarta font-extrabold tracking-tighter\" data-kid=\"15\">4 250</span>\n          <span class=\"text-2xl font-jakarta font-bold text-white/40\" data-kid=\"16\">₽</span>\n        </div>\n        \n        <div class=\"flex gap-4\" data-kid=\"17\">\n          <button class=\"flex-1 glass-btn py-4 rounded-2xl font-bold text-sm flex items-center justify-center gap-2 hover:bg-white/15 active:scale-95 transition-all\" data-kid=\"18\">\n            <i class=\"bi bi-plus-circle-fill text-[var(--neon-fern)]\" data-kid=\"19\"></i>\n            Top up\n          </button>\n          <button class=\"flex-1 glass-btn py-4 rounded-2xl font-bold text-sm flex items-center justify-center gap-2 hover:bg-white/15 active:scale-95 transition-all\" data-kid=\"20\">\n            <i class=\"bi bi-send-fill text-white/40\" data-kid=\"21\"></i>\n            Transfer\n          </button>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"stories-section\" class=\"section-reveal\" data-kid=\"22\">\n      <div class=\"flex justify-between items-center mb-5 px-1\" data-kid=\"23\">\n        <h3 class=\"text-white/40 text-[11px] font-bold uppercase tracking-[0.15em]\" data-kid=\"24\">Live from the club</h3>\n        <span class=\"text-[var(--neon-fern)] text-xs font-bold hover:underline cursor-pointer\" data-kid=\"25\">Watch All</span>\n      </div>\n      \n      <div class=\"relative h-[210px] -mx-6 px-6 overflow-hidden select-none\" data-kid=\"26\">\n        \n        <div class=\"polaroid left-[2%] rotate-[-8deg] z-10\" style=\"top: 20px;\" data-kid=\"27\">\n          <img src=\"https://images.unsplash.com/photo-1564769353575-73f33a36d84f?auto=format&w=300&q=80&fit=crop\" loading=\"lazy\" decoding=\"async\" data-kid=\"28\">\n        </div>\n        \n        <div class=\"polaroid left-[28%] rotate-[4deg] z-40\" style=\"top: 10px;\" data-kid=\"29\">\n          <img src=\"https://images.unsplash.com/photo-1564769353575-73f33a36d84f?auto=format&w=300&q=80&fit=crop&q=80&flip=h\" loading=\"lazy\" decoding=\"async\" data-kid=\"30\">\n        </div>\n        \n        <div class=\"polaroid left-[54%] rotate-[-3deg] z-20\" style=\"top: 25px;\" data-kid=\"31\">\n          <img src=\"https://images.unsplash.com/photo-1564769353575-73f33a36d84f?auto=format&w=300&q=80&fit=crop&sepia=50\" loading=\"lazy\" decoding=\"async\" data-kid=\"32\">\n        </div>\n        \n        <div class=\"polaroid left-[80%] rotate-[10deg] z-10\" style=\"top: 15px;\" data-kid=\"33\">\n          <img src=\"https://images.unsplash.com/photo-1564769353575-73f33a36d84f?auto=format&w=300&q=80&fit=crop\" loading=\"lazy\" decoding=\"async\" data-kid=\"34\">\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"timer-section\" class=\"section-reveal\" data-kid=\"35\">\n      <div class=\"neon-glow-card bg-[var(--card-teal)]/40 backdrop-blur-2xl rounded-[32px] p-6 flex flex-col gap-6\" data-kid=\"36\">\n        <div class=\"flex justify-between items-center\" data-kid=\"37\">\n          <div class=\"flex items-center gap-2\" data-kid=\"38\">\n            <span class=\"w-2 h-2 rounded-full bg-[var(--neon-fern)] animate-pulse shadow-[0_0_8px_var(--neon-fern)]\" data-kid=\"39\"></span>\n            <span class=\"text-[11px] font-bold text-[var(--neon-fern)] uppercase tracking-wider\" data-kid=\"40\">Next Match</span>\n          </div>\n          <span class=\"text-[9px] text-white/30 font-bold bg-white/5 px-2.5 py-1 rounded-lg\" data-kid=\"41\">Court #4 · 19:30</span>\n        </div>\n\n        <div class=\"flex items-center gap-3\" data-kid=\"42\">\n          <div class=\"flex-1 flex justify-center items-center gap-3\" data-kid=\"43\">\n            <div class=\"flex flex-col items-center\" data-kid=\"44\">\n              <span class=\"text-[38px] font-jakarta font-extrabold leading-none\" data-kid=\"45\">02</span>\n              <span class=\"text-[10px] text-white/30 font-bold uppercase mt-1 tracking-[0.1em]\" data-kid=\"46\">Hours</span>\n            </div>\n            <span class=\"text-3xl font-jakarta font-bold text-[var(--neon-fern)]/30 neon-glow-text mb-3\" data-kid=\"47\">:</span>\n            <div class=\"flex flex-col items-center\" data-kid=\"48\">\n              <span class=\"text-[38px] font-jakarta font-extrabold leading-none\" data-kid=\"49\">45</span>\n              <span class=\"text-[10px] text-white/30 font-bold uppercase mt-1 tracking-[0.1em]\" data-kid=\"50\">Minutes</span>\n            </div>\n          </div>\n          \n          <div class=\"h-10 w-[1px] bg-white/10\" data-kid=\"51\"></div>\n          \n          <div class=\"flex -space-x-3 items-center\" data-kid=\"52\">\n            <img src=\"https://i.pravatar.cc/100?u=stepan\" class=\"w-10 h-10 rounded-full border-2 border-[var(--card-teal)] ring-1 ring-white/5\" alt=\"Stepan\" decoding=\"async\" loading=\"lazy\" data-kid=\"53\">\n            <img src=\"https://i.pravatar.cc/100?u=opponent\" class=\"w-10 h-10 rounded-full border-2 border-[var(--card-teal)] ring-1 ring-white/5\" alt=\"Opponent\" decoding=\"async\" loading=\"lazy\" data-kid=\"54\">\n          </div>\n        </div>\n\n        <button class=\"w-full bg-white/10 py-3.5 rounded-2xl text-[11px] font-bold text-white/80 hover:bg-white/20 transition-all flex items-center justify-center gap-2\" data-kid=\"55\">\n          View match details <i class=\"bi bi-arrow-right text-[var(--neon-fern)]\" data-kid=\"56\"></i>\n        </button>\n      </div>\n    </section>\n\n  </main>\n\n  \n  <div class=\"fab-group\" data-kid=\"57\">\n    <div id=\"sd-container\" class=\"flex flex-col items-center mb-4 gap-3\" data-kid=\"58\">\n      <div id=\"sd-3\" class=\"speed-dial-option relative\" data-kid=\"59\">\n        <span class=\"speed-dial-label\" data-kid=\"60\">Passes</span>\n        <i class=\"bi bi-ticket-perforated\" data-kid=\"61\"></i>\n      </div>\n      <div id=\"sd-2\" class=\"speed-dial-option relative\" data-kid=\"62\">\n        <span class=\"speed-dial-label\" data-kid=\"63\">Partner</span>\n        <i class=\"bi bi-people\" data-kid=\"64\"></i>\n      </div>\n      <div id=\"sd-1\" class=\"speed-dial-option relative\" data-kid=\"65\">\n        <span class=\"speed-dial-label\" data-kid=\"66\">Booking</span>\n        <i class=\"bi bi-calendar-check\" data-kid=\"67\"></i>\n      </div>\n    </div>\n    <div id=\"fab-trigger\" class=\"fab-main\" data-kid=\"68\">\n      <i class=\"bi bi-plus-lg\" data-kid=\"69\"></i>\n    </div>\n  </div>\n\n  \n  <nav class=\"nav-island\" data-kid=\"70\">\n    <div class=\"flex gap-10\" data-kid=\"71\">\n      <div class=\"nav-item active\" data-kid=\"72\"><i class=\"bi bi-house-door-fill\" data-kid=\"73\"></i></div>\n      <div class=\"nav-item\" data-kid=\"74\"><i class=\"bi bi-calendar4-week\" data-kid=\"75\"></i></div>\n    </div>\n    <div class=\"flex gap-10\" data-kid=\"76\">\n      <div class=\"nav-item\" data-kid=\"77\"><i class=\"bi bi-bar-chart-fill\" data-kid=\"78\"></i></div>\n      <div class=\"nav-item\" data-kid=\"79\"><i class=\"bi bi-person-fill\" data-kid=\"80\"></i></div>\n    </div>\n  </nav>\n\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"81\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"82\"></script>\n<script type=\"module\" data-kid=\"83\">\n  import { animate, spring } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  gsap.registerPlugin(ScrollTrigger);\n\n  // #gsap-fade-up entrance reveals\n  gsap.from(\".section-reveal\", {\n    y: 30,\n    opacity: 0,\n    duration: 0.8,\n    stagger: 0.15,\n    ease: \"power4.out\",\n    clearProps: \"all\"\n  });\n\n  // Polaroid scatter animation\n  gsap.from(\".polaroid\", {\n    scale: 0.8,\n    opacity: 0,\n    y: 40,\n    rotation: 0,\n    duration: 1.2,\n    stagger: 0.1,\n    ease: \"back.out(1.7)\"\n  });\n\n  // FAB Interaction logic\n  const fabTrigger = document.getElementById('fab-trigger');\n  const options = [\n    document.getElementById('sd-1'),\n    document.getElementById('sd-2'),\n    document.getElementById('sd-3')\n  ];\n  let isOpen = false;\n\n  fabTrigger.addEventListener('click', () => {\n    isOpen = !isOpen;\n    fabTrigger.classList.toggle('active', isOpen);\n    \n    options.forEach((opt, index) => {\n      if (isOpen) {\n        gsap.set(opt, { visibility: 'visible' });\n        animate(opt, \n          { y: [20, 0], opacity: [0, 1], scale: [0.5, 1] }, \n          { delay: index * 0.04, type: \"spring\", stiffness: 400, damping: 18 }\n        );\n      } else {\n        animate(opt, \n          { y: 20, opacity: 0, scale: 0.5 }, \n          { delay: (options.length - 1 - index) * 0.03, duration: 0.15 }\n        ).finished.then(() => {\n          if (!isOpen) gsap.set(opt, { visibility: 'hidden' });\n        });\n      }\n    });\n  });\n\n  // Subtle pulse for neon elements\n  gsap.to(\".neon-glow-text\", {\n    opacity: 0.8,\n    duration: 1.5,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n</script>\n",
