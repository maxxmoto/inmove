    "var_ec434f1cd55a": {
      "type": "variant",
      "label": "Home - Crimson Editorial",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 13860,
        "y": 0,
        "w": 1440,
        "h": 800
