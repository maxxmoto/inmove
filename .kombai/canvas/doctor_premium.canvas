      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n    @import url('https://fonts.googleapis.com/css2?family=SF+Pro+Display:wght@400;500;600;700;800&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n    @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n    body {\n        font-family: 'Inter', sans-serif;\n        background-color: #FFFFFF;\n        color: #0F172A;\n        -webkit-font-smoothing: antialiased;\n        background-image: radial-gradient(#0066FF08 1px, transparent 1px);\n        background-size: 32px 32px;\n    }\n\n    .font-heading {\n        font-family: 'SF Pro Display', sans-serif;\n    }\n\n    /* Custom Glassmorphism */\n    .glass {\n        background: rgba(255, 255, 255, 0.7);\n        backdrop-filter: blur(12px);\n        -webkit-backdrop-filter: blur(12px);\n        border: 1px solid rgba(15, 23, 42, 0.05);\n    }\n\n    /* Comparison Bar Logic - Initial State for GSAP */\n    .bar-fill {\n        width: 0%;\n    }\n\n    /* Smooth Scroll Fix */\n    html {\n        scroll-behavior: initial;\n    }\n</style>\n\n<div class=\"relative w-full overflow-x-clip bg-white\" data-kid=\"1\">\n    \n    <nav class=\"fixed top-0 left-0 right-0 z-50 glass border-b border-black/[0.05]\" data-kid=\"2\">\n        <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"3\">\n            <div class=\"flex items-center gap-3\" data-kid=\"4\">\n                <div class=\"w-10 h-10 bg-[#0066FF] rounded-xl flex items-center justify-center shadow-lg shadow-blue-200\" data-kid=\"5\">\n                    <i class=\"ti ti-activity-heartbeat text-white text-2xl\" data-kid=\"6\"></i>\n                </div>\n                <span class=\"text-xl font-bold font-heading tracking-tight\" data-kid=\"7\">Gastro<span class=\"text-[#0066FF]\" data-kid=\"8\">Care</span></span>\n            </div>\n            <div class=\"hidden md:flex items-center gap-8 text-sm font-medium\" data-kid=\"9\">\n                <a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"10\">Специалисты</a>\n                <a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"11\">Услуги</a>\n                <a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"12\">Как это работает</a>\n                <a href=\"#\" class=\"hover:text-[#0066FF] transition-colors\" data-kid=\"13\">Отзывы</a>\n            </div>\n            <button class=\"px-6 py-2.5 bg-[#0066FF] text-white rounded-full text-sm font-semibold hover:bg-blue-700 transition-all shadow-md\" data-kid=\"14\">\n                Записаться\n            </button>\n        </div>\n    </nav>\n\n    \n    <section class=\"relative pt-20 overflow-hidden\" data-kid=\"15\">\n        <div class=\"w-full h-[75vh] relative\" data-kid=\"16\">\n            <video src=\"https://videos.pexels.com/video-files/7195682/7195682-hd_1366_720_25fps.mp4\" poster=\"https://images.pexels.com/videos/7195682/adult-advice-aid-business-7195682.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover\" data-kid=\"17\">\n            </video>\n            <div class=\"absolute inset-0 bg-gradient-to-r from-white via-white/40 to-transparent\" data-kid=\"18\"></div>\n            \n            <div class=\"absolute inset-0 max-w-7xl mx-auto px-6 flex items-center\" data-kid=\"19\">\n                <div class=\"max-w-2xl animate-reveal\" data-kid=\"20\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0066FF] text-white text-[10px] font-bold uppercase tracking-[0.2em] mb-8\" data-kid=\"21\">\n                        Медицина будущего\n                    </div>\n                    <h1 class=\"text-5xl md:text-8xl font-black font-heading leading-[0.95] mb-8 text-[#0F172A]\" data-kid=\"22\">\n                        Онлайн <br data-kid=\"23\">\n                        <span class=\"text-[#0066FF]\" data-kid=\"24\">гастроэнтерология</span>\n                    </h1>\n                    <div class=\"h-1 w-24 bg-[#0066FF] mb-8\" data-kid=\"25\"></div>\n                    <p class=\"text-lg md:text-xl text-[#0F172A] leading-relaxed mb-10 font-medium\" data-kid=\"26\">\n                        Экспертная забота о вашем здоровье без границ. Мы переосмыслили дистанционную диагностику, сделав ее точной, доступной и по-настоящему человечной.\n                    </p>\n                    <div class=\"flex flex-wrap gap-4\" data-kid=\"27\">\n                        <button class=\"px-10 py-5 bg-[#0066FF] text-white rounded-xl font-bold shadow-xl shadow-blue-400/30 hover:bg-blue-700 transition-colors\" data-kid=\"28\">\n                            Записаться на прием\n                        </button>\n                        <button class=\"px-10 py-5 bg-white text-[#0F172A] rounded-xl font-bold border border-black/10 hover:border-black/30 transition-colors\" data-kid=\"29\">\n                            О методе лечения\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"bg-[#F4F7FA] border-y border-black/[0.05]\" data-kid=\"30\">\n            <div class=\"max-w-7xl mx-auto px-6 py-10 grid grid-cols-2 md:grid-cols-4 gap-8\" data-kid=\"31\">\n                <div class=\"flex items-center gap-4 group\" data-kid=\"32\">\n                    <div class=\"text-4xl font-black font-heading text-[#0066FF] group-hover:scale-110 transition-transform\" data-kid=\"33\">15</div>\n                    <div class=\"text-[10px] font-bold text-[#0F172A]/60 uppercase leading-tight tracking-wider\" data-kid=\"34\">Минут <br data-kid=\"35\">до связи</div>\n                </div>\n                <div class=\"flex items-center gap-4 group\" data-kid=\"36\">\n                    <div class=\"text-4xl font-black font-heading text-[#0066FF] group-hover:scale-110 transition-transform\" data-kid=\"37\">24/7</div>\n                    <div class=\"text-[10px] font-bold text-[#0F172A]/60 uppercase leading-tight tracking-wider\" data-kid=\"38\">Поддержка <br data-kid=\"39\">пациентов</div>\n                </div>\n                <div class=\"flex items-center gap-4 group\" data-kid=\"40\">\n                    <div class=\"text-4xl font-black font-heading text-[#0066FF] group-hover:scale-110 transition-transform\" data-kid=\"41\">10+</div>\n                    <div class=\"text-[10px] font-bold text-[#0F172A]/60 uppercase leading-tight tracking-wider\" data-kid=\"42\">Лет стажа <br data-kid=\"43\">врачей</div>\n                </div>\n                <div class=\"flex items-center gap-4 group\" data-kid=\"44\">\n                    <div class=\"text-4xl font-black font-heading text-[#0066FF] group-hover:scale-110 transition-transform\" data-kid=\"45\">100%</div>\n                    <div class=\"text-[10px] font-bold text-[#0F172A]/60 uppercase leading-tight tracking-wider\" data-kid=\"46\">Безопасно <br data-kid=\"47\">и анонимно</div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-32 bg-white\" data-kid=\"48\">\n        <div class=\"max-w-5xl mx-auto px-6\" data-kid=\"49\">\n            <div class=\"flex items-center gap-6 mb-20\" data-kid=\"50\">\n                <h2 class=\"text-3xl md:text-5xl font-black font-heading text-[#0F172A]\" data-kid=\"51\">Услуги и стоимость</h2>\n                <div class=\"h-px flex-1 bg-black/5\" data-kid=\"52\"></div>\n                <div class=\"text-sm font-bold text-[#0066FF] uppercase tracking-widest\" data-kid=\"53\">Тарифы 2026</div>\n            </div>\n\n            <div class=\"space-y-8\" data-kid=\"54\">\n                \n                <div class=\"service-item bg-[#F4F7FA] p-8 rounded-3xl border border-black/[0.03] hover:border-[#0066FF]/20 transition-all duration-300 hover:shadow-xl hover:shadow-[#0066FF]/5 group relative overflow-hidden\" data-kid=\"55\">\n                    <div class=\"absolute top-0 right-0 px-4 py-1 bg-[#0066FF] text-white text-[10px] font-bold uppercase tracking-widest rounded-bl-xl opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"56\">Популярно</div>\n                    <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-6 mb-6\" data-kid=\"57\">\n                        <div class=\"flex items-center gap-5\" data-kid=\"58\">\n                            <div class=\"w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-sm\" data-kid=\"59\">\n                                <i class=\"ti ti-device-laptop text-xl text-[#0066FF]\" data-kid=\"60\"></i>\n                            </div>\n                            <div data-kid=\"61\">\n                                <h3 class=\"text-xl font-bold\" data-kid=\"62\">Онлайн-консультация</h3>\n                                <p class=\"text-sm text-[#0F172A]/50 italic\" data-kid=\"63\">До 45 минут видеосвязи</p>\n                            </div>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"64\">\n                            <span class=\"text-3xl font-black font-heading text-[#0F172A]\" data-kid=\"65\">2000 ₽</span>\n                        </div>\n                    </div>\n                    <div class=\"relative h-2.5 w-full bg-gray-200 rounded-full overflow-hidden\" data-kid=\"66\">\n                        <div class=\"absolute left-0 top-0 h-full bg-[#0066FF] bar-fill rounded-full\" data-width=\"40\" data-kid=\"67\"></div>\n                    </div>\n                </div>\n\n                \n                <div class=\"service-item bg-[#F4F7FA] p-8 rounded-3xl border border-black/[0.03] hover:border-[#0066FF]/20 hover:shadow-lg group\" data-kid=\"68\">\n                    <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-6 mb-6\" data-kid=\"69\">\n                        <div class=\"flex items-center gap-5\" data-kid=\"70\">\n                            <div class=\"w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-sm\" data-kid=\"71\">\n                                <i class=\"ti ti-history text-xl text-[#0066FF]\" data-kid=\"72\"></i>\n                            </div>\n                            <div data-kid=\"73\">\n                                <h3 class=\"text-xl font-bold\" data-kid=\"74\">Повторная консультация</h3>\n                                <p class=\"text-sm text-[#0F172A]/50 italic\" data-kid=\"75\">Контроль лечения</p>\n                            </div>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"76\">\n                            <span class=\"text-3xl font-black font-heading text-[#0F172A]\" data-kid=\"77\">1500 ₽</span>\n                        </div>\n                    </div>\n                    <div class=\"relative h-2.5 w-full bg-gray-200 rounded-full overflow-hidden\" data-kid=\"78\">\n                        <div class=\"absolute left-0 top-0 h-full bg-[#0066FF] bar-fill rounded-full opacity-60\" data-width=\"30\" data-kid=\"79\"></div>\n                    </div>\n                </div>\n\n                \n                <div class=\"service-item bg-[#F4F7FA] p-8 rounded-3xl border border-black/[0.03] hover:border-[#0066FF]/20 hover:shadow-lg group\" data-kid=\"80\">\n                    <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-6 mb-6\" data-kid=\"81\">\n                        <div class=\"flex items-center gap-5\" data-kid=\"82\">\n                            <div class=\"w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-sm\" data-kid=\"83\">\n                                <i class=\"ti ti-file-search text-xl text-[#0066FF]\" data-kid=\"84\"></i>\n                            </div>\n                            <div data-kid=\"85\">\n                                <h3 class=\"text-xl font-bold\" data-kid=\"86\">Расшифровка анализов</h3>\n                                <p class=\"text-sm text-[#0F172A]/50 italic\" data-kid=\"87\">Письменное заключение</p>\n                            </div>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"88\">\n                            <span class=\"text-3xl font-black font-heading text-[#0F172A]\" data-kid=\"89\">1000 ₽</span>\n                        </div>\n                    </div>\n                    <div class=\"relative h-2.5 w-full bg-gray-200 rounded-full overflow-hidden\" data-kid=\"90\">\n                        <div class=\"absolute left-0 top-0 h-full bg-[#0066FF] bar-fill rounded-full opacity-40\" data-width=\"20\" data-kid=\"91\"></div>\n                    </div>\n                </div>\n\n                \n                <div class=\"service-item bg-[#0066FF] p-8 rounded-3xl shadow-2xl shadow-blue-500/20 group\" data-kid=\"92\">\n                    <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-6 mb-6\" data-kid=\"93\">\n                        <div class=\"flex items-center gap-5\" data-kid=\"94\">\n                            <div class=\"w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-md\" data-kid=\"95\">\n                                <i class=\"ti ti-shield-check text-xl text-white\" data-kid=\"96\"></i>\n                            </div>\n                            <div data-kid=\"97\">\n                                <h3 class=\"text-xl font-bold text-white\" data-kid=\"98\">Онлайн сопровождение</h3>\n                                <p class=\"text-sm text-white/70 italic\" data-kid=\"99\">Месяц персональной поддержки</p>\n                            </div>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"100\">\n                            <span class=\"text-3xl font-black font-heading text-white\" data-kid=\"101\">5000 ₽</span>\n                        </div>\n                    </div>\n                    <div class=\"relative h-2.5 w-full bg-white/20 rounded-full overflow-hidden\" data-kid=\"102\">\n                        <div class=\"absolute left-0 top-0 h-full bg-white bar-fill rounded-full\" data-width=\"100\" data-kid=\"103\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-32 bg-[#F4F7FA]\" data-kid=\"104\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"105\">\n            <div class=\"flex flex-col md:flex-row items-center gap-12 mb-20\" data-kid=\"106\">\n                <div class=\"flex-1\" data-kid=\"107\">\n                    <h2 class=\"text-3xl md:text-5xl font-black font-heading text-[#0F172A]\" data-kid=\"108\">Путь к здоровью</h2>\n                </div>\n                <div class=\"max-w-md\" data-kid=\"109\">\n                    <p class=\"text-[#0F172A]/60 italic border-l-4 border-[#0066FF] pl-6 py-2\" data-kid=\"110\">\n                        Мы оптимизировали каждый этап, чтобы вы могли сосредоточиться на выздоровлении, а не на бюрократии.\n                    </p>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 lg:grid-cols-4 gap-8 relative\" data-kid=\"111\">\n                \n                <div class=\"hidden lg:block absolute top-[44px] left-20 right-20 h-0.5 bg-black/[0.05]\" data-kid=\"112\">\n                    <div class=\"h-full bg-[#0066FF] w-0\" id=\"flow-progress\" data-kid=\"113\"></div>\n                </div>\n\n                \n                <div class=\"bento-step relative group\" data-kid=\"114\">\n                    <div class=\"w-20 h-20 rounded-3xl bg-white shadow-xl flex items-center justify-center mb-10 relative z-10 border border-black/5\" data-kid=\"115\">\n                        <i class=\"ti ti-message-dots text-[#0066FF] text-3xl\" data-kid=\"116\"></i>\n                    </div>\n                    <div class=\"mb-4 flex items-center gap-3\" data-kid=\"117\">\n                        <span class=\"text-sm font-black text-[#0066FF]\" data-kid=\"118\">01</span>\n                        <h3 class=\"text-2xl font-bold font-heading\" data-kid=\"119\">Заявка</h3>\n                    </div>\n                    <p class=\"text-[#0F172A]/60 text-sm leading-relaxed\" data-kid=\"120\">\n                        Оставьте короткий запрос на сайте. Наш менеджер свяжется с вами для подбора удобного времени приема.\n                    </p>\n                </div>\n\n                \n                <div class=\"bento-step relative group\" data-kid=\"121\">\n                    <div class=\"w-20 h-20 rounded-3xl bg-white shadow-xl flex items-center justify-center mb-10 relative z-10 border border-black/5\" data-kid=\"122\">\n                        <i class=\"ti ti-cloud-upload text-[#0066FF] text-3xl\" data-kid=\"123\"></i>\n                    </div>\n                    <div class=\"mb-4 flex items-center gap-3\" data-kid=\"124\">\n                        <span class=\"text-sm font-black text-[#0066FF]\" data-kid=\"125\">02</span>\n                        <h3 class=\"text-2xl font-bold font-heading\" data-kid=\"126\">Документы</h3>\n                    </div>\n                    <p class=\"text-[#0F172A]/60 text-sm leading-relaxed\" data-kid=\"127\">\n                        Загрузите результаты обследований в защищенный кабинет. Это позволит врачу подготовиться заранее.\n                    </p>\n                </div>\n\n                \n                <div class=\"bento-step relative group\" data-kid=\"128\">\n                    <div class=\"w-20 h-20 rounded-3xl bg-white shadow-xl flex items-center justify-center mb-10 relative z-10 border border-black/5\" data-kid=\"129\">\n                        <i class=\"ti ti-device-tv text-[#0066FF] text-3xl\" data-kid=\"130\"></i>\n                    </div>\n                    <div class=\"mb-4 flex items-center gap-3\" data-kid=\"131\">\n                        <span class=\"text-sm font-black text-[#0066FF]\" data-kid=\"132\">03</span>\n                        <h3 class=\"text-2xl font-bold font-heading\" data-kid=\"133\">Прием</h3>\n                    </div>\n                    <p class=\"text-[#0F172A]/60 text-sm leading-relaxed\" data-kid=\"134\">\n                        Полноценный видеосеанс с доктором. Разбор вашей истории, ответов на вопросы и постановка диагноза.\n                    </p>\n                </div>\n\n                \n                <div class=\"bento-step relative group\" data-kid=\"135\">\n                    <div class=\"w-20 h-20 rounded-3xl bg-[#0066FF] shadow-xl shadow-blue-500/20 flex items-center justify-center mb-10 relative z-10\" data-kid=\"136\">\n                        <i class=\"ti ti-target text-white text-3xl\" data-kid=\"137\"></i>\n                    </div>\n                    <div class=\"mb-4 flex items-center gap-3\" data-kid=\"138\">\n                        <span class=\"text-sm font-black text-[#0066FF]\" data-kid=\"139\">04</span>\n                        <h3 class=\"text-2xl font-bold font-heading\" data-kid=\"140\">Результат</h3>\n                    </div>\n                    <p class=\"text-[#0F172A]/60 text-sm leading-relaxed\" data-kid=\"141\">\n                        Получите подробное заключение, схему лечения и рекомендации по образу жизни в вашем личном кабинете.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <footer class=\"bg-[#0F172A] text-white py-16\" data-kid=\"142\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"143\">\n            <div class=\"grid grid-cols-1 md:grid-cols-4 gap-12 mb-16\" data-kid=\"144\">\n                <div class=\"col-span-1 md:col-span-2\" data-kid=\"145\">\n                    <div class=\"flex items-center gap-3 mb-8\" data-kid=\"146\">\n                        <div class=\"w-10 h-10 bg-[#0066FF] rounded-xl flex items-center justify-center\" data-kid=\"147\">\n                            <i class=\"ti ti-activity-heartbeat text-white text-2xl\" data-kid=\"148\"></i>\n                        </div>\n                        <span class=\"text-2xl font-bold font-heading tracking-tight\" data-kid=\"149\">GastroCare</span>\n                    </div>\n                    <p class=\"text-gray-400 max-w-sm leading-relaxed mb-8\" data-kid=\"150\">\n                        Ваше здоровье — наш приоритет. Современная медицина стала доступнее благодаря технологиям онлайн-консультирования.\n                    </p>\n                    <div class=\"flex gap-4\" data-kid=\"151\">\n                        <a href=\"#\" class=\"w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-[#0066FF] transition-all\" data-kid=\"152\"><i class=\"ti ti-brand-telegram text-xl\" data-kid=\"153\"></i></a>\n                        <a href=\"#\" class=\"w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-[#0066FF] transition-all\" data-kid=\"154\"><i class=\"ti ti-brand-youtube text-xl\" data-kid=\"155\"></i></a>\n                        <a href=\"#\" class=\"w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover:bg-[#0066FF] transition-all\" data-kid=\"156\"><i class=\"ti ti-brand-whatsapp text-xl\" data-kid=\"157\"></i></a>\n                    </div>\n                </div>\n                <div data-kid=\"158\">\n                    <h4 class=\"font-bold mb-6\" data-kid=\"159\">Пациентам</h4>\n                    <ul class=\"space-y-4 text-gray-400 text-sm\" data-kid=\"160\">\n                        <li data-kid=\"161\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"162\">Личный кабинет</a></li>\n                        <li data-kid=\"163\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"164\">Запись на прием</a></li>\n                        <li data-kid=\"165\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"166\">Частые вопросы</a></li>\n                        <li data-kid=\"167\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"168\">Подготовка к анализам</a></li>\n                    </ul>\n                </div>\n                <div data-kid=\"169\">\n                    <h4 class=\"font-bold mb-6\" data-kid=\"170\">Контакты</h4>\n                    <ul class=\"space-y-4 text-gray-400 text-sm\" data-kid=\"171\">\n                        <li class=\"flex items-center gap-3\" data-kid=\"172\"><i class=\"ti ti-phone text-[#0066FF]\" data-kid=\"173\"></i> 8 (800) 555-01-99</li>\n                        <li class=\"flex items-center gap-3\" data-kid=\"174\"><i class=\"ti ti-mail text-[#0066FF]\" data-kid=\"175\"></i> hello@gastrocare.ru</li>\n                        <li class=\"flex items-center gap-3\" data-kid=\"176\"><i class=\"ti ti-map-pin text-[#0066FF]\" data-kid=\"177\"></i> Москва, Пресненская наб. 12</li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-500 font-medium uppercase tracking-widest\" data-kid=\"178\">\n                <span data-kid=\"179\">© 2026 GASTROCARE ONLINE. ВСЕ ПРАВА ЗАЩИЩЕНЫ.</span>\n                <div class=\"flex gap-6\" data-kid=\"180\">\n                    <a href=\"#\" class=\"hover:text-white\" data-kid=\"181\">ПОЛИТИКА КОНФИДЕНЦИАЛЬНОСТИ</a>\n                    <a href=\"#\" class=\"hover:text-white\" data-kid=\"182\">ПУБЛИЧНАЯ ОФЕРТА</a>\n                </div>\n            </div>\n        </div>\n    </footer>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"183\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"184\"></script>\n<script type=\"module\" data-kid=\"185\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    // Initialize Lenis\n    const lenis = new Lenis()\n    function raf(time) {\n        lenis.raf(time)\n        requestAnimationFrame(raf)\n    }\n    requestAnimationFrame(raf)\n\n    // GSAP Animations\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Initial Hero Entrance\n    gsap.from(\".animate-reveal\", {\n        y: 60,\n        opacity: 0,\n        duration: 1.2,\n        ease: \"power4.out\",\n        stagger: 0.1\n    });\n\n    // Scroll Revelations\n    gsap.utils.toArray(\".service-item\").forEach((item, i) => {\n        const barFill = item.querySelector('.bar-fill');\n        const targetWidth = barFill ? barFill.getAttribute('data-width') : 0;\n\n        gsap.from(item, {\n            scrollTrigger: {\n                trigger: item,\n                start: \"top 85%\",\n            },\n            y: 30,\n            opacity: 0,\n            duration: 0.8,\n            delay: i * 0.1,\n            ease: \"power2.out\",\n            onComplete: () => {\n                if (barFill) {\n                    gsap.to(barFill, {\n                        width: targetWidth + \"%\",\n                        duration: 1.5,\n                        ease: \"expo.out\"\n                    });\n                }\n            }\n        });\n    });\n\n    gsap.utils.toArray(\".bento-step\").forEach((step, i) => {\n        gsap.from(step, {\n            scrollTrigger: {\n                trigger: step,\n                start: \"top 90%\",\n            },\n            y: 40,\n            opacity: 0,\n            duration: 1,\n            delay: i * 0.15,\n            ease: \"expo.out\"\n        });\n    });\n\n    // Flow line animation\n    gsap.to(\"#flow-progress\", {\n        scrollTrigger: {\n            trigger: \".bento-step\",\n            start: \"top center\",\n            end: \"bottom center\",\n            scrub: true\n        },\n        width: \"100%\"\n    });\n\n    // Navigation Background Change on Scroll\n    const nav = document.querySelector('nav');\n    window.addEventListener('scroll', () => {\n        if (window.scrollY > 100) {\n            nav.classList.add('shadow-lg');\n            nav.style.backgroundColor = 'rgba(255, 255, 255, 0.95)';\n        } else {\n            nav.classList.remove('shadow-lg');\n            nav.style.backgroundColor = 'rgba(255, 255, 255, 0.7)';\n        }\n    });\n\n</script>\n",
