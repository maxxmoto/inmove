      "html": "\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" data-kid=\"0\">\n<div class=\"flex flex-col min-h-screen bg-[#F8FAF9] font-['Inter'] text-gray-900 select-none overflow-x-clip\" data-kid=\"1\">\n  <style data-kid=\"2\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800&display=swap');\n    \n    .font-heading { font-family: 'Montserrat', sans-serif; }\n    \n    .glass-header {\n      background: rgba(255, 255, 255, 0.7);\n      backdrop-filter: blur(20px);\n      -webkit-backdrop-filter: blur(20px);\n      border-bottom: 1px solid rgba(0, 0, 0, 0.05);\n    }\n    \n    .glass-card {\n      background: rgba(255, 255, 255, 0.65);\n      backdrop-filter: blur(16px);\n      -webkit-backdrop-filter: blur(16px);\n      border: 1.5px solid rgba(255, 255, 255, 0.8);\n      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.03), inset 0 0 0 1px rgba(0, 0, 0, 0.02);\n    }\n\n    .glass-card::after {\n      content: '';\n      position: absolute;\n      inset: 0;\n      border-radius: inherit;\n      padding: 1px;\n      background: linear-gradient(135deg, rgba(255,255,255,0.4), rgba(255,255,255,0), rgba(255,255,255,0.2));\n      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n      mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);\n      -webkit-mask-composite: xor;\n      mask-composite: exclude;\n      pointer-events: none;\n    }\n    \n    .segmented-active {\n      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\n    }\n\n    .scrollbar-hide::-webkit-scrollbar {\n      display: none;\n    }\n    .scrollbar-hide {\n      -ms-overflow-style: none;\n      scrollbar-width: none;\n    }\n  </style>\n\n  \n  <header class=\"sticky top-0 z-50 glass-header px-6 pt-12 pb-4\" data-kid=\"3\">\n    <div class=\"flex items-center justify-between mb-4\" data-kid=\"4\">\n      <h1 class=\"text-2xl font-heading tracking-tight text-gray-900\" data-kid=\"5\">Записи</h1>\n      <button class=\"w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center\" data-kid=\"6\">\n        <i class=\"ti ti-dots text-gray-600 text-lg\" data-kid=\"7\"></i>\n      </button>\n    </div>\n    \n    \n    <div id=\"top-tab-segmented\" class=\"p-1 bg-black/5 rounded-xl flex items-center w-full\" data-kid=\"8\">\n      <button class=\"tab-btn flex-1 py-2 text-sm font-semibold rounded-lg transition-all segmented-active bg-white text-gray-900\" data-target=\"active\" data-kid=\"9\">Активные</button>\n      <button class=\"tab-btn flex-1 py-2 text-sm font-semibold rounded-lg transition-all text-gray-500\" data-target=\"past\" data-kid=\"10\">Прошедшие</button>\n    </div>\n  </header>\n\n  \n  <main class=\"flex-1 px-5 pt-6 pb-40 space-y-8\" data-kid=\"11\">\n    \n    \n    <section id=\"bookings-section\" class=\"content-section\" data-kid=\"12\">\n      <div class=\"flex items-center justify-between mb-4 px-1\" data-kid=\"13\">\n        <h2 class=\"text-lg font-bold text-gray-900\" data-kid=\"14\">Мои бронирования</h2>\n        <span class=\"text-xs font-semibold text-[#50C878] bg-[#50C878]/10 px-2 py-1 rounded-md\" data-kid=\"15\">2 записи</span>\n      </div>\n      \n      \n      <div id=\"expandable-accordion\" class=\"space-y-4\" data-kid=\"16\">\n        \n        <div class=\"accordion-item booking-card glass-card rounded-2xl overflow-hidden\" data-kid=\"17\">\n          <div class=\"accordion-header p-4 flex items-center justify-between cursor-pointer\" data-kid=\"18\">\n            <div class=\"flex items-center space-x-3\" data-kid=\"19\">\n              <div class=\"w-12 h-12 rounded-2xl bg-[#50C878]/10 flex items-center justify-center overflow-hidden\" data-kid=\"20\">\n                <img src=\"https://images.unsplash.com/photo-1557561371-160934834af4?auto=format&w=100&q=80&fit=crop\" alt=\"court\" class=\"w-full h-full object-cover opacity-80\" decoding=\"async\" loading=\"lazy\" data-kid=\"21\">\n              </div>\n              <div data-kid=\"22\">\n                <h3 class=\"font-bold text-gray-900 text-[15px]\" data-kid=\"23\">Тарханово, Корт 1</h3>\n                <p class=\"text-xs text-gray-500 font-medium\" data-kid=\"24\">Завтра, 18:00 • 1.5 часа</p>\n              </div>\n            </div>\n            <div class=\"flex flex-col items-end space-y-1\" data-kid=\"25\">\n              <span class=\"px-2 py-0.5 rounded-full bg-[#50C878]/15 text-[#50C878] text-[9px] font-bold uppercase tracking-wider\" data-kid=\"26\">Оплачено</span>\n              <i class=\"ti ti-chevron-down text-gray-300 accordion-chevron\" data-kid=\"27\"></i>\n            </div>\n          </div>\n          <div class=\"accordion-content hidden px-4 pb-4 space-y-4 pt-2 border-t border-black/[0.03]\" data-kid=\"28\">\n            <div class=\"grid grid-cols-2 gap-4\" data-kid=\"29\">\n              <div class=\"bg-gray-50/50 p-3 rounded-xl border border-black/[0.02]\" data-kid=\"30\">\n                <p class=\"text-[10px] text-gray-400 uppercase font-bold tracking-tighter mb-1\" data-kid=\"31\">Покрытие</p>\n                <p class=\"text-xs font-semibold text-gray-700\" data-kid=\"32\">Грунт (Clay)</p>\n              </div>\n              <div class=\"bg-gray-50/50 p-3 rounded-xl border border-black/[0.02]\" data-kid=\"33\">\n                <p class=\"text-[10px] text-gray-400 uppercase font-bold tracking-tighter mb-1\" data-kid=\"34\">Тренер</p>\n                <p class=\"text-xs font-semibold text-gray-700\" data-kid=\"35\">А. Смирнов</p>\n              </div>\n            </div>\n            <div class=\"flex space-x-2\" data-kid=\"36\">\n              <button class=\"flex-1 py-3 bg-gray-100 hover:bg-gray-200 text-gray-900 rounded-xl text-xs font-bold transition-colors\" data-kid=\"37\">Отменить</button>\n              <button class=\"flex-1 py-3 bg-[#50C878] text-white rounded-xl text-xs font-bold shadow-lg shadow-[#50C878]/20\"