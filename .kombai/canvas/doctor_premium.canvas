iv class=\"bg-white/25 w-16 h-16 rounded-[24px] flex items-center justify-center text-3xl group-hover:rotate-12 transition-transform duration-500 shadow-inner border border-white/20 backdrop-blur-md\" data-kid=\"75\">🎾</div>\n                    <div data-kid=\"76\">\n                        <h3 class=\"text-white font-black text-[22px] leading-[1.1] font-['Montserrat'] tracking-tight\" data-kid=\"77\">Забронировать корт</h3>\n                        <p class=\"text-white/80 text-[9px] mt-4 font-black uppercase tracking-[0.2em] opacity-80\" data-kid=\"78\">Online Booking</p>\n                    </div>\n                </div>\n                \n                <div class=\"col-span-1 row-span-1 bg-white border border-slate-100 rounded-[38px] p-6 flex flex-col justify-between shadow-[0_15px_35px_rgba(0,0,0,0.03)] hover:shadow-2xl hover:shadow-emerald-900/10 transition-all duration-300 cursor-pointer group active:scale-95\" data-kid=\"79\">\n                    <div class=\"text-[#50C878] bg-emerald-50/50 w-12 h-12 rounded-[20px] flex items-center justify-center border border-[#50C878]/10 group-hover:bg-[#50C878] group-hover:text-white transition-all duration-500 group-hover:shadow-[0_8px_20px_rgba(80,200,120,0.3)]\" data-kid=\"80\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" data-kid=\"81\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\" data-kid=\"82\"></path>\n                        </svg>\n                    </div>\n                    <h3 class=\"font-black text-slate-800 text-[13px] font-['Montserrat']\" data-kid=\"83\">Мои записи</h3>\n                </div>\n                \n                <div class=\"col-span-1 row-span-1 bg-white border border-slate-100 rounded-[34px] p-6 flex flex-col justify-between s