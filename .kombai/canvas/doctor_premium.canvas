      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700&display=swap');\n\n    :root {\n        --color-accent: #E44D2E;\n        --color-bg: #FFFAFA;\n        --color-secondary: #F5F5F5;\n        --font-main: 'Inter', sans-serif;\n    }\n\n    body {\n        font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', sans-serif;\n        background-color: #f1f1f1; /* Slightly darker to see the mobile container */\n        color: #1a1a1a;\n        margin: 0;\n        -webkit-font-smoothing: antialiased;\n    }\n\n    .no-scrollbar::-webkit-scrollbar {\n        display: none;\n    }\n    .no-scrollbar {\n        -ms-overflow-style: none;\n        scrollbar-width: none;\n    }\n\n    .photo-grid-item {\n        transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);\n    }\n\n    .photo-grid-item:hover {\n        transform: scale(1.01);\n    }\n\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,900&display=swap');\n    .font-serif-watermark {\n        font-family: 'Playfair Display', serif;\n    }\n\n    .nav-blur {\n        backdrop-filter: blur(10px);\n        background-color: rgba(255, 250, 250, 0.85);\n    }\n</style>\n\n<div class=\"max-w-[390px] mx-auto bg-[var(--color-bg)] relative min-h-screen shadow-2xl overflow-x-clip\" data-kid=\"1\">\n    \n    <header class=\"pt-16 px-6 pb-8 flex justify-between items-end animate-header\" data-kid=\"2\">\n        <h1 class=\"text-4xl font-light tracking-tighter text-black\" data-kid=\"3\">Степан</h1>\n        <div class=\"flex flex-col items-end\" data-kid=\"4\">\n            <span class=\"text-[9px] font-bold uppercase tracking-[0.25em] text-black/20 mb-1\" data-kid=\"5\">Баланс</span>\n            <span class=\"text-2xl font-light text-black tracking-tighter\" data-kid=\"6\">4 250 <span class=\"text-[var(--color-accent)] font-medium\" data-kid=\"7\">₽</span></span>\n        </div>\n    </header>\n\n    \n    <section class=\"w-full mb-10 animate-photo-wall\" data-kid=\"8\">\n        <div class=\"grid grid-cols-6 grid-rows-4 gap-1 h-[480px] w-full\" data-kid=\"9\">\n            \n            <div class=\"col-span-4 row-span-4 relative overflow-hidden group photo-grid-item\" data-kid=\"10\">\n                <img src=\"https://images.unsplash.com/photo-1593571647410-e71bea3f7d4b?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale-[15%] brightness-[0.85] transition-transform duration-700 group-hover:scale-110\" alt=\"Tennis Court\" decoding=\"async\" loading=\"lazy\" data-kid=\"11\">\n                <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent\" data-kid=\"12\"></div>\n                <div class=\"absolute bottom-8 left-8 text-white\" data-kid=\"13\">\n                    <span class=\"text-[10px] uppercase tracking-[0.3em] opacity-70 mb-2 block\" data-kid=\"14\">Club Life</span>\n                    <h2 class=\"text-3xl font-light tracking-tight\" data-kid=\"15\">Утренний сет на <br data-kid=\"16\">центральном корте</h2>\n                </div>\n            </div>\n            \n            <div class=\"col-span-2 row-span-2 relative overflow-hidden group photo-grid-item\" data-kid=\"17\">\n                <img src=\"https://images.unsplash.com/photo-1593571647410-e71bea3f7d4b?auto=format&w=600&q=80&fit=crop&crop=focalpoint\" class=\"w-full h-full object-cover grayscale-[30%] brightness-110 group-hover:scale-110 transition-transform duration-700\" alt=\"Detail\" decoding=\"async\" loading=\"lazy\" data-kid=\"18\">\n            </div>\n            <div class=\"col-span-2 row-span-2 relative overflow-hidden group photo-grid-item\" data-kid=\"19\">\n                <img src=\"https://images.unsplash.com/photo-1593571647410-e71bea3f7d4b?auto=format&w=600&q=80&fit=crop&crop=bottom\" class=\"w-full h-full object-cover grayscale-[50%] brightness-90 group-hover:scale-110 transition-transform duration-700\" alt=\"Detail\" decoding=\"async\" loading=\"lazy\" data-kid=\"20\">\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"px-6 mb-12 animate-pills\" data-kid=\"21\">\n        <div class=\"flex gap-3 overflow-x-auto no-scrollbar py-2\" data-kid=\"22\">\n            <button class=\"px-7 py-3 bg-[var(--color-accent)] text-white rounded-full text-sm font-medium whitespace-nowrap shadow-xl shadow-[#E44D2E]/20 active:scale-95 transition-transform\" data-kid=\"23\">\n                Забронировать\n            </button>\n            <button class=\"px-7 py-3 bg-[var(--color-secondary)] text-black/70 rounded-full text-sm font-medium whitespace-nowrap active:scale-95 transition-transform\" data-kid=\"24\">\n                Тренеры\n            </button>\n            <button class=\"px-7 py-3 bg-[var(--color-secondary)] text-black/70 rounded-full text-sm font-medium whitespace-nowrap active:scale-95 transition-transform\" data-kid=\"25\">\n                Турниры\n            </button>\n            <button class=\"px-7 py-3 bg-[var(--color-secondary)] text-black/70 rounded-full text-sm font-medium whitespace-nowrap active:scale-95 transition-transform\" data-kid=\"26\">\n                Инвентарь\n            </button>\n        </div>\n    </section>\n\n    \n    <section class=\"px-6 animate-booking\" data-kid=\"27\">\n        <div class=\"flex justify-between items-center mb-6\" data-kid=\"28\">\n            <h3 class=\"text-xs font-bold uppercase tracking-[0.2em] text-black/40\" data-kid=\"29\">Ваша следующая запись</h3>\n            <button class=\"text-xs font-medium text-[var(--color-accent)] hover:opacity-70\" data-kid=\"30\">Все записи</button>\n        </div>\n        \n        <div class=\"relative overflow-hidden rounded-[40px] bg-[var(--color-secondary)] p-7 min-h-[220px] flex flex-col justify-between group cursor-pointer\" data-kid=\"31\">\n            \n            <div class=\"absolute -left-4 -bottom-10 text-[260px] font-serif-watermark italic text-black/[0.03] leading-none select-none group-hover:text-black/[0.06] transition-colors duration-700 pointer-events-none\" data-kid=\"32\">\n                24\n            </div>\n            \n            <div class=\"relative z-10\" data-kid=\"33\">\n                <div class=\"flex items-center gap-2 mb-3\" data-kid=\"34\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] animate-pulse\" data-kid=\"35\"></span>\n                    <p class=\"text-[var(--color-accent)] font-semibold text-sm uppercase tracking-widest\" data-kid=\"36\">Завтра • 18:00</p>\n                </div>\n                <h4 class=\"text-3xl font-semibold text-black leading-tight\" data-kid=\"37\">Корт #4 <br data-kid=\"38\">Классическая глина</h4>\n            </div>\n            \n            <div class=\"relative z-10 flex items-center gap-6 mt-6\" data-kid=\"39\">\n                <div class=\"flex items-center gap-2 text-black/50 text-sm\" data-kid=\"40\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"41\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\" data-kid=\"42\"></path></svg>\n                    <span data-kid=\"43\">60 минут</span>\n                </div>\n                <div class=\"flex items-center gap-2 text-black/50 text-sm\" data-kid=\"44\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"45\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\" data-kid=\"46\"></path><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\" data-kid=\"47\"></path></svg>\n                    <span data-kid=\"48\">Северный сектор</span>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <div class=\"h-32\" data-kid=\"49\"></div>\n\n    \n    <nav class=\"absolute bottom-0 left-0 right-0 nav-blur px-8 py-5 pb-9 flex justify-between items-center z-50 animate-nav border-t border-black/[0.03]\" data-kid=\"50\">\n        <button class=\"flex flex-col items-center gap-1.5 text-[var(--color-accent)]\" data-kid=\"51\">\n            <div class=\"p-1\" data-kid=\"52\">\n                <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"53\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\" data-kid=\"54\"></path></svg>\n            </div>\n            <span class=\"text-[9px] font-bold uppercase tracking-wider\" data-kid=\"55\">Главная</span>\n        </button>\n        <button class=\"flex flex-col items-center gap-1.5 text-black/40 hover:text-black/60 transition-colors\" data-kid=\"56\">\n            <div class=\"p-1\" data-kid=\"57\">\n                <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\" data-kid=\"58\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\" data-kid=\"59\"></path></svg>\n            </div>\n            <span class=\"text-[9px] font-bold uppercase tracking-wider\" data-kid=\"60\">Корты</span>\n        </button>\n        <button class=\"flex flex-col items-center gap-1.5 text-black/40 hover:text-black/60 transition-colors\" data-kid=\"61\">\n            <div class=\"p-1\" data-kid=\"62\">\n                <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\" data-kid=\"63\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01\" data-kid=\"64\"></path></svg>\n            </div>\n            <span class=\"text-[9px] font-bold uppercase tracking-wider\" data-kid=\"65\">История</span>\n        </button>\n        <button class=\"flex flex-col items-center gap-1.5 text-black/40 hover:text-black/60 transition-colors\" data-kid=\"66\">\n            <div class=\"p-1\" data-kid=\"67\">\n                <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\" data-kid=\"68\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\" data-kid=\"69\"></path></svg>\n            </div>\n            <span class=\"text-[9px] font-bold uppercase tracking-wider\" data-kid=\"70\">Профиль</span>\n        </button>\n    </nav>\n</div>\n\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"71\">\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"72\"></script>\n<script type=\"module\" data-kid=\"73\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    import Snap from \"https://esm.sh/lenis@1/snap\"\n    \n    // Initialize Lenis for smooth scrolling\n    const lenis = new Lenis({\n        duration: 1.2,\n        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n        orientation: 'vertical',\n        gestureOrientation: 'vertical',\n        smoothWheel: true,\n        wheelMultiplier: 1,\n        smoothTouch: false,\n        touchMultiplier: 2,\n        infinite: false,\n    })\n\n    function raf(time) {\n        lenis.raf(time)\n        requestAnimationFrame(raf)\n    }\n\n    requestAnimationFrame(raf)\n\n    // GSAP Entrance Animations\n    gsap.from('.animate-header', {\n        y: -30,\n        opacity: 0,\n        duration: 1,\n        ease: 'power3.out'\n    });\n\n    gsap.from('.animate-photo-wall', {\n        y: 50,\n        opacity: 0,\n        duration: 1.2,\n        ease: 'power4.out',\n        delay: 0.2\n    });\n\n    gsap.from('.animate-pills', {\n        x: 50,\n        opacity: 0,\n        duration: 1,\n        ease: 'power3.out',\n        delay: 0.4\n    });\n\n    gsap.from('.animate-booking', {\n        y: 60,\n        opacity: 0,\n        duration: 1.2,\n        ease: 'power4.out',\n        delay: 0.6\n    });\n\n    gsap.from('.animate-nav', {\n        y: 100,\n        duration: 1.2,\n        ease: 'expo.out',\n        delay: 1\n    });\n\n</script>\n",
