   <div class=\"w-1.5 h-1.5 rounded-full bg-[#50C878] shadow-[0_0_10px_rgba(80,200,120,0.8)]\" data-kid=\"120\"></div>\n                </button>\n                \n                <button class=\"text-slate-400 opacity-60 hover:opacity-100 transition-all hover:scale-110 active:scale-90\" data-kid=\"121\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-7 w-7\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" data-kid=\"122\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\" data-kid=\"123\"></path>\n                    </svg>\n                </button>\n                \n                <button class=\"text-slate-400 opacity-60 hover:opacity-100 transition-all hover:scale-110 active:scale-90\" data-kid=\"124\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-7 w-7\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" data-kid=\"125\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z\" data-kid=\"126\"></path>\n                    </svg>\n                </button>\n                \n                <button class=\"text-slate-400 opacity-60 hover:opacity-100 transition-all hover:scale-110 active:scale-90\" data-kid=\"127\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-7 w-7\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" data-kid=\"128\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z\" data-kid=\"129\"></path>\n                    </svg>\n                </button>\n                \n                <button class=\"text-slate-400 opacity-60 hover:opacity-100 transition-