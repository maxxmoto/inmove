roup-hover:opacity-100 transition-opacity\" data-kid=\"106\">Главная</span>\n      </a>\n      <a href=\"#\" class=\"flex flex-col items-center space-y-1 text-gray-400 group\" data-kid=\"107\">\n        <div class=\"p-2 rounded-xl transition-all duration-300 group-hover:bg-gray-100\" data-kid=\"108\">\n          <i class=\"ti ti-calendar-plus text-xl\" data-kid=\"109\"></i>\n        </div>\n        <span class=\"text-[10px] font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"110\">Бронь</span>\n      </a>\n      <a href=\"#\" class=\"flex flex-col items-center space-y-1 text-[#50C878] group relative\" data-kid=\"111\">\n        <div class=\"p-2 bg-[#50C878]/10 rounded-xl\" data-kid=\"112\">\n          <i class=\"ti ti-history text-xl\" data-kid=\"113\"></i>\n        </div>\n        <span class=\"text-[10px] font-bold uppercase tracking-widest\" data-kid=\"114\">Записи</span>\n        <div class=\"absolute -top-1 -right-1 w-1.5 h-1.5 bg-[#50C878] rounded-full\" data-kid=\"115\"></div>\n      </a>\n      <a href=\"#\" class=\"flex flex-col items-center space-y-1 text-gray-400 group\" data-kid=\"116\">\n        <div class=\"p-2 rounded-xl transition-all duration-300 group-hover:bg-gray-100\" data-kid=\"117\">\n          <i class=\"ti ti-shopping-cart text-xl\" data-kid=\"118\"></i>\n        </div>\n        <span class=\"text-[10px] font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"119\">Магазин</span>\n      </a>\n      <a href=\"#\" class=\"flex flex-col items-center space-y-1 text-gray-400 group\" data-kid=\"120\">\n        <div class=\"p-2 rounded-xl transition-all duration-300 group-hover:bg-gray-100\" data-kid=\"121\">\n          <i class=\"ti ti-user text-xl\" data-kid=\"122\"></i>\n        </div>\n        <span class=\"text-[10px] font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"123\">Профиль</span>\n      </a>\n    </div>\n  </nav>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"124\"></script>\n  <script data-kid=\"125\">\n    document.addEventListener('DOMContentLoaded', () => {\n      // Accordion Logic\n      const accordionHeaders = document.querySelectorAll('.accordion-header');\n      \n      accordionHeaders.forEach(header => {\n        header.addEventListener('click', () => {\n          const content = header.nextElementSibling;\n          const chevron = header.querySelector('.accordion-chevron');\n          const isHidden = content.classList.contains('hidden');\n          \n          // Collapse all others (optional, let's keep it as multiple can be open or single)\n          /*\n          document.querySelectorAll('.accordion-content').forEach(c => {\n            if (c !== content) {\n              c.classList.add('hidden');\n              c.previousElementSibling.querySelector('.accordion-chevron').style.transform = 'rotate(0deg)';\n            }\n          });\n          */\n\n          if (isHidden) {\n            content.classList.remove('hidden');\n            gsap.fromTo(content, \n              { height: 0, opacity: 0, paddingBottom: 0 }, \n              { height: 'auto', opacity: 1, paddingBottom: 16, duration: 0.4, ease: 'power3.out' }\n            );\n            gsap.to(chevron, { rotate: 180, duration: 0.3 });\n          } else {\n            gsap.to(content, { \n              height: 0, \n              opacity: 0, \n              paddingBottom: 0, \n              duration: 0.3, \n              ease: 'power3.in',\n              onComplete: () => content.classList.add('hidden')\n            });\n            gsap.to(chevron, { rotate: 0, duration: 0.3 });\n          }\n        });\n      });\n\n      // Tab Switching\n      const tabBtns = document.querySelectorAll('.tab-btn');\n      tabBtns.forEach(btn => {\n        btn.addEventListener('click', () => {\n          tabBtns.forEach(b => {\n            b.classList.remove('segmented-active', 'bg-white', 'text-gray-900');\n            b.classList.add('text-gray-500');\n          });\n          btn.classList.add('segmented-active', 'bg-white', 'text-gray-900');\n          btn.classList.remove('text-gray-500');\n          \n          // Animate content change\n          gsap.fromTo('.content-section', { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.1 });\n        });\n      });\n\n      // Filter Chips\n      const filterChips = document.querySelectorAll('.filter-chip');\n      filterChips.forEach(chip => {\n        chip.addEventListener('click', () => {\n          filterChips.forEach(c => {\n            c.classList.remove('bg-[#50C878]', 'text-white', 'shadow-lg', 'shadow-[#50C878]/20');\n            c.classList.add('bg-[#F2F3F4]', 'text-gray-500');\n          });\n          chip.classList.add('bg-[#50C878]', 'text-white', 'shadow-lg', 'shadow-[#50C878]/20');\n          chip.classList.remove('bg-[#F2F3F4]', 'text-gray-500');\n        });\n      });\n\n      // Entry Animations\n      gsap.from('.booking-card', {\n        opacity: 0,\n        y: 30,\n        duration: 0.6,\n        stagger: 0.15,\n        ease: 'back.out(1.7)'\n      });\n      \n      gsap.from('.transaction-item', {\n        opacity: 0,\n        x: -20,\n        duration: 0.5,\n        stagger: 0.1,\n        delay: 0.4,\n        ease: 'power2.out'\n      });\n    });\n  </script>\n</div>\n",
