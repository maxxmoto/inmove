      "html": "\n<div class=\"min-h-screen bg-white text-gray-900 font-['Inter'] selection:bg-[#50C878]/30 overflow-x-clip relative\" data-kid=\"0\">\n    \n    \n    <div class=\"fixed top-[-10%] left-[-10%] w-[50%] h-[40%] bg-[#50C878]/5 rounded-full blur-[120px] -z-10\" data-kid=\"1\"></div>\n    <div class=\"fixed bottom-[-5%] right-[-5%] w-[40%] h-[30%] bg-[#50C878]/10 rounded-full blur-[100px] -z-10\" data-kid=\"2\"></div>\n\n    \n    <div class=\"h-14 w-full flex items-end justify-between px-8 pb-3 sticky top-0 z-50 bg-white/60 backdrop-blur-xl border-b border-black/[0.03]\" data-kid=\"3\">\n        <span class=\"text-sm font-bold tracking-tight\" data-kid=\"4\">9:41</span>\n        <div class=\"flex items-center space-x-2\" data-kid=\"5\">\n            <i class=\"fa-solid fa-signal text-[10px]\" data-kid=\"6\"></i>\n            <i class=\"fa-solid fa-wifi text-[10px]\" data-kid=\"7\"></i>\n            <div class=\"relative w-6 h-3 border border-gray-400 rounded-sm flex items-center px-0.5\" data-kid=\"8\">\n                <div class=\"w-full h-full bg-gray-900 rounded-sm\" data-kid=\"9\"></div>\n            </div>\n        </div>\n    </div>\n\n    \n    <section class=\"px-5 pt-6 pb-8\" data-kid=\"10\">\n        <div class=\"relative rounded-[40px] overflow-hidden border border-black/[0.04] bg-white/50 backdrop-blur-[24px] shadow-[0_12px_40px_rgba(0,0,0,0.03)] p-8 flex flex-col items-center\" data-kid=\"11\">\n            \n            <div class=\"absolute top-0 left-0 w-full h-full bg-gradient-to-br from-white/40 to-transparent pointer-events-none\" data-kid=\"12\"></div>\n            \n            <div class=\"relative mb-4 group\" data-kid=\"13\">\n                <div class=\"w-24 h-24 rounded-full border-[3px] border-white shadow-xl overflow-hidden ring-4 ring-[#50C878]/10 transition-transform duration-500 group-hover:scale-105\" data-kid=\"14\">\n                    <img src=\"https://i.pravatar.cc/150?u=stepan\" alt=\"Степан\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"15\">\n                </div>\n                <div class=\"absolute bottom-0 right-0 w-7 h-7 bg-[#50C878] border-2 border-white rounded-full flex items-center justify-center text-white text-[10px] shadow-sm\" data-kid=\"16\">\n                    <i class=\"fa-solid fa-camera\" data-kid=\"17\"></i>\n                </div>\n            </div>\n            \n            <h1 class=\"font-['Montserrat'] text-2xl font-black tracking-tight text-gray-900\" data-kid=\"18\">Степан</h1>\n            <p class=\"text-gray-400 font-semibold text-sm mt-1 tracking-wide\" data-kid=\"19\">+7 (900) 123-45-67</p>\n            \n            <div class=\"flex space-x-3 mt-8\" data-kid=\"20\">\n                <button class=\"px-8 py-3 bg-gray-900 text-white rounded-2xl text-xs font-bold shadow-xl shadow-black/10 active:scale-95 transition-all cursor-pointer\" data-kid=\"21\">\n                    Редактировать\n                </button>\n                <button class=\"w-12 h-12 flex items-center justify-center bg-white rounded-2xl border border-gray-100 shadow-sm text-gray-600 active:scale-95 transition-all cursor-pointer\" data-kid=\"22\">\n                    <i class=\"fa-solid fa-share-nodes text-sm\" data-kid=\"23\"></i>\n                </button>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"px-5 pb-10\" data-kid=\"24\">\n        <div class=\"grid grid-cols-3 gap-3\" data-kid=\"25\">\n            <div class=\"bg-[#F2F3F4]/60 backdrop-blur-sm rounded-[24px] p-5 border border-black/[0.01] flex flex-col items-center justify-center group hover:bg-white transition-all shadow-sm shadow-transparent hover:shadow-black/5 cursor-default\" data-kid=\"26\">\n                <span class=\"text-[9px] font-black text-gray-400 uppercase tracking-[0.15em] mb-2 group-hover:text-[#50C878] transition-colors\" data-kid=\"27\">Игры</span>\n                <span class=\"text-2xl font-['Montserrat'] font