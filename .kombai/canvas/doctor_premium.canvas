n      }, '-=0.4');\n\n    // Scroll reveal for sections\n    gsap.utils.toArray('section').forEach((section, i) => {\n        if(i === 0) return; // Skip hero\n        gsap.from(section, {\n            scrollTrigger: {\n                trigger: section,\n                start: 'top bottom-=100',\n                toggleActions: 'play none none none'\n            },\n            opacity: 0,\n            y: 30,\n            duration: 1,\n            ease: 'power3.out'\n        });\n    });\n});\n</script>\n",
