      },
      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');\n\n    body {\n        font-family: 'Inter', sans-serif;\n        background-color: #FDFBF7;\n        color: #4A4A4A;\n        margin: 0;\n        padding: 0;\n        overflow-x: clip;\n    }\n\n    .glass-nav {\n        background: rgba(253, 251, 247, 0.85);\n        backdrop-filter: blur(12px);\n        -webkit-backdrop-filter: blur(12px);\n        border: 1px solid rgba(74, 103, 65, 0.1);\n    }\n\n    .neomorph-raised {\n        background: #FDFBF7;\n        box-shadow: 12px 12px 24px rgba(0, 0, 0, 0.03), \n                    -12px -12px 24px rgba(255, 255, 255, 0.8);\n    }\n\n    .neomorph-inset {\n        background: #FDFBF7;\n        box-shadow: inset 6px 6px 12px rgba(0, 0, 0, 0.02), \n                    inset -6px -6px 12px rgba(255, 255, 255, 0.7);\n    }\n\n    .organic-blob {\n        border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;\n    }\n\n    /* Custom Scrollbar */\n    ::-webkit-scrollbar {\n        width: 8px;\n    }\n    ::-webkit-scrollbar-track {\n        background: #FDFBF7;\n    }\n    ::-webkit-scrollbar-thumb {\n        background: #4A6741;\n        border-radius: 10px;\n    }\n</style>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n\n<div class=\"smooth-scroll-container\" data-kid=\"2\">\n    \n    <header class=\"fixed top-8 left-1/2 -translate-x-1/2 z-[100] w-[90%] max-w-4xl\" data-kid=\"3\">\n        <nav class=\"glass-nav rounded-full px-6 py-3 flex items-center justify-between shadow-lg\" data-kid=\"4\">\n            <div class=\"flex items-center gap-4\" data-kid=\"5\">\n                <div class=\"w-10 h-10 bg-[#4A6741] rounded-2xl flex items-center justify-center rotate-6 shadow-md\" data-kid=\"6\">\n                    <span class=\"text-white font-black text-xl\" data-kid=\"7\">S</span>\n                </div>\n                <span class=\"font-black text-[#4A4A4A] tracking-tighter text-2xl\" data-kid=\"8\">Sage Wellness</span>\n            </div>\n            <div class=\"hidden lg:flex items-center gap-10 text-[10px] font-black uppercase tracking-[0.3em] text-[#4A4A4A]/60\" data-kid=\"9\">\n                <a href=\"#about\" class=\"hover:text-[#4A6741] transition-colors\" data-kid=\"10\">О враче</a>\n                <a href=\"#services\" class=\"hover:text-[#4A6741] transition-colors\" data-kid=\"11\">Услуги</a>\n                <a href=\"#reviews\" class=\"hover:text-[#4A6741] transition-colors\" data-kid=\"12\">Отзывы</a>\n            </div>\n            <a href=\"#booking\" class=\"bg-[#4A6741] text-white px-8 py-3 rounded-full text-xs font-black uppercase tracking-widest shadow-xl shadow-[#4A6741]/20 hover:bg-[#3d5535] transition-all\" data-kid=\"13\">\n                Записаться\n            </a>\n        </nav>\n    </header>\n\n    \n    <section class=\"min-h-screen relative flex items-center bg-[#FDFBF7] overflow-hidden\" data-kid=\"14\">\n        <div class=\"w-full flex flex-col lg:flex-row items-stretch min-h-screen\" data-kid=\"15\">\n            \n            <div class=\"lg:w-5/12 relative min-h-[60vh] lg:min-h-screen hero-image-container overflow-hidden\" data-kid=\"16\">\n                <img src=\"https://images.pexels.com/photos/7108258/pexels-photo-7108258.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\" alt=\"Doctor portrait\" class=\"absolute inset-0 w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"17\">\n                <div class=\"absolute inset-0 bg-gradient-to-r from-transparent to-[#FDFBF7]/20\" data-kid=\"18\"></div>\n            </div>\n\n            \n            <div class=\"lg:w-7/12 flex flex-col justify-center px-12 lg:px-32 py-32 relative hero-text\" data-kid=\"19\">\n                <div class=\"max-w-2xl\" data-kid=\"20\">\n                    <span class=\"block text-[#4A6741] font-black uppercase tracking-[0.5em] text-[10px] mb-12 opacity-60\" data-kid=\"21\">Sage Wellness Personal Clinic</span>\n                    <h1 class=\"text-7xl lg:text-[10rem] font-black text-[#4A4A4A] leading-[0.8] tracking-tighter mb-16\" data-kid=\"22\">\n                        Искусство <br data-kid=\"23\">\n                        <span class=\"text-[#4A6741] italic font-serif font-light\" data-kid=\"24\">здоровья</span>\n                    </h1>\n                    <div class=\"flex items-start gap-10 mb-20\" data-kid=\"25\">\n                        <div class=\"w-1.5 bg-[#4A6741] h-24 rounded-full opacity-20\" data-kid=\"26\"></div>\n                        <p class=\"text-3xl font-medium text-[#4A4A4A] leading-tight italic font-serif opacity-80\" data-kid=\"27\">\n                            «Ваше тело — это сад. Чтобы он процветал, за ним нужно ухаживать с терпением, знанием и любовью»\n                        </p>\n                    </div>\n                    <div class=\"flex flex-col sm:flex-row items-center gap-10\" data-kid=\"28\">\n                        <a href=\"#booking\" class=\"bg-[#4A6741] text-white px-14 py-7 rounded-2xl font-black text-sm uppercase tracking-widest shadow-3xl shadow-[#4A6741]/30 hover:scale-105 active:scale-95 transition-all\" data-kid=\"29\">\n                            Консультация\n                        </a>\n                        <a href=\"#services\" class=\"text-[#4A4A4A] font-black text-xs uppercase tracking-[0.3em] border-b-4 border-[#4A6741]/10 pb-2 hover:border-[#4A6741]/40 transition-all\" data-kid=\"30\">\n                            Наши направления\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"about\" class=\"py-48 bg-white relative overflow-hidden\" data-kid=\"31\">\n        <div class=\"container mx-auto px-8\" data-kid=\"32\">\n            <div class=\"flex flex-col lg:flex-row items-center gap-32\" data-kid=\"33\">\n                <div class=\"lg:w-5/12 relative about-image\" data-kid=\"34\">\n                    <div class=\"absolute -top-12 -left-12 w-96 h-96 bg-[#4A6741]/5 organic-blob blur-3xl\" data-kid=\"35\"></div>\n                    <div class=\"relative aspect-[4/5] rounded-[100px] overflow-hidden shadow-[0_50px_100px_rgba(0,0,0,0.1)] border-8 border-[#FDFBF7]\" data-kid=\"36\">\n                        <img src=\"https://images.unsplash.com/photo-1758691462878-6edc3d3da1be?auto=format&w=800&q=80&fit=crop\" alt=\"Dr. Savelev\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"37\">\n                    </div>\n                </div>\n\n                <div class=\"lg:w-7/12 about-content\" data-kid=\"38\">\n                    <div class=\"inline-block px-4 py-1 bg-[#4A6741]/10 text-[#4A6741] rounded-full text-[10px] font-black uppercase tracking-widest mb-10\" data-kid=\"39\">Founder & Chief Physician</div>\n                    <h2 class=\"text-6xl font-black text-[#4A4A4A] tracking-tighter mb-8 leading-none\" data-kid=\"40\">\n                        Доктор <br data-kid=\"41\"><span class=\"text-[#4A6741]\" data-kid=\"42\">Алексей Савельев</span>\n                    </h2>\n                    <div class=\"space-y-8 text-xl text-[#4A4A4A]/70 leading-relaxed mb-20 max-w-2xl\" data-kid=\"43\">\n                        <p data-kid=\"44\">\n                            Медицина для меня — это не просто лечение симптомов, это глубокое понимание биологической симфонии вашего организма. За 15 лет практики я помог тысячам людей обрести легкость и радость жизни.\n                        </p>\n                        <p data-kid=\"45\">\n                            Мы объединяем передовые диагностические технологии с философией холистического восстановления.\n                        </p>\n                    </div>\n\n                    \n                    <div class=\"flex items-end gap-10 h-80 stats-container\" data-kid=\"46\">\n                        <div class=\"flex-1 neomorph-raised rounded-[60px] p-10 flex flex-col justify-end h-full group hover:-translate-y-4 transition-transform duration-700\" data-kid=\"47\">\n                            <div class=\"text-8xl font-black text-[#4A6741] mb-4 tracking-tighter\" data-kid=\"48\">15</div>\n                            <div class=\"text-[10px] font-black uppercase tracking-[0.2em] text-[#4A4A4A]/40 group-hover:text-[#4A6741] transition-colors\" data-kid=\"49\">Лет опыта в Гастроэнтерологии</div>\n                        </div>\n                        <div class=\"flex-1 bg-[#4A6741] rounded-[60px] p-10 shadow-3xl shadow-[#4A6741]/20 flex flex-col justify-end h-[85%] group hover:-translate-y-4 transition-transform duration-700\" data-kid=\"50\">\n                            <div class=\"text-7xl font-black text-white mb-4 tracking-tighter\" data-kid=\"51\">5к+</div>\n                            <div class=\"text-[10px] font-black uppercase tracking-[0.2em] text-white/50\" data-kid=\"52\">Пациентов по всему миру</div>\n                        </div>\n                        <div class=\"flex-1 neomorph-raised rounded-[60px] p-10 flex flex-col justify-end h-[65%] group hover:-translate-y-4 transition-transform duration-700\" data-kid=\"53\">\n                            <div class=\"text-6xl font-black text-[#4A6741] mb-4 tracking-tighter\" data-kid=\"54\">24</div>\n                            <div class=\"text-[10px] font-black uppercase tracking-[0.2em] text-[#4A4A4A]/40 group-hover:text-[#4A6741] transition-colors\" data-kid=\"55\">Научных публикации</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"services\" class=\"py-48 bg-[#FDFBF7] relative\" data-kid=\"56\">\n        <div class=\"container mx-auto px-8\" data-kid=\"57\">\n            <div class=\"flex flex-col lg:flex-row justify-between items-end mb-32 gap-12\" data-kid=\"58\">\n                <div class=\"max-w-2xl\" data-kid=\"59\">\n                    <h2 class=\"text-8xl font-black tracking-tighter mb-8 leading-[0.8]\" data-kid=\"60\">Наши <br data-kid=\"61\">Направления</h2>\n                    <p class=\"text-2xl text-[#4A4A4A]/50 font-medium italic font-serif\" data-kid=\"62\">Сочетание клинической точности и эстетики здоровья</p>\n                </div>\n                <div class=\"hidden lg:block h-px flex-grow bg-[#4A6741]/10 mx-12\" data-kid=\"63\"></div>\n                <div class=\"text-[#4A6741] font-black uppercase tracking-[0.5em] text-[10px] whitespace-nowrap opacity-60\" data-kid=\"64\">Services Guide / Edition 2026</div>\n            </div>\n\n            <div class=\"grid grid-cols-12 gap-10\" data-kid=\"65\">\n                \n                <div class=\"col-span-12 lg:col-span-8 bg-white rounded-[80px] p-16 lg:p-24 flex flex-col lg:flex-row gap-20 shadow-2xl border border-[#4A6741]/5 service-card relative overflow-hidden group\" data-kid=\"66\">\n                    <div class=\"lg:w-1/2 flex flex-col justify-center\" data-kid=\"67\">\n                        <span class=\"text-[#4A6741] font-black text-[10px] uppercase tracking-[0.4em] mb-10 opacity-60\" data-kid=\"68\">Expert Remote Care</span>\n                        <h3 class=\"text-6xl font-black mb-10 tracking-tighter leading-none\" data-kid=\"69\">Онлайн <br data-kid=\"70\">Гастро</h3>\n                        <p class=\"text-xl text-[#4A4A4A]/60 leading-relaxed mb-16\" data-kid=\"71\">\n                            Медицина без границ. Глубокий анализ истории болезни и лабораторных данных в комфорте вашего дома.\n                        </p>\n                        <a href=\"#\" class=\"inline-flex items-center gap-6 text-[#4A6741] font-black text-xs uppercase tracking-[0.3em] group\" data-kid=\"72\">\n                            Узнать больше\n                            <span class=\"w-12 h-12 rounded-full border border-[#4A6741]/20 flex items-center justify-center group-hover:bg-[#4A6741] group-hover:text-white transition-all\" data-kid=\"73\">\n                                <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"74\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\" data-kid=\"75\"></path></svg>\n                            </span>\n                        </a>\n                    </div>\n                    <div class=\"lg:w-1/2 relative\" data-kid=\"76\">\n                        <div class=\"rounded-[60px] overflow-hidden shadow-3xl h-full rotate-2 group-hover:rotate-0 transition-transform duration-[2s]\" data-kid=\"77\">\n                            <img src=\"https://images.unsplash.com/photo-1760531932521-8eb5a064dbca?auto=format&w=800&q=80&fit=crop\" alt=\"Telehealth\" class=\"w-full h-full object-cover\" data-kid=\"78\">\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"col-span-12 md:col-span-6 lg:col-span-4 neomorph-raised rounded-[80px] p-16 service-card flex flex-col justify-between group hover:bg-[#4A6741] transition-colors hover:duration-700\" data-kid=\"79\">\n                    <div data-kid=\"80\">\n                        <h3 class=\"text-5xl font-black mb-10 tracking-tighter leading-none group-hover:text-white transition-colors\" data-kid=\"81\">Эндо <br data-kid=\"82\">скопия</h3>\n                        <p class=\"text-xl text-[#4A4A4A]/50 font-medium group-hover:text-white/60 transition-colors\" data-kid=\"83\">Беспрецедентная точность диагностики в медикаментозном сне.</p>\n                    </div>\n                    <div class=\"pt-20\" data-kid=\"84\">\n                        <div class=\"w-20 h-2 bg-[#4A6741]/10 rounded-full group-hover:bg-white/20 transition-colors\" data-kid=\"85\"></div>\n                    </div>\n                </div>\n\n                \n                <div class=\"col-span-12 md:col-span-6 lg:col-span-5 bg-[#4A6741] rounded-[80px] p-16 service-card text-white flex flex-col justify-between relative overflow-hidden\" data-kid=\"86\">\n                    <div class=\"absolute -top-10 -right-10 w-40 h-40 bg-white/5 rounded-full\" data-kid=\"87\"></div>\n                    <div data-kid=\"88\">\n                        <h3 class=\"text-5xl font-black mb-10 tracking-tighter\" data-kid=\"89\">Диетология</h3>\n                        <p class=\"text-white/70 text-xl leading-relaxed mb-12\" data-kid=\"90\">Индивидуальные протоколы питания, восстанавливающие микробиоту.</p>\n                    </div>\n                    <div class=\"flex items-center gap-6\" data-kid=\"91\">\n                        <div class=\"w-14 h-14 rounded-3xl bg-white/10 flex items-center justify-center\" data-kid=\"92\">\n                            <svg class=\"w-8 h-8\" fill=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"93\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\" data-kid=\"94\"></path></svg>\n                        </div>\n                        <span class=\"text-[10px] font-black uppercase tracking-[0.4em] opacity-60\" data-kid=\"95\">Healing Plate</span>\n                    </div>\n                </div>\n\n                \n                <div class=\"col-span-12 lg:col-span-7 neomorph-inset rounded-[80px] p-16 flex items-center justify-center relative overflow-hidden group\" data-kid=\"96\">\n                    <div class=\"absolute inset-0 bg-white/40 opacity-0 group-hover:opacity-100 transition-opacity duration-1000\" data-kid=\"97\"></div>\n                    <div class=\"max-w-2xl text-center relative z-10\" data-kid=\"98\">\n                        <p class=\"text-4xl font-serif italic text-[#4A6741] leading-tight\" data-kid=\"99\">\n                            «Здоровье — это не отсутствие болезни, <br data-kid=\"100\">это полнота жизни в каждом моменте»\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"reviews\" class=\"py-48 bg-white relative overflow-hidden\" data-kid=\"101\">\n        <div class=\"container mx-auto px-8\" data-kid=\"102\">\n            <div class=\"max-w-4xl mx-auto mb-32 text-center\" data-kid=\"103\">\n                <span class=\"text-[#4A6741] font-black uppercase tracking-[0.5em] text-[10px] mb-8 block\" data-kid=\"104\">Social Proof</span>\n                <h2 class=\"text-7xl font-black text-[#4A4A4A] tracking-tighter mb-10\" data-kid=\"105\">Истории <br data-kid=\"106\">перемен</h2>\n                <div class=\"w-24 h-1.5 bg-[#4A6741] mx-auto opacity-20 rounded-full\" data-kid=\"107\"></div>\n            </div>\n            \n            <div class=\"max-w-5xl mx-auto space-y-24\" data-kid=\"108\">\n                \n                <div class=\"flex items-start gap-12 review-bubble-left\" data-kid=\"109\">\n                    <div class=\"w-24 h-24 rounded-[40px] overflow-hidden shrink-0 shadow-3xl rotate-3 border-4 border-white\" data-kid=\"110\">\n                        <img src=\"https://i.pravatar.cc/150?u=anna\" alt=\"Reviewer\" decoding=\"async\" loading=\"lazy\" data-kid=\"111\">\n                    </div>\n                    <div class=\"neomorph-raised p-12 rounded-[60px] rounded-tl-none relative\" data-kid=\"112\">\n                        <p class=\"text-2xl text-[#4A4A4A] leading-relaxed italic font-serif mb-10 opacity-80\" data-kid=\"113\">\n                            \"Доктор Савельев — первый врач, который посмотрел на меня как на человека, а не как на набор анализов. Его подход к диетологии сотворил чудо с моей энергией.\"\n                        </p>\n                        <div class=\"flex items-center gap-6\" data-kid=\"114\">\n                            <span class=\"text-[10px] font-black uppercase tracking-[0.3em] text-[#4A6741]\" data-kid=\"115\">Анна / Patient Since 2024</span>\n                            <div class=\"h-px flex-grow bg-[#4A6741]/10\" data-kid=\"116\"></div>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"flex items-start gap-12 flex-row-reverse review-bubble-right\" data-kid=\"117\">\n                    <div class=\"w-24 h-24 rounded-[40px] overflow-hidden shrink-0 shadow-3xl -rotate-3 border-4 border-white\" data-kid=\"118\">\n                        <img src=\"https://i.pravatar.cc/150?u=mark\" alt=\"Reviewer\" decoding=\"async\" loading=\"lazy\" data-kid=\"119\">\n                    </div>\n                    <div class=\"bg-[#4A6741] p-12 rounded-[60px] rounded-tr-none shadow-3xl text-white relative\" data-kid=\"120\">\n                        <p class=\"text-2xl leading-relaxed italic font-serif mb-10 text-white/90\" data-kid=\"121\">\n                            \"Эндоскопия в Sage Wellness — это буквально 15 минут спокойного сна. Проснулся без капли дискомфорта. Это новый уровень медицины для России.\"\n                        </p>\n                        <div class=\"flex items-center gap-6\" data-kid=\"122\">\n                            <span class=\"text-[10px] font-black uppercase tracking-[0.3em] text-white/40\" data-kid=\"123\">Михаил / Clinical Case 2025</span>\n                            <div class=\"h-px flex-grow bg-white/10\" data-kid=\"124\"></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"booking\" class=\"py-48 bg-[#FDFBF7] relative\" data-kid=\"125\">\n        <div class=\"absolute inset-0 bg-white lg:h-1/2\" data-kid=\"126\"></div>\n        <div class=\"container mx-auto px-8 relative z-10\" data-kid=\"127\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 bg-white rounded-[100px] shadow-[0_50px_150px_rgba(0,0,0,0.08)] overflow-hidden booking-card border border-[#4A6741]/5\" data-kid=\"128\">\n                \n                <div class=\"lg:col-span-5 bg-[#4A6741] p-20 lg:p-32 text-white flex flex-col justify-center\" data-kid=\"129\">\n                    <h2 class=\"text-7xl lg:text-8xl font-black tracking-tighter mb-12 leading-[0.85]\" data-kid=\"130\">Новая <br data-kid=\"131\">Глава</h2>\n                    <p class=\"text-xl text-white/60 mb-16 leading-relaxed font-serif italic\" data-kid=\"132\">\n                        Начните свой путь к здоровью с экспертной консультации. Мы сделаем всё, чтобы вы чувствовали себя уверенно.\n                    </p>\n                    <div class=\"space-y-12\" data-kid=\"133\">\n                        <div class=\"flex items-center gap-8\" data-kid=\"134\">\n                            <div class=\"w-16 h-16 bg-white/10 rounded-3xl flex items-center justify-center\" data-kid=\"135\">\n                                <svg class=\"w-8 h-8\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"136\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\" data-kid=\"137\"></path></svg>\n                            </div>\n                            <div data-kid=\"138\">\n                                <span class=\"block text-[10px] font-black uppercase tracking-[0.4em] opacity-40 mb-2\" data-kid=\"139\">Concierge Service</span>\n                                <span class=\"text-2xl font-black\" data-kid=\"140\">+7 999 000 00 00</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"lg:col-span-7 p-20 lg:p-32 flex flex-col justify-center\" data-kid=\"141\">\n                    <form class=\"space-y-16\" data-kid=\"142\">\n                        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-16\" data-kid=\"143\">\n                            <div class=\"space-y-6\" data-kid=\"144\">\n                                <label class=\"text-[10px] font-black uppercase tracking-[0.4em] text-[#4A6741]\" data-kid=\"145\">Ваше Имя</label>\n                                <input type=\"text\" placeholder=\"Александр\" class=\"w-full border-b-2 border-[#4A6741]/20 py-4 focus:outline-none focus:border-[#4A6741] transition-all bg-transparent text-2xl font-black tracking-tighter placeholder:text-[#4A4A4A]/20\" data-kid=\"146\">\n                            </div>\n                            <div class=\"space-y-6\" data-kid=\"147\">\n                                <label class=\"text-[10px] font-black uppercase tracking-[0.4em] text-[#4A6741]\" data-kid=\"148\">Телефон</label>\n                                <input type=\"tel\" placeholder=\"+7 900 000\" class=\"w-full border-b-2 border-[#4A6741]/20 py-4 focus:outline-none focus:border-[#4A6741] transition-all bg-transparent text-2xl font-black tracking-tighter placeholder:text-[#4A4A4A]/20\" data-kid=\"149\">\n                            </div>\n                        </div>\n                        <div class=\"space-y-8\" data-kid=\"150\">\n                            <label class=\"text-[10px] font-black uppercase tracking-[0.4em] text-[#4A6741]\" data-kid=\"151\">Интересующая услуга</label>\n                            <div class=\"flex flex-wrap gap-6 pt-2\" data-kid=\"152\">\n                                <button type=\"button\" class=\"px-10 py-4 rounded-full border-2 border-[#4A6741]/10 text-[10px] font-black uppercase tracking-widest hover:bg-[#4A6741] hover:text-white transition-all\" data-kid=\"153\">Онлайн</button>\n                                <button type=\"button\" class=\"px-10 py-4 rounded-full border-2 border-[#4A6741]/10 text-[10px] font-black uppercase tracking-widest hover:bg-[#4A6741] hover:text-white transition-all\" data-kid=\"154\">Эндоскопия</button>\n                                <button type=\"button\" class=\"px-10 py-4 rounded-full border-2 border-[#4A6741]/10 text-[10px] font-black uppercase tracking-widest hover:bg-[#4A6741] hover:text-white transition-all\" data-kid=\"155\">Диетология</button>\n                            </div>\n                        </div>\n                        <button class=\"bg-[#4A6741] text-white px-20 py-8 rounded-3xl font-black text-sm uppercase tracking-[0.3em] shadow-3xl shadow-[#4A6741]/30 hover:scale-105 active:scale-95 transition-all\" data-kid=\"156\">\n                            Запланировать встречу\n                        </button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <footer class=\"bg-white py-32 px-8 border-t border-[#4A6741]/5\" data-kid=\"157\">\n        <div class=\"container mx-auto\" data-kid=\"158\">\n            <div class=\"grid grid-cols-1 md:grid-cols-4 gap-24 mb-32\" data-kid=\"159\">\n                <div class=\"col-span-1 md:col-span-2\" data-kid=\"160\">\n                    <div class=\"flex items-center gap-4 mb-10\" data-kid=\"161\">\n                        <div class=\"w-12 h-12 bg-[#4A6741] rounded-2xl flex items-center justify-center rotate-6\" data-kid=\"162\">\n                            <span class=\"text-white font-black text-2xl\" data-kid=\"163\">S</span>\n                        </div>\n                        <span class=\"font-black text-[#4A4A4A] tracking-tighter text-3xl\" data-kid=\"164\">Sage Wellness</span>\n                    </div>\n                    <p class=\"text-[#4A4A4A]/40 text-xl leading-relaxed max-w-sm font-serif italic\" data-kid=\"165\">\n                        Путь к истинному здоровью — это искусство баланса. Мы помогаем вам найти этот баланс каждый день.\n                    </p>\n                </div>\n                <div data-kid=\"166\">\n                    <h4 class=\"font-black uppercase tracking-[0.4em] text-[#4A6741] text-[10px] mb-12\" data-kid=\"167\">Clinic Info</h4>\n                    <ul class=\"space-y-6 text-xs font-black text-[#4A4A4A]/60 uppercase tracking-[0.3em]\" data-kid=\"168\">\n                        <li data-kid=\"169\"><a href=\"#about\" class=\"hover:text-[#4A6741] transition-colors\" data-kid=\"170\">О враче</a></li>\n                        <li data-kid=\"171\"><a href=\"#services\" class=\"hover:text-[#4A6741] transition-colors\" data-kid=\"172\">Услуги</a></li>\n                        <li data-kid=\"173\"><a href=\"#reviews\" class=\"hover:text-[#4A6741] transition-colors\" data-kid=\"174\">Отзывы</a></li>\n                    </ul>\n                </div>\n                <div data-kid=\"175\">\n                    <h4 class=\"font-black uppercase tracking-[0.4em] text-[#4A6741] text-[10px] mb-12\" data-kid=\"176\">Contact Details</h4>\n                    <ul class=\"space-y-6 text-xs font-black text-[#4A4A4A]/60 uppercase tracking-[0.2em]\" data-kid=\"177\">\n                        <li data-kid=\"178\">Москва, ул. Садовая, 12</li>\n                        <li data-kid=\"179\">info@sagewellness.ru</li>\n                        <li data-kid=\"180\">+7 999 000 00 00</li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"pt-20 border-t border-[#4A6741]/5 flex flex-col md:flex-row justify-between items-center gap-12\" data-kid=\"181\">\n                <p class=\"text-[10px] text-[#4A4A4A]/30 font-black uppercase tracking-[0.3em]\" data-kid=\"182\">© 2026 Sage Wellness. Personal medical practice.</p>\n                <div class=\"flex gap-12 opacity-30\" data-kid=\"183\">\n                    <a href=\"#\" class=\"hover:opacity-100 transition-opacity\" data-kid=\"184\"><svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"185\"><path d=\"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z\" data-kid=\"186\"></path></svg></a>\n                </div>\n            </div>\n        </div>\n    </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"187\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"188\"></script>\n<script type=\"module\" data-kid=\"189\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    // Initialize Lenis\n    const lenis = new Lenis();\n    function raf(time) {\n        lenis.raf(time);\n        requestAnimationFrame(raf);\n    }\n    requestAnimationFrame(raf);\n\n    // GSAP Animations\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Hero Entrance\n    gsap.from(\".hero-text\", {\n        y: 50,\n        opacity: 0,\n        duration: 1.5,\n        ease: \"power4.out\"\n    });\n\n    gsap.from(\".hero-image-container\", {\n        scale: 1.1,\n        opacity: 0,\n        duration: 2,\n        ease: \"power2.out\"\n    });\n\n    // About Section\n    gsap.from(\".about-image\", {\n        scrollTrigger: {\n            trigger: \"#about\",\n            start: \"top 80%\",\n        },\n        scale: 0.8,\n        opacity: 0,\n        duration: 1.2\n    });\n\n    gsap.from(\".about-content\", {\n        scrollTrigger: {\n            trigger: \"#about\",\n            start: \"top 80%\",\n        },\n        y: 50,\n        opacity: 0,\n        duration: 1\n    });\n\n    // Services\n    gsap.from(\".service-card\", {\n        scrollTrigger: {\n            trigger: \"#services\",\n            start: \"top 80%\",\n        },\n        y: 80,\n        opacity: 0,\n        stagger: 0.2,\n        duration: 1.2,\n        ease: \"power3.out\"\n    });\n\n    // Reviews\n    gsap.from(\".review-bubble-left\", {\n        scrollTrigger: {\n            trigger: \"#reviews\",\n            start: \"top 80%\",\n        },\n        x: -50,\n        opacity: 0,\n        stagger: 0.3,\n        duration: 1\n    });\n\n    gsap.from(\".review-bubble-right\", {\n        scrollTrigger: {\n            trigger: \"#reviews\",\n            start: \"top 80%\",\n        },\n        x: 50,\n        opacity: 0,\n        stagger: 0.3,\n        duration: 1\n    });\n\n    // Booking Card\n    gsap.from(\".booking-card\", {\n        scrollTrigger: {\n            trigger: \"#booking\",\n            start: \"top 80%\",\n        },\n        y: 100,\n        opacity: 0,\n        duration: 1.5,\n        ease: \"power4.out\"\n    });\n\n</script>\n",
