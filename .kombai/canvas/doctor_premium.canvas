      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800;900&display=swap');\n\n  body {\n    margin: 0;\n    padding: 0;\n    font-family: 'Inter', sans-serif;\n    background-color: #F8FAFC;\n    color: #1A1A1A;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-montserrat { font-family: 'Montserrat', sans-serif; }\n  \n  /* Glassmorphism utility */\n  .glass-card {\n    background: rgba(255, 255, 255, 0.55);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(0, 0, 0, 0.08);\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);\n  }\n\n  .glass-pill {\n    background: rgba(255, 255, 255, 0.2);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    border: 1px solid rgba(255, 255, 255, 0.4);\n    box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n  }\n\n  /* Custom scrollbar */\n  .hide-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .hide-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n\n  /* Progress segments */\n  .progress-segment {\n    height: 4px;\n    border-radius: 99px;\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n</style>\n\n<div class=\"relative flex flex-col h-screen max-w-[390px] mx-auto bg-white overflow-hidden\" data-kid=\"1\">\n  \n  <header class=\"shrink-0 z-50 bg-white/80 backdrop-blur-2xl border-b border-black/[0.05]\" data-kid=\"2\">\n    \n    <div class=\"h-12 px-8 flex items-end justify-between pb-1\" data-kid=\"3\">\n      <span class=\"text-[14px] font-bold text-gray-900\" data-kid=\"4\">9:41</span>\n      <div class=\"flex items-center gap-1.5\" data-kid=\"5\">\n        <i class=\"ph-bold ph-cellular-signal-full text-[12px]\" data-kid=\"6\"></i>\n        <i class=\"ph-bold ph-wifi-high text-[14px]\" data-kid=\"7\"></i>\n        <i class=\"ph-bold ph-battery-full text-[16px]\" data-kid=\"8\"></i>\n      </div>\n    </div>\n    \n    <div class=\"px-6 py-4\" data-kid=\"9\">\n      <div class=\"flex items-center justify-between mb-6\" data-kid=\"10\">\n        <button class=\"w-10 h-10 flex items-center justify-center rounded-2xl bg-white shadow-sm border border-black/[0.05] active:scale-95 transition-transform\" data-kid=\"11\">\n          <i class=\"ph-bold ph-caret-left text-lg text-gray-800\" data-kid=\"12\"></i>\n        </button>\n        <h1 class=\"text-xl font-montserrat font-extrabold text-gray-900 tracking-tight\" data-kid=\"13\">Бронирование</h1>\n        <button class=\"w-10 h-10 flex items-center justify-center rounded-2xl bg-white shadow-sm border border-black/[0.05] active:scale-95 transition-transform\" data-kid=\"14\">\n          <i class=\"ph-bold ph-question text-lg text-gray-400\" data-kid=\"15\"></i>\n        </button>\n      </div>\n      \n      \n      <div class=\"space-y-3\" data-kid=\"16\">\n        <div class=\"flex gap-2 w-full\" data-kid=\"17\">\n          <div class=\"progress-segment flex-1 bg-[#50C878]\" data-kid=\"18\"></div>\n          <div class=\"progress-segment flex-1 bg-gray-100\" data-kid=\"19\"></div>\n          <div class=\"progress-segment flex-1 bg-gray-100\" data-kid=\"20\"></div>\n          <div class=\"progress-segment flex-1 bg-gray-100\" data-kid=\"21\"></div>\n        </div>\n        <div class=\"flex justify-between items-center px-1\" data-kid=\"22\">\n          <span class=\"text-[10px] font-bold text-[#50C878] uppercase tracking-wider\" data-kid=\"23\">Выбор корта</span>\n          <span class=\"text-[10px] font-bold text-gray-400 uppercase tracking-wider\" data-kid=\"24\">Шаг 1 из 4</span>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <main class=\"flex-1 overflow-y-auto px-6 pt-6 space-y-8 hide-scrollbar\" data-kid=\"25\">\n    \n    <div class=\"space-y-2\" data-kid=\"26\">\n      <h2 class=\"text-2xl font-montserrat font-black text-gray-900 leading-tight\" data-kid=\"27\">Выберите площадку</h2>\n      <p class=\"text-sm text-gray-500 font-medium\" data-kid=\"28\">Доступные корты на сегодня</p>\n    </div>\n\n    \n    <div id=\"court-grid\" class=\"space-y-6\" data-kid=\"29\">\n      \n      \n      <div class=\"court-card group relative bg-white rounded-[2rem] overflow-hidden shadow-[0_12px_40px_rgba(0,0,0,0.04)] border border-black/[0.05] hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)]\" data-kid=\"30\">\n        <div class=\"relative h-[300px] w-full overflow-hidden\" data-kid=\"31\">\n          <img src=\"https://images.unsplash.com/photo-1658491830143-72808ca237e3?auto=format&w=800&q=80&fit=crop\" alt=\"Тарханово\" class=\"w-full h-full object-cover transition-transform duration-[1.5s] group-hover:scale-110\" decoding=\"async\" loading=\"lazy\" data-kid=\"32\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/20\" data-kid=\"33\"></div>\n          \n          \n          <div class=\"absolute top-5 left-5 flex flex-col gap-2\" data-kid=\"34\">\n            <div class=\"glass-pill px-4 py-2 rounded-2xl flex items-center gap-2\" data-kid=\"35\">\n              <div class=\"w-1.5 h-1.5 rounded-full bg-blue-400\" data-kid=\"36\"></div>\n              <span class=\"text-[11px] font-bold text-white uppercase tracking-widest\" data-kid=\"37\">Хард</span>\n            </div>\n          </div>\n          \n          <div class=\"absolute top-5 right-5\" data-kid=\"38\">\n            <div class=\"bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-2xl flex items-center gap-1.5 shadow-xl\" data-kid=\"39\">\n              <i class=\"ph-fill ph-star text-[10px] text-amber-400\" data-kid=\"40\"></i>\n              <span class=\"text-xs font-black text-gray-900\" data-kid=\"41\">4.9</span>\n            </div>\n          </div>\n\n          \n          <div class=\"absolute bottom-6 left-6 right-6 flex items-end justify-between text-white\" data-kid=\"42\">\n            <div class=\"space-y-1\" data-kid=\"43\">\n              <h3 class=\"text-2xl font-montserrat font-black leading-none\" data-kid=\"44\">Тарханово</h3>\n              <p class=\"text-xs font-medium opacity-80 flex items-center gap-1.5\" data-kid=\"45\">\n                <i class=\"ph-bold ph-map-pin\" data-kid=\"46\"></i>\n                ул. Тарханово, д. 21\n              </p>\n            </div>\n            <div class=\"text-right\" data-kid=\"47\">\n              <span class=\"block text-sm font-bold opacity-60 line-through\" data-kid=\"48\">1 800 ₽</span>\n              <span class=\"text-xl font-montserrat font-black text-[#50C878] drop-shadow-md\" data-kid=\"49\">1 500 ₽</span>\n              <span class=\"block text-[8px] font-black uppercase tracking-tighter opacity-80\" data-kid=\"50\">час</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"court-card group relative bg-white rounded-[2rem] overflow-hidden shadow-[0_12px_40px_rgba(0,0,0,0.04)] border border-black/[0.05] hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)]\" data-kid=\"51\">\n        <div class=\"relative h-[300px] w-full overflow-hidden\" data-kid=\"52\">\n          <img src=\"https://images.unsplash.com/photo-1615903711601-6c0145a31684?auto=format&w=800&q=80&fit=crop\" alt=\"Оломп 1\" class=\"w-full h-full object-cover transition-transform duration-[1.5s] group-hover:scale-110\" decoding=\"async\" loading=\"lazy\" data-kid=\"53\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/20\" data-kid=\"54\"></div>\n          \n          <div class=\"absolute top-5 left-5 flex flex-col gap-2\" data-kid=\"55\">\n            <div class=\"glass-pill px-4 py-2 rounded-2xl flex items-center gap-2\" data-kid=\"56\">\n              <div class=\"w-1.5 h-1.5 rounded-full bg-orange-400\" data-kid=\"57\"></div>\n              <span class=\"text-[11px] font-bold text-white uppercase tracking-widest\" data-kid=\"58\">Грунт</span>\n            </div>\n          </div>\n          \n          <div class=\"absolute top-5 right-5\" data-kid=\"59\">\n            <div class=\"bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-2xl flex items-center gap-1.5 shadow-xl\" data-kid=\"60\">\n              <i class=\"ph-fill ph-star text-[10px] text-amber-400\" data-kid=\"61\"></i>\n              <span class=\"text-xs font-black text-gray-900\" data-kid=\"62\">4.8</span>\n            </div>\n          </div>\n\n          <div class=\"absolute bottom-6 left-6 right-6 flex items-end justify-between text-white\" data-kid=\"63\">\n            <div class=\"space-y-1\" data-kid=\"64\">\n              <h3 class=\"text-2xl font-montserrat font-black leading-none\" data-kid=\"65\">Оломп 1</h3>\n              <p class=\"text-xs font-medium opacity-80 flex items-center gap-1.5\" data-kid=\"66\">\n                <i class=\"ph-bold ph-map-pin\" data-kid=\"67\"></i>\n                Олимпийская аллея, 3\n              </p>\n            </div>\n            <div class=\"text-right\" data-kid=\"68\">\n              <span class=\"text-xl font-montserrat font-black text-[#50C878] drop-shadow-md\" data-kid=\"69\">1 200 ₽</span>\n              <span class=\"block text-[8px] font-black uppercase tracking-tighter opacity-80\" data-kid=\"70\">час</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"court-card group relative bg-white rounded-[2rem] overflow-hidden shadow-[0_12px_40px_rgba(0,0,0,0.04)] border border-black/[0.05] hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)]\" data-kid=\"71\">\n        <div class=\"relative h-[300px] w-full overflow-hidden\" data-kid=\"72\">\n          <img src=\"https://images.unsplash.com/photo-1499510318569-1a3d67dc3976?auto=format&w=800&q=80&fit=crop\" alt=\"Оломп 2\" class=\"w-full h-full object-cover transition-transform duration-[1.5s] group-hover:scale-110\" decoding=\"async\" loading=\"lazy\" data-kid=\"73\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-black/20\" data-kid=\"74\"></div>\n          \n          <div class=\"absolute top-5 left-5 flex flex-col gap-2\" data-kid=\"75\">\n            <div class=\"glass-pill px-4 py-2 rounded-2xl flex items-center gap-2\" data-kid=\"76\">\n              <div class=\"w-1.5 h-1.5 rounded-full bg-blue-400\" data-kid=\"77\"></div>\n              <span class=\"text-[11px] font-bold text-white uppercase tracking-widest\" data-kid=\"78\">Хард</span>\n            </div>\n          </div>\n          \n          <div class=\"absolute top-5 right-5\" data-kid=\"79\">\n            <div class=\"bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-2xl flex items-center gap-1.5 shadow-xl\" data-kid=\"80\">\n              <i class=\"ph-fill ph-star text-[10px] text-amber-400\" data-kid=\"81\"></i>\n              <span class=\"text-xs font-black text-gray-900\" data-kid=\"82\">4.7</span>\n            </div>\n          </div>\n\n          <div class=\"absolute bottom-6 left-6 right-6 flex items-end justify-between text-white\" data-kid=\"83\">\n            <div class=\"space-y-1\" data-kid=\"84\">\n              <h3 class=\"text-2xl font-montserrat font-black leading-none\" data-kid=\"85\">Оломп 2</h3>\n              <p class=\"text-xs font-medium opacity-80 flex items-center gap-1.5\" data-kid=\"86\">\n                <i class=\"ph-bold ph-map-pin\" data-kid=\"87\"></i>\n                Олимпийская аллея, 3\n              </p>\n            </div>\n            <div class=\"text-right\" data-kid=\"88\">\n              <span class=\"text-xl font-montserrat font-black text-[#50C878] drop-shadow-md\" data-kid=\"89\">1 300 ₽</span>\n              <span class=\"block text-[8px] font-black uppercase tracking-tighter opacity-80\" data-kid=\"90\">час</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    \n    <div class=\"h-10\" data-kid=\"91\"></div>\n  </main>\n\n  \n  <nav class=\"shrink-0 z-50 bg-white/80 backdrop-blur-3xl border-t border-black/[0.05] px-8 pt-4 pb-10 flex justify-between items-center\" data-kid=\"92\">\n    <button class=\"flex flex-col items-center gap-1.5 group\" data-kid=\"93\">\n      <div class=\"w-10 h-1 bg-transparent rounded-full mb-1\" data-kid=\"94\"></div>\n      <i class=\"ph-bold ph-house text-2xl text-gray-300\" data-kid=\"95\"></i>\n      <span class=\"text-[10px] font-bold text-gray-400 uppercase tracking-tighter\" data-kid=\"96\">Главная</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1.5 group relative\" data-kid=\"97\">\n      <div class=\"w-10 h-1 bg-[#50C878] rounded-full mb-1\" data-kid=\"98\"></div>\n      <i class=\"ph-fill ph-calendar-plus text-2xl text-[#50C878]\" data-kid=\"99\"></i>\n      <span class=\"text-[10px] font-bold text-[#50C878] uppercase tracking-tighter\" data-kid=\"100\">Бронь</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1.5 group\" data-kid=\"101\">\n      <div class=\"w-10 h-1 bg-transparent rounded-full mb-1\" data-kid=\"102\"></div>\n      <i class=\"ph-bold ph-clock-counter-clockwise text-2xl text-gray-300\" data-kid=\"103\"></i>\n      <span class=\"text-[10px] font-bold text-gray-400 uppercase tracking-tighter\" data-kid=\"104\">Записи</span>\n    </button>\n    <button class=\"flex flex-col items-center gap-1.5 group\" data-kid=\"105\">\n      <div class=\"w-10 h-1 bg-transparent rounded-full mb-1\" data-kid=\"106\"></div>\n      <i class=\"ph-bold ph-user text-2xl text-gray-300\" data-kid=\"107\"></i>\n      <span class=\"text-[10px] font-bold text-gray-400 uppercase tracking-tighter\" data-kid=\"108\">Профиль</span>\n    </button>\n  </nav>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"109\"></script>\n<script src=\"https://unpkg.com/@phosphor-icons/web\" data-kid=\"110\"></script>\n<script data-kid=\"111\">\n  document.addEventListener('DOMContentLoaded', () => {\n    // Entrance animations\n    gsap.from('.court-card', {\n      y: 100,\n      opacity: 0,\n      duration: 1,\n      stagger: 0.2,\n      ease: 'expo.out',\n      clearProps: 'all'\n    });\n\n    gsap.from('header', {\n      y: -50,\n      opacity: 0,\n      duration: 1,\n      ease: 'expo.out'\n    });\n\n    // Hover sound/haptic simulation\n    const cards = document.querySelectorAll('.court-card');\n    cards.forEach(card => {\n      card.addEventListener('mouseenter', () => {\n        gsap.to(card, { scale: 1.02, duration: 0.4, ease: 'power2.out' });\n      });\n      card.addEventListener('mouseleave', () => {\n        gsap.to(card, { scale: 1, duration: 0.4, ease: 'power2.out' });\n      });\n      card.addEventListener('mousedown', () => {\n        gsap.to(card, { scale: 0.97, duration: 0.1 });\n      });\n      card.addEventListener('mouseup', () => {\n        gsap.to(card, { scale: 1.02, duration: 0.2 });\n      });\n    });\n  });\n</script>\n",
