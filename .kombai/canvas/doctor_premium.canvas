      "html": "\n\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"0\">\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"2\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"3\"></script>\n\n<style data-kid=\"4\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n    \n    :root {\n        --azure: #0066FF;\n        --slate: #0F172A;\n        --medical-bg: #F8FAFC;\n    }\n\n    .font-sans { font-family: -apple-system, BlinkMacSystemFont, \"Inter\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; }\n    \n    .glass-header {\n        background: rgba(255, 255, 255, 0.7);\n        backdrop-filter: saturate(180%) blur(20px);\n        border-bottom: 1px solid rgba(0, 0, 0, 0.05);\n    }\n\n    /* GSAP targets - no CSS transitions */\n    .hero-title, .hero-ghost-text, .hero-sub, .hero-btn, .ladder-card, .flow-step-card {\n        transition: none !important;\n    }\n\n    .azure-text-gradient {\n        background: linear-gradient(to bottom, var(--azure), #0044BB);\n        -webkit-background-clip: text;\n        -webkit-text-fill-color: transparent;\n    }\n\n    .image-mask {\n        mask-image: linear-gradient(to bottom, black 80%, transparent);\n        -webkit-mask-image: linear-gradient(to bottom, black 80%, transparent);\n    }\n\n    /* Lenis required base */\n    html.lenis { height: auto; }\n    .lenis.lenis-smooth { scroll-behavior: auto; }\n</style>\n\n<div class=\"font-sans bg-white text-[var(--slate)] selection:bg-blue-100 selection:text-blue-900 overflow-x-clip\" data-kid=\"5\">\n    \n    \n    <header class=\"fixed top-0 left-0 right-0 z-50 glass-header\" data-kid=\"6\">\n        <nav class=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\" data-kid=\"7\">\n            <div class=\"flex items-center gap-2\" data-kid=\"8\">\n                <div class=\"w-7 h-7 bg-[var(--azure)] rounded flex items-center justify-center\" data-kid=\"9\">\n                    <i class=\"ti ti-activity text-white text-base\" data-kid=\"10\"></i>\n                </div>\n                <span class=\"font-bold tracking-tight text-lg\" data-kid=\"11\">GastroExpert</span>\n            </div>\n            <ul class=\"hidden md:flex items-center gap-10 text-[13px] font-medium text-slate-500\" data-kid=\"12\">\n                <li data-kid=\"13\"><a href=\"#\" class=\"hover:text-[var(--azure)] transition-colors\" data-kid=\"14\">Главная</a></li>\n                <li data-kid=\"15\"><a href=\"#\" class=\"text-[var(--azure)]\" data-kid=\"16\">Эндоскопия</a></li>\n                <li data-kid=\"17\"><a href=\"#\" class=\"hover:text-[var(--azure)] transition-colors\" data-kid=\"18\">Диетология</a></li>\n                <li data-kid=\"19\"><a href=\"#\" class=\"hover:text-[var(--azure)] transition-colors\" data-kid=\"20\">Об онлайн-приеме</a></li>\n            </ul>\n            <div class=\"flex items-center gap-6\" data-kid=\"21\">\n                <a href=\"#\" class=\"text-[13px] font-medium text-slate-500 hover:text-[var(--azure)] transition-colors\" data-kid=\"22\">Вход</a>\n                <button class=\"px-4 py-1.5 bg-[var(--azure)] text-white text-[13px] font-semibold rounded-full hover:bg-blue-700 transition-colors cursor-pointer\" data-kid=\"23\">\n                    Запись\n                </button>\n            </div>\n        </nav>\n    </header>\n\n    \n    <section class=\"relative h-screen flex flex-col items-center justify-center pt-16 overflow-hidden\" data-kid=\"24\">\n        \n        <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none select-none\" data-kid=\"25\">\n            <h1 class=\"hero-ghost-text text-[26vw] font-black text-slate-900/[0.015] leading-none tracking-tighter uppercase whitespace-nowrap\" data-kid=\"26\">\n                ЭНДОСКОПИЯ\n            </h1>\n        </div>\n\n        <div class=\"relative z-10 max-w-7xl w-full px-6 flex flex-col items-center text-center\" data-kid=\"27\">\n            <h2 class=\"hero-title text-6xl md:text-8xl font-extrabold tracking-tight text-slate-900 mb-8 leading-[0.95] max-w-5xl\" data-kid=\"28\">\n                Профессиональный <br data-kid=\"29\"> <span class=\"azure-text-gradient\" data-kid=\"30\">второй взгляд</span> на ваше здоровье.\n            </h2>\n            <p class=\"hero-sub text-lg md:text-2xl text-slate-500 mb-12 max-w-2xl font-normal leading-tight\" data-kid=\"31\">\n                Экспертная расшифровка протоколов и гистологии. <br class=\"hidden md:block\" data-kid=\"32\"> Точная подготовка к ФГДС и колоноскопии.\n            </p>\n            <div class=\"hero-btn flex items-center gap-4\" data-kid=\"33\">\n                <button class=\"px-8 py-4 bg-[var(--azure)] text-white rounded-xl font-bold text-lg hover:shadow-xl hover:-translate-y-0.5 transition-all cursor-pointer\" data-kid=\"34\">\n                    Начать консультацию\n                </button>\n                <button class=\"px-8 py-4 bg-slate-50 text-slate-900 rounded-xl font-bold text-lg hover:bg-slate-100 transition-all cursor-pointer\" data-kid=\"35\">\n                    Услуги и цены\n                </button>\n            </div>\n        </div>\n\n        <div class=\"absolute bottom-12 left-1/2 -translate-x-1/2 animate-bounce opacity-20\" data-kid=\"36\">\n            <i class=\"ti ti-chevron-down text-2xl\" data-kid=\"37\"></i>\n        </div>\n    </section>\n\n    \n    <section class=\"py-24 bg-white\" data-kid=\"38\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"39\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24 items-center mb-40\" data-kid=\"40\">\n                <div class=\"ladder-card space-y-8\" data-kid=\"41\">\n                    <h3 class=\"text-4xl md:text-5xl font-extrabold tracking-tighter leading-none\" data-kid=\"42\">\n                        Подготовка <br data-kid=\"43\"> <span class=\"text-slate-400\" data-kid=\"44\">к обследованию</span>\n                    </h3>\n                    <div class=\"space-y-6\" data-kid=\"45\">\n                        <div class=\"p-6 bg-slate-50 rounded-2xl flex justify-between items-center group hover:bg-white hover:shadow-2xl transition-all cursor-default border border-transparent hover:border-slate-100\" data-kid=\"46\">\n                            <div data-kid=\"47\">\n                                <h4 class=\"font-bold text-lg\" data-kid=\"48\">ФГДС</h4>\n                                <p class=\"text-slate-500 text-sm\" data-kid=\"49\">Индивидуальный план подготовки</p>\n                            </div>\n                            <span class=\"text-xl font-bold text-[var(--azure)]\" data-kid=\"50\">700 ₽</span>\n                        </div>\n                        <div class=\"p-6 bg-slate-50 rounded-2xl flex justify-between items-center group hover:bg-white hover:shadow-2xl transition-all cursor-default border border-transparent hover:border-slate-100\" data-kid=\"51\">\n                            <div data-kid=\"52\">\n                                <h4 class=\"font-bold text-lg\" data-kid=\"53\">Колоноскопия</h4>\n                                <p class=\"text-slate-500 text-sm\" data-kid=\"54\">Схема приема и диетические нормы</p>\n                            </div>\n                            <span class=\"text-xl font-bold text-[var(--azure)]\" data-kid=\"55\">900 ₽</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"ladder-card relative\" data-kid=\"56\">\n                    <div class=\"aspect-square bg-slate-100 rounded-[60px] overflow-hidden\" data-kid=\"57\">\n                        <img src=\"https://images.unsplash.com/photo-1580281657702-257584239a55?auto=format&w=1200&q=80&fit=crop\" alt=\"Lab\" class=\"w-full h-full object-cover scale-110 grayscale hover:grayscale-0 transition-all duration-1000\" decoding=\"async\" loading=\"lazy\" data-kid=\"58\">\n                    </div>\n                    <div class=\"absolute -bottom-10 -left-10 w-48 h-48 bg-[var(--azure)]/90 backdrop-blur-xl rounded-[40px] flex flex-col items-center justify-center text-white p-6 shadow-2xl border border-white/20\" data-kid=\"59\">\n                        <i class=\"ti ti-shield-check text-4xl mb-2\" data-kid=\"60\"></i>\n                        <span class=\"text-[10px] font-bold uppercase tracking-widest text-center\" data-kid=\"61\">Гарантия точности</span>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24 items-center flex-row-reverse\" data-kid=\"62\">\n                <div class=\"ladder-card order-2 md:order-1 relative\" data-kid=\"63\">\n                    <div class=\"aspect-video bg-slate-100 rounded-[40px] overflow-hidden\" data-kid=\"64\">\n                        <img src=\"https://images.unsplash.com/photo-1642975967602-653d378f3b5b?auto=format&w=1200&q=80&fit=crop\" alt=\"Diagnosis\" class=\"w-full h-full object-cover scale-110 grayscale hover:grayscale-0 transition-all duration-1000\" decoding=\"async\" loading=\"lazy\" data-kid=\"65\">\n                    </div>\n                </div>\n                <div class=\"ladder-card order-1 md:order-2 space-y-8\" data-kid=\"66\">\n                    <h3 class=\"text-4xl md:text-5xl font-extrabold tracking-tighter leading-none\" data-kid=\"67\">\n                        Экспертная <br data-kid=\"68\"> <span class=\"text-slate-400\" data-kid=\"69\">расшифровка</span>\n                    </h3>\n                    <div class=\"space-y-6\" data-kid=\"70\">\n                        <div class=\"p-6 bg-slate-50 rounded-2xl flex justify-between items-center group hover:bg-white hover:shadow-2xl transition-all cursor-default border border-transparent hover:border-slate-100\" data-kid=\"71\">\n                            <div data-kid=\"72\">\n                                <h4 class=\"font-bold text-lg\" data-kid=\"73\">Протокол исследования</h4>\n                                <p class=\"text-slate-500 text-sm\" data-kid=\"74\">Перевод с медицинского на понятный</p>\n                            </div>\n                            <span class=\"text-xl font-bold text-[var(--azure)]\" data-kid=\"75\">1000 ₽</span>\n                        </div>\n                        <div class=\"p-6 bg-slate-50 rounded-2xl flex justify-between items-center group hover:bg-white hover:shadow-2xl transition-all cursor-default border border-transparent hover:border-slate-100\" data-kid=\"76\">\n                            <div data-kid=\"77\">\n                                <h4 class=\"font-bold text-lg\" data-kid=\"78\">Результаты гистологии</h4>\n                                <p class=\"text-slate-500 text-sm\" data-kid=\"79\">Анализ биопсии и прогноз рисков</p>\n                            </div>\n                            <span class=\"text-xl font-bold text-[var(--azure)]\" data-kid=\"80\">1000 ₽</span>\n                        </div>\n                        <div class=\"p-6 border-2 border-[var(--azure)]/30 rounded-2xl flex justify-between items-center bg-blue-50/20 group hover:bg-white hover:shadow-2xl hover:border-[var(--azure)] transition-all cursor-default\" data-kid=\"81\">\n                            <div data-kid=\"82\">\n                                <h4 class=\"font-bold text-lg text-[var(--azure)]\" data-kid=\"83\">Второе мнение</h4>\n                                <p class=\"text-slate-500 text-sm\" data-kid=\"84\">Полный пересмотр вашей истории</p>\n                            </div>\n                            <span class=\"text-2xl font-black text-[var(--azure)]\" data-kid=\"85\">2000 ₽</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-32 bg-slate-900 text-white\" data-kid=\"86\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"87\">\n            <h2 class=\"text-4xl md:text-6xl font-extrabold tracking-tight mb-20 text-center\" data-kid=\"88\">Как мы работаем</h2>\n            \n            <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12\" data-kid=\"89\">\n                <div class=\"flow-step-card space-y-6\" data-kid=\"90\">\n                    <span class=\"text-6xl font-black text-white/5\" data-kid=\"91\">01</span>\n                    <h4 class=\"text-2xl font-bold border-l-2 border-[var(--azure)] pl-4\" data-kid=\"92\">Заявка</h4>\n                    <p class=\"text-slate-400 font-light\" data-kid=\"93\">Напишите в Telegram или заполните форму. Мы ответим в течение часа.</p>\n                </div>\n                <div class=\"flow-step-card space-y-6\" data-kid=\"94\">\n                    <span class=\"text-6xl font-black text-white/5\" data-kid=\"95\">02</span>\n                    <h4 class=\"text-2xl font-bold border-l-2 border-[var(--azure)] pl-4\" data-kid=\"96\">Анализ</h4>\n                    <p class=\"text-slate-400 font-light\" data-kid=\"97\">Загрузите имеющиеся документы. Врач приступает к изучению.</p>\n                </div>\n                <div class=\"flow-step-card space-y-6\" data-kid=\"98\">\n                    <span class=\"text-6xl font-black text-white/5\" data-kid=\"99\">03</span>\n                    <h4 class=\"text-2xl font-bold border-l-2 border-[var(--azure)] pl-4\" data-kid=\"100\">Консультация</h4>\n                    <p class=\"text-slate-400 font-light\" data-kid=\"101\">Детальный разбор, ответы на вопросы и уточнение диагноза.</p>\n                </div>\n                <div class=\"flow-step-card space-y-6\" data-kid=\"102\">\n                    <span class=\"text-6xl font-black text-white/5\" data-kid=\"103\">04</span>\n                    <h4 class=\"text-2xl font-bold border-l-2 border-[var(--azure)] pl-4\" data-kid=\"104\">Результат</h4>\n                    <p class=\"text-slate-400 font-light\" data-kid=\"105\">Вы получаете письменное заключение и четкую стратегию действий.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-40 bg-white\" data-kid=\"106\">\n        <div class=\"max-w-4xl mx-auto px-6 text-center\" data-kid=\"107\">\n            <h2 class=\"text-5xl md:text-7xl font-extrabold tracking-tighter mb-10\" data-kid=\"108\">Доверьте диагностику <span class=\"text-[var(--azure)]\" data-kid=\"109\">эксперту</span>.</h2>\n            <p class=\"text-xl text-slate-500 mb-12 font-medium\" data-kid=\"110\">Ваше здоровье не терпит неопределенности. Начните путь к выздоровлению с точного понимания ситуации.</p>\n            <div class=\"flex flex-col sm:flex-row justify-center gap-6\" data-kid=\"111\">\n                <button class=\"px-10 py-5 bg-[var(--azure)] text-white rounded-2xl font-bold text-xl hover:scale-105 transition-transform cursor-pointer shadow-xl shadow-blue-500/20\" data-kid=\"112\">\n                    Написать в Telegram\n                </button>\n                <button class=\"px-10 py-5 bg-slate-900 text-white rounded-2xl font-bold text-xl hover:bg-black transition-all cursor-pointer\" data-kid=\"113\">\n                    Заказать звонок\n                </button>\n            </div>\n        </div>\n    </section>\n\n    \n    <footer class=\"py-12 border-t border-slate-100 bg-white\" data-kid=\"114\">\n        <div class=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"115\">\n            <div class=\"flex items-center gap-2\" data-kid=\"116\">\n                <div class=\"w-6 h-6 bg-[var(--azure)] rounded flex items-center justify-center\" data-kid=\"117\">\n                    <i class=\"ti ti-activity text-white text-xs\" data-kid=\"118\"></i>\n                </div>\n                <span class=\"font-bold tracking-tight text-base\" data-kid=\"119\">GastroExpert</span>\n            </div>\n            <div class=\"text-slate-400 text-xs font-medium tracking-widest uppercase\" data-kid=\"120\">\n                &copy; 2026 Все права защищены. Лицензия № Л041-01137-77/00361000\n            </div>\n            <div class=\"flex gap-6\" data-kid=\"121\">\n                <a href=\"#\" class=\"text-slate-400 hover:text-[var(--azure)] transition-colors\" data-kid=\"122\"><i class=\"ti ti-brand-telegram text-xl\" data-kid=\"123\"></i></a>\n                <a href=\"#\" class=\"text-slate-400 hover:text-[var(--azure)] transition-colors\" data-kid=\"124\"><i class=\"ti ti-brand-vk text-xl\" data-kid=\"125\"></i></a>\n            </div>\n        </div>\n    </footer>\n\n</div>\n\n\n<script type=\"module\" data-kid=\"126\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    import Snap from \"https://esm.sh/lenis@1/snap\"\n\n    const lenis = new Lenis()\n    \n    // Lenis - ScrollTrigger Sync\n    lenis.on('scroll', ScrollTrigger.update)\n    gsap.ticker.add((time) => {\n        lenis.raf(time * 1000)\n    })\n    gsap.ticker.lagSmoothing(0)\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Hero Entrance\n    const heroTl = gsap.timeline();\n    heroTl.from(\".hero-ghost-text\", { opacity: 0, y: 100, scale: 0.95, duration: 2, ease: \"power4.out\" })\n          .from(\".hero-title\", { opacity: 0, y: 50, duration: 1.2, ease: \"power3.out\" }, \"-=1.5\")\n          .from(\".hero-sub\", { opacity: 0, y: 30, duration: 1, ease: \"power2.out\" }, \"-=1\")\n          .from(\".hero-btn\", { opacity: 0, scale: 0.9, duration: 0.8, ease: \"back.out(1.7)\" }, \"-=0.8\");\n\n    // Ladder Items\n    gsap.utils.toArray(\".ladder-card\").forEach((card) => {\n        gsap.from(card, {\n            scrollTrigger: {\n                trigger: card,\n                start: \"top 85%\",\n                toggleActions: \"play none none reverse\"\n            },\n            opacity: 0,\n            y: 60,\n            duration: 1.2,\n            ease: \"expo.out\"\n        });\n    });\n\n    // Flow Steps\n    gsap.utils.toArray(\".flow-step-card\").forEach((card, i) => {\n        gsap.from(card, {\n            scrollTrigger: {\n                trigger: card,\n                start: \"top 90%\",\n            },\n            opacity: 0,\n            x: -20,\n            duration: 1,\n            delay: i * 0.15,\n            ease: \"power2.out\"\n        });\n    });\n</script>\n",
