      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700;900&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n    :root {\n        --color-bg: #FAFAFA;\n        --color-linen: #EBEAE4;\n        --color-crimson: #960018;\n        --color-onyx: #111111;\n    }\n\n    body {\n        font-family: 'Inter', sans-serif;\n        background-color: var(--color-bg);\n        color: var(--color-onyx);\n        margin: 0;\n        overflow-x: clip;\n    }\n\n    /* Editorial Type Styles */\n    .headline-xl {\n        font-size: clamp(3rem, 8.5vw, 7rem);\n        line-height: 0.88;\n        letter-spacing: -0.04em;\n        font-weight: 900;\n        text-transform: uppercase;\n    }\n\n    .sub-headline {\n        font-size: clamp(2.5rem, 6vw, 4.5rem);\n        line-height: 0.95;\n        letter-spacing: -0.03em;\n        font-weight: 900;\n        text-transform: uppercase;\n    }\n\n    .eyebrow {\n        font-size: 0.7rem;\n        letter-spacing: 0.4em;\n        text-transform: uppercase;\n        font-weight: 700;\n        color: var(--color-crimson);\n    }\n\n    /* Custom Utilities */\n    .border-hairline { border-width: 0.5px; }\n    \n    .hover-reveal-img {\n        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    /* Smooth Scroll */\n    html.lenis {\n        height: auto;\n    }\n    .lenis-smooth {\n        scroll-behavior: auto !important;\n    }\n    .lenis-smooth [data-lenis-prevent] {\n        overscroll-behavior: contain;\n    }\n    .lenis-stopped {\n        overflow: hidden;\n    }\n</style>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n\n\n<header class=\"fixed top-0 left-0 w-full z-[100] bg-white/80 backdrop-blur-md border-b border-[var(--color-linen)] px-8 py-5 flex items-center justify-between\" data-kid=\"2\">\n    <div class=\"flex items-center gap-4\" data-kid=\"3\">\n        <img src=\"/api/local/images/static/logotip.svg\" alt=\"Dr. Gondusov Logo\" class=\"h-10 w-auto\" data-kid=\"4\">\n        <div class=\"flex flex-col\" data-kid=\"5\">\n            <span class=\"font-black uppercase tracking-tighter text-lg leading-none\" data-kid=\"6\">Гондусов Денис</span>\n            <span class=\"text-[8px] uppercase tracking-[0.2em] opacity-40 font-bold\" data-kid=\"7\">Гастроэнтеролог</span>\n        </div>\n    </div>\n    \n    <nav class=\"hidden md:flex items-center gap-12\" data-kid=\"8\">\n        <a href=\"#hero\" class=\"relative group text-[10px] uppercase tracking-[0.3em] font-bold hover:text-[var(--color-crimson)] transition-colors\" data-kid=\"9\">\n            Главная\n            <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-[var(--color-crimson)] group-hover:w-full transition-all duration-300\" data-kid=\"10\"></span>\n        </a>\n        <a href=\"#about\" class=\"relative group text-[10px] uppercase tracking-[0.3em] font-bold hover:text-[var(--color-crimson)] transition-colors\" data-kid=\"11\">\n            О докторе\n            <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-[var(--color-crimson)] group-hover:w-full transition-all duration-300\" data-kid=\"12\"></span>\n        </a>\n        <a href=\"#expertise\" class=\"relative group text-[10px] uppercase tracking-[0.3em] font-bold hover:text-[var(--color-crimson)] transition-colors\" data-kid=\"13\">\n            Услуги\n            <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-[var(--color-crimson)] group-hover:w-full transition-all duration-300\" data-kid=\"14\"></span>\n        </a>\n        <a href=\"#reviews\" class=\"relative group text-[10px] uppercase tracking-[0.3em] font-bold hover:text-[var(--color-crimson)] transition-colors\" data-kid=\"15\">\n            Отзывы\n            <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-[var(--color-crimson)] group-hover:w-full transition-all duration-300\" data-kid=\"16\"></span>\n        </a>\n    </nav>\n\n    <a href=\"#booking\" class=\"border border-[var(--color-onyx)] px-6 py-2 text-[10px] uppercase tracking-[0.2em] font-bold hover:bg-[var(--color-onyx)] hover:text-white transition-all duration-300\" data-kid=\"17\">\n        Записаться\n    </a>\n</header>\n\n<main data-kid=\"18\">\n    \n    <section id=\"hero\" class=\"min-h-screen pt-20 grid grid-cols-1 md:grid-cols-12 border-b border-[var(--color-linen)] overflow-hidden\" data-kid=\"19\">\n        \n        <div class=\"hidden md:flex md:col-span-1 border-r border-[var(--color-linen)] flex-col justify-end p-6 pb-20\" data-kid=\"20\">\n            <div class=\"origin-bottom-left -rotate-90 whitespace-nowrap text-[9px] tracking-[0.5em] uppercase opacity-30 font-black\" data-kid=\"21\">\n                Gastroenterology / Endoscopy / Nutrition\n            </div>\n        </div>\n\n        \n        <div class=\"col-span-1 md:col-span-7 flex flex-col justify-center px-8 md:px-20 py-20 z-10\" data-kid=\"22\">\n            <div class=\"hero-reveal mb-8\" data-kid=\"23\">\n                <span class=\"eyebrow\" data-kid=\"24\">Экспертная Гастроэнтерология</span>\n            </div>\n            <h1 class=\"headline-xl mb-12\" data-kid=\"25\">\n                <span class=\"hero-text block\" data-kid=\"26\">Искусство</span>\n                <span class=\"hero-text block text-[var(--color-crimson)]\" data-kid=\"27\">Прецизионной</span>\n                <span class=\"hero-text block\" data-kid=\"28\">Диагностики</span>\n            </h1>\n            <div class=\"max-w-xl hero-reveal\" data-kid=\"29\">\n                <p class=\"text-lg md:text-xl text-[var(--color-onyx)]/70 leading-relaxed mb-10\" data-kid=\"30\">\n                    Помогаю разобраться в причинах проблем ЖКТ, подготовиться к обследованиям и получить понятный план действий без лишних назначений.\n                </p>\n                <div class=\"flex flex-col sm:flex-row items-start sm:items-center gap-10\" data-kid=\"31\">\n                    <a href=\"#booking\" class=\"bg-[var(--color-onyx)] text-white px-12 py-6 text-xs uppercase tracking-[0.4em] font-black hover:bg-[var(--color-crimson)] transition-all duration-500 shadow-2xl\" data-kid=\"32\">\n                        Записаться онлайн\n                    </a>\n                    <div class=\"flex flex-col\" data-kid=\"33\">\n                        <span class=\"text-[9px] uppercase tracking-[0.3em] opacity-40 font-bold mb-1\" data-kid=\"34\">Статус</span>\n                        <div class=\"flex items-center gap-2\" data-kid=\"35\">\n                            <span class=\"w-2 h-2 rounded-full bg-green-500 animate-pulse\" data-kid=\"36\"></span>\n                            <span class=\"text-sm font-bold uppercase tracking-widest\" data-kid=\"37\">Ведется прием</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"col-span-1 md:col-span-4 relative h-[60vh] md:h-auto overflow-hidden\" data-kid=\"38\">\n            <img src=\"/api/local/images/static/doctor.webp\" alt=\"Doctor Denis Gondusov\" class=\"hero-img absolute inset-0 w-full h-full object-cover grayscale brightness-95\" decoding=\"async\" loading=\"lazy\" data-kid=\"39\">\n            <div class=\"absolute bottom-10 left-10 z-10 text-white\" data-kid=\"40\">\n                <p class=\"text-[10px] uppercase tracking-[0.3em] font-bold opacity-60\" data-kid=\"41\">Специалист экспертного класса</p>\n                <h3 class=\"text-2xl font-black uppercase tracking-tight\" data-kid=\"42\">Гондусов Денис</h3>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"about\" class=\"py-32 px-8 md:px-20 grid grid-cols-1 lg:grid-cols-2 gap-20 md:gap-32 border-b border-[var(--color-linen)]\" data-kid=\"43\">\n        <div class=\"relative about-reveal\" data-kid=\"44\">\n            <div class=\"aspect-[4/5] overflow-hidden grayscale brightness-95\" data-kid=\"45\">\n                <img src=\"/api/local/images/static/doctor_about.webp\" class=\"w-full h-full object-cover hover:scale-105 transition-transform duration-1000\" alt=\"Dr. Gondusov Denis\" decoding=\"async\" loading=\"lazy\" data-kid=\"46\">\n            </div>\n            <div class=\"absolute -bottom-10 -right-4 md:-right-10 bg-[var(--color-crimson)] text-white p-10 md:p-14 max-w-sm shadow-2xl\" data-kid=\"47\">\n                <p class=\"text-lg italic leading-relaxed font-light\" data-kid=\"48\">\n                    \"Медицина сегодня — это не только знания, но и точность технологий, позволяющая заглянуть в будущее здоровья пациента.\"\n                </p>\n            </div>\n        </div>\n\n        <div class=\"flex flex-col justify-center about-reveal\" data-kid=\"49\">\n            <span class=\"eyebrow mb-6\" data-kid=\"50\">Философия Практики</span>\n            <h2 class=\"sub-headline mb-10\" data-kid=\"51\">Искусство быть <br data-kid=\"52\"> а не казаться</h2>\n            <div class=\"prose prose-lg text-[var(--color-onyx)]/70 mb-16\" data-kid=\"53\">\n                <p data-kid=\"54\">\n                    Денис Вадимович Гондусов — врач-гастроэнтеролог, эндоскопист и специалист по лечебному питанию. Практика строится на принципах персонализированной медицины и глубокой диагностики.\n                </p>\n            </div>\n\n            \n            <div class=\"space-y-0\" data-kid=\"55\">\n                <div class=\"ledger-row grid grid-cols-12 py-8 border-t border-[var(--color-onyx)]\" data-kid=\"56\">\n                    <div class=\"col-span-6 text-[10px] md:text-xs uppercase tracking-[0.3em] font-black\" data-kid=\"57\">Стаж работы</div>\n                    <div class=\"col-span-4 text-[10px] md:text-xs opacity-50 uppercase tracking-widest\" data-kid=\"58\">Gastro & Endoscopy</div>\n                    <div class=\"col-span-2 text-right font-black text-[var(--color-crimson)]\" data-kid=\"59\">>10 лет</div>\n                </div>\n                <div class=\"ledger-row grid grid-cols-12 py-8 border-t border-[var(--color-onyx)]\" data-kid=\"60\">\n                    <div class=\"col-span-6 text-[10px] md:text-xs uppercase tracking-[0.3em] font-black\" data-kid=\"61\">Уникальных пациентов</div>\n                    <div class=\"col-span-4 text-[10px] md:text-xs opacity-50 uppercase tracking-widest\" data-kid=\"62\">Clinical Success</div>\n                    <div class=\"col-span-2 text-right font-black text-[var(--color-crimson)]\" data-kid=\"63\">5000+</div>\n                </div>\n                <div class=\"ledger-row grid grid-cols-12 py-8 border-t border-[var(--color-onyx)]\" data-kid=\"64\">\n                    <div class=\"col-span-6 text-[10px] md:text-xs uppercase tracking-[0.3em] font-black\" data-kid=\"65\">Проведенных процедур</div>\n                    <div class=\"col-span-4 text-[10px] md:text-xs opacity-50 uppercase tracking-widest\" data-kid=\"66\">Endoscopy Precision</div>\n                    <div class=\"col-span-2 text-right font-black text-[var(--color-crimson)]\" data-kid=\"67\">8000+</div>\n                </div>\n                <div class=\"ledger-row grid grid-cols-12 py-8 border-t border-b border-[var(--color-onyx)]\" data-kid=\"68\">\n                    <div class=\"col-span-6 text-[10px] md:text-xs uppercase tracking-[0.3em] font-black\" data-kid=\"69\">Научный подход</div>\n                    <div class=\"col-span-4 text-[10px] md:text-xs opacity-50 uppercase tracking-widest\" data-kid=\"70\">Evidence-Based</div>\n                    <div class=\"col-span-2 text-right font-black text-[var(--color-crimson)]\" data-kid=\"71\">100%</div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"expertise\" class=\"py-32 px-8 md:px-20 bg-white\" data-kid=\"72\">\n        <div class=\"flex flex-col md:flex-row justify-between items-start md:items-end mb-24 gap-8\" data-kid=\"73\">\n            <div class=\"expertise-reveal\" data-kid=\"74\">\n                <span class=\"eyebrow mb-4 block\" data-kid=\"75\">Направления работы</span>\n                <h2 class=\"sub-headline\" data-kid=\"76\">Глубокая <br data-kid=\"77\"> Экспертиза</h2>\n            </div>\n            <p class=\"max-w-md text-sm md:text-base opacity-60 leading-relaxed uppercase tracking-widest expertise-reveal\" data-kid=\"78\">\n                Мы используем только оборудование последнего поколения и протоколы, доказавшие свою эффективность.\n            </p>\n        </div>\n\n        <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12\" data-kid=\"79\">\n            \n            <div class=\"lg:col-span-7 space-y-0 expertise-reveal\" data-kid=\"80\">\n                <div class=\"group expertise-item py-14 border-t border-[var(--color-onyx)] hover:bg-[var(--color-onyx)] hover:text-white transition-all duration-700 cursor-pointer flex justify-between items-center px-6\" data-preview=\"1\" data-kid=\"81\">\n                    <div data-kid=\"82\">\n                        <span class=\"text-[10px] font-bold opacity-30 group-hover:opacity-60 mb-3 block tracking-[0.3em]\" data-kid=\"83\">01 / ТЕХНОЛОГИИ</span>\n                        <h3 class=\"text-3xl md:text-5xl font-black uppercase tracking-tighter\" data-kid=\"84\">Эндоскопия</h3>\n                    </div>\n                    <div class=\"w-12 h-12 border border-current flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all\" data-kid=\"85\">\n                        <i class=\"ti ti-arrow-right text-2xl\" data-kid=\"86\"></i>\n                    </div>\n                </div>\n                <div class=\"group expertise-item py-14 border-t border-[var(--color-onyx)] hover:bg-[var(--color-onyx)] hover:text-white transition-all duration-700 cursor-pointer flex justify-between items-center px-6\" data-preview=\"2\" data-kid=\"87\">\n                    <div data-kid=\"88\">\n                        <span class=\"text-[10px] font-bold opacity-30 group-hover:opacity-60 mb-3 block tracking-[0.3em]\" data-kid=\"89\">02 / ДОСТУПНОСТЬ</span>\n                        <h3 class=\"text-3xl md:text-5xl font-black uppercase tracking-tighter\" data-kid=\"90\">Гастроэнтерология Онлайн</h3>\n                    </div>\n                    <div class=\"w-12 h-12 border border-current flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all\" data-kid=\"91\">\n                        <i class=\"ti ti-arrow-right text-2xl\" data-kid=\"92\"></i>\n                    </div>\n                </div>\n                <div class=\"group expertise-item py-14 border-t border-b border-[var(--color-onyx)] hover:bg-[var(--color-onyx)] hover:text-white transition-all duration-700 cursor-pointer flex justify-between items-center px-6\" data-preview=\"3\" data-kid=\"93\">\n                    <div data-kid=\"94\">\n                        <span class=\"text-[10px] font-bold opacity-30 group-hover:opacity-60 mb-3 block tracking-[0.3em]\" data-kid=\"95\">03 / ПРЕВЕНЦИЯ</span>\n                        <h3 class=\"text-3xl md:text-5xl font-black uppercase tracking-tighter\" data-kid=\"96\">Питание и Диетология</h3>\n                    </div>\n                    <div class=\"w-12 h-12 border border-current flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all\" data-kid=\"97\">\n                        <i class=\"ti ti-arrow-right text-2xl\" data-kid=\"98\"></i>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"lg:col-span-5 relative h-[400px] lg:h-auto bg-[var(--color-linen)] overflow-hidden expertise-reveal\" data-kid=\"99\">\n                <div id=\"prev-1\" class=\"preview-panel absolute inset-0 opacity-0 transition-opacity duration-700\" data-kid=\"100\">\n                    <img src=\"https://images.unsplash.com/photo-1580281657702-257584239a55?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale brightness-75\" decoding=\"async\" loading=\"lazy\" data-kid=\"101\">\n                </div>\n                <div id=\"prev-2\" class=\"preview-panel absolute inset-0 opacity-0 transition-opacity duration-700\" data-kid=\"102\">\n                    <img src=\"https://images.pexels.com/photos/8375444/pexels-photo-8375444.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\" class=\"w-full h-full object-cover grayscale brightness-75\" decoding=\"async\" loading=\"lazy\" data-kid=\"103\">\n                </div>\n                <div id=\"prev-3\" class=\"preview-panel absolute inset-0 opacity-0 transition-opacity duration-700\" data-kid=\"104\">\n                    <img src=\"https://images.unsplash.com/photo-1518779578993-ec3579fee39f?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale brightness-75\" decoding=\"async\" loading=\"lazy\" data-kid=\"105\">\n                </div>\n                <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" data-kid=\"106\">\n                    <div class=\"text-center\" data-kid=\"107\">\n                        <span class=\"text-[10px] uppercase tracking-[0.5em] opacity-30 font-black\" data-kid=\"108\">Focus Area</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"reviews\" class=\"py-40 bg-[var(--color-bg)] overflow-hidden relative\" data-kid=\"109\">\n        <div class=\"max-w-5xl mx-auto px-8 relative z-10\" data-kid=\"110\">\n            <span class=\"eyebrow mb-16 block text-center\" data-kid=\"111\">Голос Пациентов</span>\n            \n            <div class=\"relative\" data-kid=\"112\">\n                <i class=\"ti ti-quote text-[8rem] md:text-[12rem] text-[var(--color-linen)] absolute -top-16 md:-top-24 -left-6 md:-left-16 -z-10 opacity-30\" data-kid=\"113\"></i>\n                <blockquote class=\"text-center\" data-kid=\"114\">\n                    <p class=\"text-xl md:text-4xl font-medium tracking-tight leading-relaxed mb-12 review-text\" data-kid=\"115\">\n                        \"Уровень внимания к деталям, который я встретил у доктора Гондусова, превзошел все мои ожидания. Это не просто медицина, это персональное сопровождение к здоровью на высшем уровне.\"\n                    </p>\n                    <cite class=\"not-italic\" data-kid=\"116\">\n                        <span class=\"block text-sm font-black uppercase tracking-[0.3em] mb-2 text-[var(--color-crimson)]\" data-kid=\"117\">Евгений П.</span>\n                        <span class=\"block text-[10px] uppercase tracking-widest opacity-40 font-bold\" data-kid=\"118\">Предприниматель, г. Москва</span>\n                    </cite>\n                </blockquote>\n            </div>\n        </div>\n        \n        \n        <div class=\"absolute top-1/2 left-0 w-full h-px bg-[var(--color-linen)] -z-10\" data-kid=\"119\"></div>\n        <div class=\"absolute top-1/2 left-1/4 w-px h-64 bg-[var(--color-linen)] -translate-y-1/2 -z-10\" data-kid=\"120\"></div>\n        <div class=\"absolute top-1/2 right-1/4 w-px h-64 bg-[var(--color-linen)] -translate-y-1/2 -z-10\" data-kid=\"121\"></div>\n    </section>\n\n    \n    <section id=\"booking\" class=\"py-32 px-8 md:px-20 border-t border-[var(--color-linen)]\" data-kid=\"122\">\n        <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-20\" data-kid=\"123\">\n            <div class=\"booking-reveal\" data-kid=\"124\">\n                <h2 class=\"headline-xl mb-12\" data-kid=\"125\">Запишитесь <br data-kid=\"126\"> на Прием</h2>\n                <p class=\"text-xl opacity-60 mb-16 max-w-md\" data-kid=\"127\">\n                    Премиальный формат консультаций предполагает полное погружение в вашу медицинскую историю и разработку долгосрочной стратегии здоровья.\n                </p>\n                \n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-10\" data-kid=\"128\">\n                    <div class=\"border-l-2 border-[var(--color-crimson)] pl-6\" data-kid=\"129\">\n                        <p class=\"text-[9px] uppercase tracking-widest opacity-40 mb-2 font-black\" data-kid=\"130\">Связаться напрямую</p>\n                        <p class=\"text-lg font-black uppercase tracking-tight\" data-kid=\"131\">+7 (495) 999-00-00</p>\n                    </div>\n                    <div class=\"border-l-2 border-[var(--color-crimson)] pl-6\" data-kid=\"132\">\n                        <p class=\"text-[9px] uppercase tracking-widest opacity-40 mb-2 font-black\" data-kid=\"133\">Адрес клиники</p>\n                        <p class=\"text-lg font-black uppercase tracking-tight\" data-kid=\"134\">Пречистенская наб. 15</p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"booking-reveal\" data-kid=\"135\">\n                <div class=\"border-[3px] border-[var(--color-onyx)] p-8 md:p-14 bg-white relative shadow-2xl\" data-kid=\"136\">\n                    <div class=\"absolute -top-[12px] -left-[3px] bg-[var(--color-crimson)] text-white px-5 py-2 text-[9px] uppercase tracking-[0.4em] font-black z-10\" data-kid=\"137\">\n                        Priority Booking\n                    </div>\n                    \n                    <form class=\"space-y-12\" data-kid=\"138\">\n                        <div class=\"group relative border-b border-[var(--color-onyx)] pb-4\" data-kid=\"139\">\n                            <label class=\"block text-[9px] uppercase tracking-[0.3em] font-black opacity-40 mb-3 group-focus-within:text-[var(--color-crimson)] transition-colors\" data-kid=\"140\">ФИО Пациента</label>\n                            <input type=\"text\" class=\"w-full bg-transparent outline-none text-xl font-bold tracking-tight placeholder:opacity-40\" placeholder=\"Александр Иванов\" data-kid=\"141\">\n                        </div>\n                        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-10\" data-kid=\"142\">\n                            <div class=\"group relative border-b border-[var(--color-onyx)] pb-4\" data-kid=\"143\">\n                                <label class=\"block text-[9px] uppercase tracking-[0.3em] font-black opacity-40 mb-3 group-focus-within:text-[var(--color-crimson)] transition-colors\" data-kid=\"144\">Контактный номер / Telegram</label>\n                                <input type=\"text\" class=\"w-full bg-transparent outline-none text-xl font-bold tracking-tight placeholder:opacity-40\" placeholder=\"+7 (900) 000-00-00\" data-kid=\"145\">\n                            </div>\n                            <div class=\"group relative border-b border-[var(--color-onyx)] pb-4\" data-kid=\"146\">\n                                <label class=\"block text-[9px] uppercase tracking-[0.3em] font-black opacity-40 mb-3 group-focus-within:text-[var(--color-crimson)] transition-colors\" data-kid=\"147\">Специализация</label>\n                                <select class=\"w-full bg-transparent outline-none text-xl font-bold tracking-tight appearance-none cursor-pointer\" data-kid=\"148\">\n                                    <option data-kid=\"149\">Гастроэнтерология</option>\n                                    <option data-kid=\"150\">Эндоскопия</option>\n                                    <option data-kid=\"151\">Нутрициология</option>\n                                </select>\n                            </div>\n                        </div>\n                        <div class=\"group relative border-b border-[var(--color-onyx)] pb-4\" data-kid=\"152\">\n                            <label class=\"block text-[9px] uppercase tracking-[0.3em] font-black opacity-40 mb-3 group-focus-within:text-[var(--color-crimson)] transition-colors\" data-kid=\"153\">Комментарии (конфиденциально)</label>\n                            <textarea class=\"w-full bg-transparent outline-none text-xl font-bold tracking-tight placeholder:opacity-40 h-28 resize-none\" placeholder=\"Опишите ваши симптомы...\" data-kid=\"154\"></textarea>\n                        </div>\n                        \n                        <button type=\"submit\" class=\"w-full bg-[var(--color-onyx)] text-white py-8 uppercase tracking-[0.5em] font-black text-xs hover:bg-[var(--color-crimson)] transition-all duration-700 shadow-xl\" data-kid=\"155\">\n                            Отправить заявку\n                        </button>\n                        \n                        <p class=\"text-[8px] uppercase tracking-[0.2em] opacity-30 text-center\" data-kid=\"156\">\n                            Все данные передаются по защищенному каналу и строго конфиденциальны.\n                        </p>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n</main>\n\n\n<footer class=\"py-12 px-8 md:px-20 border-t border-[var(--color-linen)] flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"157\">\n    <div class=\"flex items-center gap-4\" data-kid=\"158\">\n        <img src=\"/api/local/images/static/logotip.svg\" alt=\"Dr. Gondusov Logo\" class=\"h-6 w-auto opacity-50 grayscale\" data-kid=\"159\">\n        <span class=\"text-[10px] uppercase tracking-[0.3em] font-black\" data-kid=\"160\">Dr. Gondusov © 2026</span>\n    </div>\n    \n    <div class=\"flex gap-8\" data-kid=\"161\">\n        <a href=\"#\" class=\"text-[9px] uppercase tracking-widest font-black opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"162\">Telegram</a>\n        <a href=\"#\" class=\"text-[9px] uppercase tracking-widest font-black opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"163\">WhatsApp</a>\n        <a href=\"#\" class=\"text-[9px] uppercase tracking-widest font-black opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"164\">Dzen</a>\n    </div>\n\n    <div class=\"text-[9px] uppercase tracking-[0.2em] opacity-30 font-bold\" data-kid=\"165\">\n        Premium Gastro Practice\n    </div>\n</footer>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"166\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"167\"></script>\n<script type=\"module\" data-kid=\"168\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    import Snap from \"https://esm.sh/lenis@1/snap\"\n    \n    // Initialize Lenis\n    const lenis = new Lenis()\n    function raf(time) {\n        lenis.raf(time)\n        requestAnimationFrame(raf)\n    }\n    requestAnimationFrame(raf)\n\n    // GSAP Animations\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Hero Entrance\n    const heroTl = gsap.timeline();\n    \n    // Ensure smooth start\n    gsap.set(\".hero-text, .hero-reveal, .about-reveal, .expertise-reveal, .booking-reveal\", { visibility: \"visible\" });\n\n    heroTl.from(\".hero-text\", {\n        y: 100,\n        opacity: 0,\n        duration: 1.2,\n        stagger: 0.1,\n        ease: \"expo.out\"\n    })\n    .from(\".hero-reveal\", {\n        opacity: 0,\n        y: 20,\n        duration: 1,\n        stagger: 0.2,\n        ease: \"power2.out\"\n    }, \"-=0.8\")\n    .from(\".hero-img\", {\n        scale: 1.2,\n        duration: 2,\n        ease: \"power2.out\"\n    }, 0);\n\n    // Section Reveals\n    gsap.utils.toArray('.about-reveal, .expertise-reveal, .booking-reveal').forEach(el => {\n        gsap.from(el, {\n            scrollTrigger: {\n                trigger: el,\n                start: \"top 85%\",\n            },\n            y: 50,\n            opacity: 0,\n            duration: 1.2,\n            ease: \"expo.out\"\n        });\n    });\n\n    // Ledger Rows Stagger\n    gsap.from(\".ledger-row\", {\n        scrollTrigger: {\n            trigger: \".ledger-row\",\n            start: \"top 90%\",\n        },\n        x: -30,\n        opacity: 0,\n        duration: 1,\n        stagger: 0.15,\n        ease: \"power2.out\"\n    });\n\n    // Expertise Items Hover JS for Preview Panel\n    const expertiseItems = document.querySelectorAll('.expertise-item');\n    const previews = document.querySelectorAll('.preview-panel');\n\n    expertiseItems.forEach(item => {\n        item.addEventListener('mouseenter', () => {\n            const id = item.getAttribute('data-preview');\n            previews.forEach(p => p.style.opacity = '0');\n            document.getElementById(`prev-${id}`).style.opacity = '1';\n        });\n    });\n\n    // Initial first preview visible\n    if(previews.length > 0) previews[0].style.opacity = '1';\n\n</script>",
