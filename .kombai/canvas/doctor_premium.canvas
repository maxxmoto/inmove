font-bold text-gray-800 text-[15px]\" data-kid=\"54\">Настройки</span>\n                    <i class=\"fa-solid fa-chevron-right text-gray-300 text-[10px] transition-transform group-hover:translate-x-0.5\" data-kid=\"55\"></i>\n                </div>\n            </div>\n        </div>\n\n        \n        <div data-kid=\"56\">\n            <h2 class=\"px-4 mb-4 text-xs font-bold text-gray-500 uppercase tracking-[0.12em]\" data-kid=\"57\">Дополнительно</h2>\n            <div class=\"bg-[#F2F3F4]/60 backdrop-blur-sm rounded-[24px] overflow-hidden border border-black/[0.02]\" data-kid=\"58\">\n                <div class=\"flex items-center px-5 py-[18px] active:bg-black/5 transition-colors group cursor-pointer border-b border-black/[0.03]\" data-kid=\"59\">\n                    <div class=\"w-10 h-10 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-500 mr-4 group-hover:scale-110 transition-transform\" data-kid=\"60\">\n                        <i class=\"fa-solid fa-bell text-lg\" data-kid=\"61\"></i>\n                    </div>\n                    <span class=\"flex-1 font-bold text-gray-800 text-[15px]\" data-kid=\"62\">Уведомления</span>\n                    <div class=\"flex items-center space-x-2\" data-kid=\"63\">\n                        <span class=\"text-[10px] font-black text-[#50C878] bg-[#50C878]/10 px-3 py-1 rounded-full uppercase tracking-wider\" data-kid=\"64\">Вкл</span>\n                        <i class=\"fa-solid fa-chevron-right text-gray-300 text-xs\" data-kid=\"65\"></i>\n                    </div>\n                </div>\n                <div class=\"flex items-center px-5 py-[18px] active:bg-black/5 transition-colors group cursor-pointer border-b border-black/[0.03]\" data-kid=\"66\">\n                    <div class=\"w-10 h-10 rounded-xl bg-cyan-500/10 flex items-center justify-center text-cyan-500 mr-4 group-hover:scale-110 transition-transform\" data-kid=\"67\">\n                        <i class=\"fa-solid fa-circle-in